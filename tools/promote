    "# embedded in its own `to` (e.g. an _admonition include) is applied\n"
    "# exactly once, never to a fixpoint. The drift-check applies exactly\n"
    "# this transform before comparing.\n"
)


class PromoteError(Exception):
    """A recoverable, per-lecture error. Reported, then the run continues."""


# --------------------------------------------------------------------------- #
# Reference extraction (the asset-closure parser)                              #
# --------------------------------------------------------------------------- #
# Directive argument on the opening fence line, backtick- or colon-fenced:
#   ```{figure} /_static/...      :::{image} _static/...
DIRECTIVE_RE = re.compile(
    r"^(?:`{3,}|:{3,})\{(figure|image|include|literalinclude|bibliography)\}\s+(\S+)\s*$"
)
# code-cell blocks delimit where code-string/:load: scanning applies.
CODE_CELL_OPEN_RE = re.compile(r"^(`{3,})\{code-cell\}")
FENCE_ONLY_RE = re.compile(r"^`{3,}\s*$")
# :load: is a code-cell directive option loading a script by path. It has a
# second spelling: a YAML options block (--- fenced, first thing in the cell)
# with a plain `load:` key — the estate uses BOTH forms, so both are parsed.
LOAD_RE = re.compile(r"^\s*:load:\s+(\S+)\s*$")
YAML_LOAD_RE = re.compile(r"^\s*load:\s+[\"']?([^\"'\s]+)[\"']?\s*$")
# Markdown images / links (images guarded out of the link pattern).
MD_IMAGE_RE = re.compile(r"!\[[^\]]*\]\(\s*<?([^)<>\s]+)>?\s*(?:[\"'][^)\"']*[\"']\s*)?\)")
MD_LINK_RE = re.compile(r"(?<!!)\[[^\]]*\]\(\s*<?([^)<>\s]+)>?\s*(?:[\"'][^)\"']*[\"']\s*)?\)")
# {download} role: {download}`path` or {download}`text <path>`.
DOWNLOAD_RE = re.compile(r"\{download\}`(?:[^`]*?<([^`>]+)>|([^`<>]+))`")
# Raw HTML anchors — the estate uses UNQUOTED attributes (<a href=_static/...
# download>), which pure MyST tooling misses; all three quoting forms handled.
HREF_RE = re.compile(r"<a\s[^>]*?href=(?:\"([^\"]+)\"|'([^']+)'|([^\"'\s>]+))", re.IGNORECASE)
# Hardcoded published asset URLs (the Colab-compatibility pattern).
QE_URL_RE = re.compile(
    r"https://[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.quantecon\.org(/_static/[^\s\"'<>()\[\]`]+)"
)
# Quoted string literals inside code cells that look like repo asset paths.
CODE_STR_RE = re.compile(
    r"[\"']([^\"'\n]*(?:_static/|datasets/|lecture_specific)[^\"'\n]*)[\"']"
)
SCHEME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")


def extract_refs(text):
    """Scan MyST source for candidate file references.

    Returns a list of ``(kind, written)`` pairs where ``written`` is the path
    (or URL) exactly as it appears in the source — the literal a rewrite's
    ``from`` field must match. Prose and code-cell contexts are scanned with
    different patterns so quoted strings in code are not confused with
    directives and vice versa.
    """
    refs = []
    in_code = 0  # opening-fence length while inside a {code-cell} block
    cell_first_line = False  # the line straight after a {code-cell} fence
    in_options = False  # inside the cell's ---/--- YAML options block
    for line in text.split("\n"):
        if in_code:
            stripped = line.strip()
            if FENCE_ONLY_RE.match(stripped) and len(stripped) >= in_code:
                in_code = 0
                in_options = False
                continue
            if cell_first_line:
                cell_first_line = False
                if stripped == "---":
                    in_options = True
                    continue
            if in_options:
                if stripped == "---":
                    in_options = False
                    continue
                m = YAML_LOAD_RE.match(line)
                if m:
                    refs.append(("load", m.group(1)))
                continue
            m = LOAD_RE.match(line)
            if m:
                refs.append(("load", m.group(1)))
            for m in QE_URL_RE.finditer(line):
                refs.append(("url", m.group(0)))
            for m in CODE_STR_RE.finditer(line):
                if "://" not in m.group(1):
                    refs.append(("code-str", m.group(1)))
            continue

        m = CODE_CELL_OPEN_RE.match(line)
        if m:
            in_code = len(m.group(1))
            cell_first_line = True
            continue

        m = DIRECTIVE_RE.match(line.strip())
        if m:
            refs.append((m.group(1), m.group(2)))
        for m in MD_IMAGE_RE.finditer(line):
            refs.append(("image-md", m.group(1)))
        for m in MD_LINK_RE.finditer(line):
            refs.append(("link", m.group(1)))
        for m in DOWNLOAD_RE.finditer(line):
            refs.append(("download", m.group(1) or m.group(2)))
        for m in HREF_RE.finditer(line):
            refs.append(("href", m.group(1) or m.group(2) or m.group(3)))
        for m in QE_URL_RE.finditer(line):
            refs.append(("url", m.group(0)))
    return refs


# --------------------------------------------------------------------------- #
# Small helpers                                                                #
# --------------------------------------------------------------------------- #
def sha256_file(path: Path) -> str:
    """Content digest of a file (streamed, so large binaries are fine)."""
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def tmp_sibling(path: Path) -> Path:
    """A per-process temp name beside ``path`` — the pid suffix keeps two
    concurrent runs from clobbering each other's in-flight temp file."""
    return path.with_name(f"{path.name}.promote-tmp.{os.getpid()}")


def atomic_write(path: Path, data: bytes):
    """Write via a sibling temp file (fsynced) + ``os.replace`` so a crash
    mid-write can never leave a truncated file — pool files and the ledger
    must always be either the old bytes or the new bytes, never a partial
    write. The temp file is removed even when the write itself fails."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = tmp_sibling(path)
    try:
        with open(tmp, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def read_text_exact(path: Path) -> str:
    """Read UTF-8 text WITHOUT universal-newline translation.

    ``Path.read_text`` silently normalises ``\\r\\n``/``\\r`` to ``\\n``, which
    would be an UNRECORDED transformation of lecture text — a CRLF upstream
    file would break the byte-for-byte rewrite-replay invariant. Reading raw
    bytes keeps the mirror's exact line endings in the pool copy."""
    return path.read_bytes().decode("utf-8")


def mirror_lectures(series: str) -> Path:
    """The lectures root of a series' mirror tree."""
    return MIRROR_DIR / series / "lectures"


def to_src_rel(written: str) -> str:
    """Normalise a path-as-written to a mirror-lectures-relative POSIX path.

    Root-relative forms (``/_static/...``) and file-relative forms both occur
    upstream; the pool is flat, so a lecture's directory IS the lectures root
    and both resolve against the same base.
    """
    p = written[1:] if written.startswith("/") else written
    p = posixpath.normpath(p)
    if p.startswith("../") or p in ("..", ".") or p.startswith("/"):
        raise PromoteError(f"reference escapes the lectures tree: {written!r}")
    return p


def slug_of(name: str) -> str:
    """Accept both ``short_path`` and ``short_path.md`` as a slug."""
    return name[:-3] if name.endswith(".md") else name


# --------------------------------------------------------------------------- #
# Manifest / state / ledger I/O                                                #
# --------------------------------------------------------------------------- #
class UniqueKeyLoader(yaml.SafeLoader):
    """A SafeLoader that refuses a mapping with a repeated key, which plain
    YAML loading silently resolves to the last value."""


def _construct_unique_mapping(loader, node, deep=False):
    loader.flatten_mapping(node)  # resolve merge keys first, as safe_load does
    seen = set()
    for key_node, _ in node.value:
        key = loader.construct_object(key_node, deep=deep)
        try:
            hash(key)
        except TypeError:
            raise yaml.constructor.ConstructorError(
                None, None, "found an unhashable key", key_node.start_mark
            )
        if key in seen:
            raise yaml.constructor.ConstructorError(
                None, None, f"repeated key {key!r}", key_node.start_mark
            )
        seen.add(key)
    return loader.construct_mapping(node, deep=deep)


UniqueKeyLoader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, _construct_unique_mapping
)


def load_yaml(path: Path, loader=yaml.SafeLoader):
    """Load a YAML mapping, tolerating an empty/None document (-> {})."""
    if not path.exists():
        return None
    try:
        data = yaml.load(path.read_text(encoding="utf-8"), Loader=loader) or {}
    except yaml.YAMLError as exc:
        raise SystemExit(f"error: could not parse {path}:\n{exc}")
    if not isinstance(data, dict):
        raise SystemExit(f"error: expected a mapping at the top of {path}.")
    return data


def load_manifest():
    """Return ``(order, consumers)``: the series keys in manifest order (=
    dedup priority order) and the set of series declared ``class: consumer``.

    A stanza without ``class:`` is canonical-eligible. An unknown class is an
    error, never a silent default — it decides what may become canonical.
    """
    data = load_yaml(MANIFEST_PATH)
    if data is None:
        raise SystemExit(
            f"error: manifest not found at {MANIFEST_PATH}.\n"
            "       Restore sync/manifest.yml before running tools/promote."
        )
    series_block = data.get("series") or {}
    if not isinstance(series_block, dict) or not series_block:
        raise SystemExit(f"error: {MANIFEST_PATH} has no `series:` mapping.")
    consumers = set()
    for key, cfg in series_block.items():
        cls = (cfg or {}).get("class", SOURCE_CLASS)
        if cls not in SERIES_CLASSES:
            raise SystemExit(
                f"error: series '{key}' in {MANIFEST_PATH} has unknown "
                f"class {cls!r} (valid: {', '.join(SERIES_CLASSES)})."
            )
        if cls == CONSUMER_CLASS:
            consumers.add(key)
    return list(series_block.keys()), consumers


def load_canonical_map(order, consumers):
    """Return the committed canonical map: ``slug -> series``.

    ``sync/canonical.yml`` is HUMAN INTENT — the one way a same-name collision
    is settled. It is validated up front: a repeated key, two keys naming one
    lecture (``slug`` and ``slug.md``), and an unknown or consumer series are
    errors before anything is planned. A slug that no series holds cannot be
    checked here (it needs the mirror); ``map_slugs_held_nowhere`` reports
    it. A missing or empty file is an empty map.
    """
    data = load_yaml(CANONICAL_MAP_PATH, loader=UniqueKeyLoader)
    if not data:
        return {}
    bad, named = [], {}
    for slug, series in data.items():
        if not isinstance(slug, str) or not isinstance(series, str):
            bad.append(f"{slug!r}: {series!r} (expected `<slug>: <series>`)")
            continue
        if slug_of(slug) in named:
            bad.append(f"{slug}: names the same lecture as '{named[slug_of(slug)]}'")
        named[slug_of(slug)] = slug
        if series not in order:
            bad.append(f"{slug}: unknown series '{series}'")
        elif series in consumers:
            bad.append(f"{slug}: '{series}' is a consumer series and is never canonical")
    if bad:
        raise SystemExit(
            f"error: invalid entries in {CANONICAL_MAP_PATH}:\n       "
            + "\n       ".join(bad)
        )
    return {slug_of(slug): series for slug, series in data.items()}


def map_slugs_held_nowhere(canonical_map, order, consumers):
    """Map slugs whose lecture no reconstructed canonical-eligible mirror
    holds: a typo, or a lecture renamed or retired upstream. Names are matched
    exactly, so a wrong-case key is caught on a case-insensitive file system
    too. Reported, not refused — one dead line must not stop every
    promotion."""
    held = set()
    for s in order:
        root = mirror_lectures(s)
        if s in consumers or not root.is_dir():
            continue
        held.update(p.relative_to(root).as_posix()[:-3] for p in root.rglob("*.md"))
    return sorted(slug for slug in canonical_map if slug not in held)


def load_state():
    """Return the pinned-SHA state mapping written by tools/sync.

    SHAs are stripped here, once, so every consumer (pin validation, refresh
    comparison, promoted_at recording) sees the same normalised value — a
    padded sha in state.yml must not make --refresh spin forever. A mangled
    non-mapping entry (bad hand-edit, truncated write) is normalised to an
    EMPTY mapping so it reads as a missing pin — a clean, actionable error
    downstream instead of an AttributeError.
    """
    data = load_yaml(STATE_PATH)
    if not data:
        raise SystemExit(
            f"error: no pinned SHAs found — {STATE_PATH} is missing or empty.\n"
            "       Run `tools/sync --update` first; promotion records pins."
        )
    normalised = {}
    for key, meta in data.items():
        if not isinstance(meta, dict):
            meta = {}
        elif isinstance(meta.get("sha"), str):
            meta["sha"] = meta["sha"].strip()
        normalised[key] = meta
    return normalised


def load_ledger():
    """Return ``(lecture_entries, assets_map)`` from sync/ledger.yml.

    The ledger is bot-written, so malformed entries mean corruption or a bad
    hand-edit — error out rather than silently dropping data on the next write.
    """
    data = load_yaml(LEDGER_PATH) or {}
    assets = data.pop("assets", {}) or {}
    bad = [str(k) for k, v in data.items() if not isinstance(v, dict)]
    if not isinstance(assets, dict):
        bad.append("assets")
    if bad:
        raise SystemExit(
            f"error: malformed entries in {LEDGER_PATH}: {', '.join(sorted(bad))}\n"
            "       The ledger is bot-written — restore it from git before promoting."
        )
    return data, assets


def ledger_asset_digest(pool_path: str, meta: dict):
    """The recorded content digest of a ledger asset (falling back to hashing
    the pool file itself for ledgers written before digests were recorded).

    The digest is part of an asset's IDENTITY: two upstream files that merely
    share a relative path across series are different assets, and conflating
    them would deadlock legitimate promotions on phantom collisions."""
    digest = meta.get("digest")
    if not digest:
        f = POOL_DIR / pool_path
        if f.is_file():
            digest = sha256_file(f)
    return digest


def dump_ledger(lectures: dict, assets: dict) -> str:
    """Serialise the ledger deterministically (sorted keys, fixed field order)."""
    doc = {}
    for key in sorted(lectures):
        doc[key] = lectures[key]
    if assets:
        doc["assets"] = {k: assets[k] for k in sorted(assets)}
    body = yaml.safe_dump(
        doc, sort_keys=False, default_flow_style=False, allow_unicode=True, width=4096
    )
    return LEDGER_HEADER + body


def ordered_entry(canonical, interim, sources, divergent, superseded, promoted_at, assets, rewrites):
    """A ledger lecture entry with a stable key order.

    ``interim`` is present only while ``divergent`` is non-empty — it marks
    a canonical choice the canonical map made over differing copies, pending
    the rename or merge upstream that retires the map entry. ``superseded``
    is present only when a consumer series holds a copy.
    """
    entry = {"canonical": canonical}
    if interim:
        entry["interim"] = True
    entry["sources"] = sources
    if divergent:
        entry["divergent"] = divergent
    if superseded:
        entry["superseded"] = superseded
    entry["promoted_at"] = promoted_at
    entry["assets"] = assets
    entry["rewrites"] = rewrites
    return entry


# --------------------------------------------------------------------------- #
# The per-lecture plan                                                         #
# --------------------------------------------------------------------------- #
class Plan:
    """Everything decided about one lecture before anything is written."""

    def __init__(self, slug, requested_series):
        self.slug = slug
        self.requested = requested_series  # None => resolve by priority
        self.canonical = None
        self.sources = []  # series with identical or stale copies (manifest order)
        self.divergent = []  # differing copies the canonical map overruled
        self.superseded = []  # consumer series holding a copy (manifest order)
        self.stale = []  # sources unchanged since promotion while the canonical moved
        self.digests = {}  # series -> sha256 of its copy at promotion time
        self.refs = []  # (kind, literal, src_rel, digest) — deduped, source order
        self.own_refs = []  # the same as the lecture's own series has them
        self.warnings = []
        self.error = None
        self.rewrites = []  # ordered [(from, to)]
        self.pool_text = None
        self.assets = []  # pool-relative destinations (sorted)


def normalised_text(series: str, slug: str) -> str:
    """A copy's text with each local asset reference replaced by the pool
    path promotion would give it — the form two copies are COMPARED in.

    Series spell the same reference differently (``/_static/...`` against
    ``_static/...``, a ``lecture_specific/<slug>/`` dir against a new-style
    ``_static/<slug>/`` one); promotion rewrites both to one pool path, so
    copies that differ only there are one lecture. Comparison only: the pool
    text is always built by ``build_rewrites`` from the canonical copy. A
    reference that resolves to no file stays as written.
    """
    root = mirror_lectures(series)
    text = read_text_exact(root / f"{slug}.md")
    pairs = {}
    for kind, written in extract_refs(text):
        if kind == "url":
            literal, src_rel = written, written[written.find("/_static/") + 1 :]
        else:
            literal = written.split("#", 1)[0]
            if not literal or SCHEME_RE.match(literal):
                continue
            try:
                src_rel = to_src_rel(literal)
            except PromoteError:
                continue
        if kind == "link" and src_rel.endswith(".md"):
            continue
        if (root / src_rel).is_file():
            pairs[literal] = plan_destination(src_rel, [slug])
    for frm, to in sorted(pairs.items(), key=lambda kv: (-len(kv[0]), kv[0])):
        text = text.replace(frm, to)
    return text


def retire_remedy(slug: str, canonical) -> str:
    """How to retire a pool lecture whose canonical copy is gone — one wording
    for every message that names it."""
    return (
        f"If it was removed or renamed, `tools/promote --toc {canonical}` "
        "retires it once it has left that toc and no series holds the name, "
        f"and `tools/promote --retire {slug}` retires it by name once that "
        "toc no longer lists it; if another canonical-eligible series holds "
        f"it now, `tools/promote {slug}` re-homes it there"
    )


def resolve_sources(plan: Plan, considered, consumers, canonical_map, recorded=None, order=()):
    """Fill in canonical/sources/divergent/superseded by hashing across series.

    A same-named file is presumed to be ONE lecture. The anchor copy (the
    canonical map's choice, else the requested copy, else the highest-priority
    one) defines the identity set: every canonical-eligible copy that is
    byte-identical to it, or identical after ``normalised_text``. The canonical
    series is the highest-priority member of that set (manifest order).

    A copy outside the set is a different lecture under the same name, and an
    error naming the lecture and every series involved: which copy survives
    must never fall out of run order. Only the committed canonical map settles
    it — the map's copy anchors the set, and the differing copies land in
    ``divergent`` (the entry is ``interim``). The map picks a COPY, never a
    priority: among identical copies the highest-priority series is still
    canonical, so deleting an entry that settles nothing changes nothing.
    Consumer copies, equal or not, are recorded under ``superseded`` and
    never anchor anything.

    ``recorded`` is the slug's ledger entry, if any. A copy is STALE, not a
    different lecture, when it is recorded under ``sources``, is not the
    recorded canonical copy's lecture as that copy now stands, and is still
    at a version the pool already took: its own recorded digest (it has not
    moved) or the canonical copy's (it caught up, then the canonical copy
    moved on).
    Staleness is judged against the recorded canonical copy whatever anchors
    the run: a stale requested copy (``--toc`` of a series that lags) gives
    way to the canonical copy, and a canonical-map entry naming a stale copy
    is refused, since it no longer settles a collision and following it
    would keep the lagging text. A stale copy stays a source
    (``plan.stale``) — the drift-check's ``stale-copy`` — and only a copy
    edited to something else is a collision.
    """
    rel = f"{plan.slug}.md"
    digests = {}
    for series in considered:
        f = mirror_lectures(series) / rel
        if f.is_file():
            digests[series] = sha256_file(f)
    eligible = [s for s in considered if s in digests and s not in consumers]
    if not eligible:
        held = [s for s in considered if s in digests]
        # A copy this run leaves out is named, so a refusal never hides the
        # lecture's home behind --exclude.
        left_out = [
            s for s in order
            if s not in considered and s not in consumers
            and (mirror_lectures(s) / rel).is_file()
        ]
        also = ""
        if left_out:
            also = f"; {', '.join(left_out)}, excluded from this run, " + (
                "holds a copy" if len(left_out) == 1 else "hold copies"
            )
        # A pool lecture comes first: its home series dropping it is the
        # news, whichever consumer still republishes a copy.
        if recorded:
            raise PromoteError(
                f"{rel} is in the pool, but no canonical-eligible series this "
                "run considers holds it any more (removed or renamed upstream?)"
                + (f"; only consumer series ({', '.join(held)}) still do" if held else "")
                + also
                + " — decide whether the lecture was retired, renamed or moved; "
                "the drift-check reports it as canonical-removed. "
                + retire_remedy(plan.slug, recorded.get("canonical"))
            )
        if held:
            raise PromoteError(
                f"{rel} is held only by consumer series ({', '.join(held)}) — "
                "a consumer contributes no lecture to the pool" + also
            )
        raise PromoteError(
            f"{rel} not found in any non-excluded series "
            f"(searched: {', '.join(considered)})" + also
        )
    requested = plan.requested if plan.requested not in consumers else None
    if requested is not None and requested not in digests:
        if recorded and recorded.get("canonical") == requested:
            raise PromoteError(
                f"the canonical copy of {rel} is gone from {requested} upstream "
                "(removed or renamed) — decide whether the lecture was "
                "retired, renamed or moved; the drift-check reports it as "
                "canonical-removed. " + retire_remedy(plan.slug, requested)
            )
        raise PromoteError(f"{rel} not found in mirror/{requested}/lectures/")
    mapped = canonical_map.get(plan.slug)
    if mapped is not None and mapped not in considered:
        plan.warnings.append(
            f"{CANONICAL_MAP_PATH.name} names '{mapped}' for {plan.slug}, but "
            f"'{mapped}' is excluded from this run — the map entry is ignored"
        )
        mapped = None
    if mapped is not None and mapped not in digests:
        raise PromoteError(
            f"{CANONICAL_MAP_PATH.name} names '{mapped}' for {plan.slug}, but "
            f"{rel} is not in mirror/{mapped}/lectures/"
        )
    base = mapped or requested or eligible[0]

    normalised = {}  # series -> normalised text, computed only when needed

    def split(anchor):
        """``(same, differ)``: the eligible copies that are, and are not, the
        anchor's lecture (byte-identical, or identical once normalised)."""
        same, differ = [], []
        for series in eligible:
            if digests[series] == digests[anchor]:
                same.append(series)
                continue
            for s in (anchor, series):
                if s not in normalised:
                    normalised[s] = normalised_text(s, plan.slug)
            (same if normalised[series] == normalised[anchor] else differ).append(series)
        return same, differ

    # Staleness is judged against the recorded canonical copy, whatever
    # anchors this run, so a refresh and --toc of a lagging series agree.
    recorded_canonical, stale_copies = None, []
    if recorded and recorded.get("canonical") in eligible:
        recorded_canonical = recorded.get("canonical")
        was = {s.get("series"): s.get("digest") for s in recorded.get("sources") or []}
        _, differ_c = split(recorded_canonical)
        stale_copies = [
            s for s in differ_c
            if s in was and digests[s] in (was[s], was.get(recorded_canonical))
        ]

    anchor = base
    if base in stale_copies:
        if base == mapped:
            if digests[recorded_canonical] != was.get(recorded_canonical):
                why = (
                    f"'{mapped}' holds an earlier promoted version, and the "
                    f"recorded canonical copy in '{recorded_canonical}' has "
                    "moved on"
                )
            else:
                why = (
                    f"'{mapped}' no longer matches the recorded canonical copy "
                    f"in '{recorded_canonical}' (it is an earlier version, or "
                    "a file it references changed upstream)"
                )
            raise PromoteError(
                f"{CANONICAL_MAP_PATH.name} names '{mapped}' for {plan.slug}, "
                f"but {why}: point the entry at '{recorded_canonical}', remove "
                f"it if no other copy differs, or bring {mapped}'s copy up to "
                "date upstream"
            )
        anchor = recorded_canonical

    same, differ = split(anchor)
    stale = []
    if recorded_canonical is not None and recorded_canonical in same:
        stale = [s for s in differ if s in stale_copies]
        differ = [s for s in differ if s not in stale]
    if differ and mapped is None:
        detail = "same: " + ", ".join(f"{s}:{digests[s][:12]}" for s in same)
        detail += "; different: " + ", ".join(f"{s}:{digests[s][:12]}" for s in differ)
        if stale:
            detail += "; stale (at an earlier promoted version): " + ", ".join(stale)
        raise PromoteError(
            f"{rel} differs across series ({detail}) — a same-named file must "
            "be one lecture: reconcile or rename it upstream, or name the "
            f"canonical series in sync/{CANONICAL_MAP_PATH.name}"
        )
    if mapped is not None and not differ:
        # ``order`` is every manifest series. A canonical-eligible series this
        # run excludes may hold the copy the entry settles, so its copy is
        # compared too; without its mirror the run cannot tell.
        differing, unchecked = [], []
        for s in order:
            if s in considered or s in consumers:
                continue
            if not mirror_lectures(s).is_dir():
                unchecked.append(s)
                continue
            f = mirror_lectures(s) / rel
            if not f.is_file() or sha256_file(f) == digests[anchor]:
                continue
            for x in (anchor, s):
                if x not in normalised:
                    normalised[x] = normalised_text(x, plan.slug)
            if normalised[s] != normalised[anchor]:
                differing.append(s)
        head = (
            f"{CANONICAL_MAP_PATH.name} names '{mapped}' for {plan.slug}; "
            "every copy this run considers is the same lecture"
        )
        if differing:
            plan.warnings.append(
                f"{head}, but {', '.join(differing)} (excluded from this run) "
                + ("holds a different copy" if len(differing) == 1 else "hold different copies")
                + ", so keep the entry while it settles that collision"
            )
        elif unchecked:
            plan.warnings.append(
                f"{head}, but {', '.join(unchecked)} (excluded, with no mirror "
                f"on disk) could not be checked: run `tools/sync "
                f"{' '.join(unchecked)}` and a run that considers "
                + ("it" if len(unchecked) == 1 else "them")
                + " before removing the entry"
            )
        else:
            note = (
                f"{CANONICAL_MAP_PATH.name} names '{mapped}' for {plan.slug}, but "
                "every copy is the same lecture — the map entry settles nothing "
                "and can be removed"
            )
            if mapped != same[0]:
                note += (
                    f"; remove it now, since once {same[0]}'s copy moves on, "
                    f"an entry naming {mapped}'s lagging copy is refused"
                )
            plan.warnings.append(note)
    plan.sources = [s for s in eligible if s in same or s in stale]
    plan.stale = stale
    plan.divergent = differ
    plan.superseded = [s for s in considered if s in digests and s in consumers]
    plan.canonical = same[0]
    plan.digests = digests
    return read_text_exact(mirror_lectures(plan.canonical) / rel)


def check_include_is_leaf(root: Path, src_rel: str):
    """Guard the depth-1 closure assumption for ``{include}`` targets.

    Included files are copied into the pool VERBATIM, so any local file
    reference inside one would be neither closed over nor rewritten — a
    silently broken pool lecture. Transitive closures are deliberately not
    supported; refuse instead, so the include must be flattened upstream.
    (Today the only include in the estate, ``_admonition/gpu.md``, is
    reference-free — this asserts that stays true.)
    """
    text = read_text_exact(root / src_rel)
    base_dir = posixpath.dirname(src_rel)
    for kind, written in extract_refs(text):
        candidate = written.split("#", 1)[0]
        if not candidate or SCHEME_RE.match(candidate):
            continue
        try:
            rel = to_src_rel(candidate)
        except PromoteError:
            continue
        if kind == "link" and rel.endswith(".md"):
            continue  # cross-lecture links resolve in the flat pool as-is
        rel_to_include = posixpath.normpath(posixpath.join(base_dir, rel))
        if (root / rel).is_file() or (root / rel_to_include).is_file():
            raise PromoteError(
                f"include target {src_rel} contains its own file reference "
                f"{written!r} — transitive asset closures are not supported; "
                "flatten the include upstream first"
            )


def collect_refs(plan: Plan, text: str):
    """Resolve extracted references into the lecture's asset closure.

    Every kept item is ``(kind, literal, src_rel, digest)`` where ``literal``
    is the exact source substring a rewrite must replace, ``src_rel`` is the
    asset's path relative to the canonical mirror's lectures root, and
    ``digest`` is the referenced file's content hash — part of the asset's
    identity, so same-named but byte-different files across series are never
    conflated.
    """
    root = mirror_lectures(plan.canonical)
    seen = set()
    for kind, written in extract_refs(text):
        if kind == "url":
            # Rule 7: hardcoded published URL — localise only when the target
            # exists in the source series' mirror _static, else warn.
            idx = written.find("/_static/")
            src_rel = written[idx + 1 :]
            if (root / src_rel).is_file():
                key = (written, src_rel)
                if key not in seen:
                    seen.add(key)
                    plan.refs.append((kind, written, src_rel, sha256_file(root / src_rel)))
            else:
                plan.warnings.append(
                    f"hardcoded URL target not in mirror/{plan.canonical} "
                    f"_static — left untouched: {written}"
                )
            continue

        literal = written.split("#", 1)[0]
        if not literal or SCHEME_RE.match(literal) or literal.startswith("#"):
            continue
        try:
            src_rel = to_src_rel(literal)
        except PromoteError:
            if kind in ("link", "code-str"):
                continue  # heuristic kinds: not a repo file reference
            raise
        base = posixpath.basename(src_rel)
        if base == BIB_BASENAME:
            plan.warnings.append(
                f"skipping {literal} — quant-econ.bib is owned by the "
                "bib-merge tool, not promotion"
            )
            continue
        if base.startswith(BRANDING_PREFIXES):
            raise PromoteError(
                f"branding asset {literal!r} referenced from lecture text — "
                "branding is a product/_base concern and must never enter a "
                "closure (assertion per _static conventions rule 6)"
            )
        exists = (root / src_rel).is_file()
        if kind == "link":
            # Local-file markdown links only: not .md (cross-lecture links
            # stay as-is) and only when the target is a real repo file.
            if src_rel.endswith(".md") or not exists:
                continue
        elif kind == "code-str":
            if not exists:
                plan.warnings.append(
                    f"code string looks like an asset path but resolves to no "
                    f"file in mirror/{plan.canonical} — ignored: {literal!r}"
                )
                continue
        elif not exists:
            raise PromoteError(
                f"{kind} reference {literal!r} does not resolve to a file "
                f"under mirror/{plan.canonical}/lectures/ — closure incomplete"
            )
        if kind == "include":
            check_include_is_leaf(root, src_rel)
        key = (literal, src_rel)
        if key not in seen:
            seen.add(key)
            plan.refs.append((kind, literal, src_rel, sha256_file(root / src_rel)))


# --------------------------------------------------------------------------- #
# Destination mapping (the pool _static conventions)                           #
# --------------------------------------------------------------------------- #
def plan_destination(src_rel: str, consumers) -> str:
    """Map a mirror asset path to its pool destination.

    Conventions (PLAN.md, M2): ``_static/<slug>/`` for single-consumer assets
    owned by that lecture; ``_static/_shared/`` for assets referenced by two
    or more pool lectures, for ``lecture_specific/<dir>/`` family dirs whose
    name is not the consuming slug (cross-lecture by construction), and for
    ``_admonition/`` includes (multi-lecture by construction).
    """
    if src_rel.startswith("_admonition/"):
        return "_static/_shared/" + src_rel
    shared = len(consumers) >= 2
    if src_rel.startswith("_static/lecture_specific/"):
        rest = src_rel[len("_static/lecture_specific/") :]
        dirname, _, tail = rest.partition("/")
        if tail:
            if shared or any(slug != dirname for slug in consumers):
                return f"_static/_shared/{dirname}/{tail}"
            return f"_static/{dirname}/{tail}"
    if src_rel.startswith("_static/"):
        rest = src_rel[len("_static/") :]
        if shared:
            return f"_static/_shared/{rest}"
        (only,) = tuple(consumers)
        if rest.startswith(only + "/"):
            return src_rel  # already in new-style _static/<slug>/ form
        return f"_static/{only}/{rest}"
    # Outside _static entirely (e.g. datasets/): keep the relative shape.
    if shared:
        return f"_static/_shared/{src_rel}"
    (only,) = tuple(consumers)
    return f"_static/{only}/{src_rel}"


def asset_version(pool_path: str, copies, record, state, left_out=(), tolerated=()):
    """Which version of a pool asset the pool holds, when the series its
    lectures come from each carry their own copy and the pool keeps one.

    ``copies`` is ``{series: path}``: the copies to judge, in manifest order
    (the series the asset's user lectures come from, among those this run
    considers). ``record`` is the asset's ledger record, if it has one.
    ``left_out`` names the series this run does not consider, and
    ``tolerated`` the series new to the record that no lecture in the batch
    is canonical in: such a copy, if it differs, is a different file that
    happens to share the name. It is recorded as one (``differs``), never
    refused and never taken for a lagging copy, as at a first promotion.
    Returns
    ``{"digest", "series", "path", "stale", "was", "since", "copies"}``: the
    version the pool takes, the highest-priority series that holds it and
    its path there (those bytes are the ones copied), and ``{series:
    stale_since}`` for the copies that are behind.

    With no record, every copy must agree byte-for-byte (rule 4, for a shared
    ``_admonition/`` include). With one, each recorded source is judged
    against the version recorded for IT (its own ``digest`` if it was stale,
    else the pool's):

    * a copy at the pool's version is current;
    * a copy that was current and has changed LEADS: the pool takes its
      version, for every lecture that uses the file, and the copies that
      did not follow are stale. Two leaders must agree;
    * a copy still at its own recorded, earlier version is stale;
    * anything else is refused: a stale copy that changed to a version that
      is not the pool's or a leader's, or a copy never recorded that differs
      and that a lecture in the batch is canonical in.
      A copy that is behind may only catch up, so a real fork is never taken
      for a lag.

    If every series that held the pool's version has dropped the file, the
    pool follows the copies that remain, which must agree.

    ``stale_since`` is when the copy fell behind: kept from the record while
    the copy has not moved, else the latest time a series holding the pool's
    version had its pin synced (``synced_at`` in sync/state.yml), so the same
    inputs give the same ledger.
    """
    src_rel = next(iter(copies.values()), pool_path)
    digests = {}
    for series, path in copies.items():
        f = mirror_lectures(series) / path
        if f.is_file():
            digests[series] = sha256_file(f)

    def differs(why=""):
        detail = ", ".join(f"{s}:{d[:12]}" for s, d in digests.items())
        return PromoteError(
            f"{src_rel} differs across series ({detail}){why} — the pool keeps "
            f"one copy, at {pool_path}; reconcile upstream first"
        )

    if not digests:
        # Not reachable from a lecture's own reference (its canonical series
        # holds the file, or the closure failed first); kept as a clear error.
        raise PromoteError(f"no series this run considers holds {src_rel}")
    if not record:
        if len(set(digests.values())) > 1:
            raise differs()
        series = next(iter(digests))
        return {
            "digest": digests[series], "series": series, "path": copies[series],
            "stale": {}, "differs": {}, "was": None, "since": "", "copies": copies,
        }

    pool = ledger_asset_digest(pool_path, record)
    # A copy recorded as a DIFFERENT file (``differs``) was never the pool's
    # version: it is judged afresh each time, as a copy not yet recorded.
    prev = {s.get("series"): s for s in record.get("sources") or [] if not s.get("differs")}
    was = {series: (p.get("digest") or pool) for series, p in prev.items()}
    moved = {s: d for s, d in digests.items() if d != pool and d != was.get(s)}
    leaders = {d for s, d in moved.items() if was.get(s) == pool}
    if len(leaders) > 1:
        raise differs("; the series that held the pool's version changed it differently")
    agreed = leaders.pop() if leaders else pool
    odd = sorted(
        s for s, d in moved.items()
        if d != agreed and not (s in tolerated and s not in prev)
    )
    if odd:
        raise differs(
            f"; {', '.join(odd)} was behind the pool's version, or never "
            "recorded, and is at neither that version nor a newer one the "
            "pool can take"
        )
    holders = [s for s in digests if digests[s] == agreed]
    if not holders:
        # Nobody this run considers holds the pool's version. If a series
        # that held it is merely left out of the run, the run cannot tell;
        # if they all dropped or lost the file, the pool follows the copies
        # that remain, which must agree.
        missing = sorted(s for s in was if was[s] == pool and s in left_out)
        if missing:
            raise PromoteError(
                f"the pool's version of {src_rel} is held only by "
                f"{', '.join(missing)}, which this run leaves out — run "
                "without excluding it"
            )
        if len(set(digests.values())) != 1:
            raise differs("; no series holds the pool's version any more")
        agreed = next(iter(digests.values()))
        holders = list(digests)
    stale, differs_now = {}, {}
    for series, digest in digests.items():
        if digest == agreed:
            continue
        if series in tolerated and series not in prev:
            differs_now[series] = digest
            continue
        since = (prev.get(series) or {}).get("stale_since")
        if not since or (prev[series].get("digest") or pool) != digest:
            synced = [str((state.get(h) or {}).get("synced_at") or "") for h in holders]
            since = max(synced) or now_iso()
        stale[series] = str(since)
    synced = [str((state.get(h) or {}).get("synced_at") or "") for h in holders]
    return {
        "digest": agreed,
        "series": holders[0],
        "path": copies[holders[0]],
        "stale": stale,
        "differs": differs_now,
        "was": pool,
        "since": max(synced) or now_iso(),
        "copies": copies,
    }


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def build_rewrites(plan: Plan, text: str, dest_map):
    """Derive the ordered literal replacements and the transformed pool text.

    Replacements are applied longest-``from`` first so a root-relative form
    (``/_static/...``) can never be corrupted by its embedded file-relative
    substring, then each is verified to (a) still occur when its turn comes
    and (b) not be re-matchable inside an earlier replacement's output. The
    recorded order IS the application order, and each pair is a SINGLE
    non-rescanning ``str.replace`` pass — a ``from`` embedded in its own
    ``to`` (the common ``_admonition/gpu.md`` include rewrite) is therefore
    legal and correct, but any replayer MUST NOT apply the list iteratively
    to a fixpoint or via rescanning substitution (see LEDGER_HEADER).
    """
    pairs = {}
    for kind, literal, src_rel, digest in plan.refs:
        dest = dest_map[(src_rel, digest)]
        if literal != dest:
            if literal in pairs and pairs[literal] != dest:
                raise PromoteError(
                    f"conflicting rewrites for literal {literal!r}: "
                    f"{pairs[literal]!r} vs {dest!r}"
                )
            pairs[literal] = dest
    ordered = sorted(pairs.items(), key=lambda kv: (-len(kv[0]), kv[0]))
    for i, (_, to_i) in enumerate(ordered):
        for frm_j, _ in ordered[i + 1 :]:
            if frm_j in to_i:
                raise PromoteError(
                    f"rewrite ordering hazard: later from {frm_j!r} occurs "
                    f"inside earlier to {to_i!r} — refusing to promote"
                )
    out = text
    for frm, to in ordered:
        if frm not in out:
            raise PromoteError(
                f"rewrite from {frm!r} no longer matches after earlier "
                "replacements — refusing to promote"
            )
        out = out.replace(frm, to)
    plan.rewrites = ordered
    plan.pool_text = out


# --------------------------------------------------------------------------- #
# Target selection                                                             #
# --------------------------------------------------------------------------- #
def toc_slugs(series: str):
    """Every ``file:`` entry (plus the root) of a series' _toc.yml, in order."""
    path = mirror_lectures(series) / "_toc.yml"
    if not path.is_file():
        raise SystemExit(
            f"error: {path} not found — run `tools/sync {series}` first."
        )
    data = load_yaml(path) or {}
    slugs = []

    def walk(node):
        if isinstance(node, dict):
            f = node.get("file")
            if isinstance(f, str):
                slugs.append(slug_of(f))
            for key in ("parts", "chapters", "sections"):
                walk(node.get(key))
        elif isinstance(node, list):
            for item in node:
                walk(item)

    root = data.get("root")
    if isinstance(root, str):
        slugs.append(slug_of(root))
    walk(data)
    ordered, seen = [], set()
    for s in slugs:
        if s not in seen:
            seen.add(s)
            ordered.append(s)
    return ordered


def asset_users(pool_path: str, ledger_lectures):
    """``{slug: entry}`` for the ledger lectures that use a pool asset."""
    return {
        slug_of(key[len("lectures/"):]): entry
        for key, entry in ledger_lectures.items()
        if pool_path in (entry.get("assets") or [])
    }


def users_series(entries):
    """The series an asset's user lectures come from: each user's canonical
    series, and each series recorded as holding the same lecture whose copy
    is still at its recorded digest. A copy that has since been edited may
    no longer be that lecture (the drift-check reports it), so its series'
    copy of the asset is not followed on its account."""
    found = set()
    for entry in entries:
        found.add(entry.get("canonical"))
        for item in entry.get("sources") or []:
            f = mirror_lectures(str(item.get("series"))) / str(item.get("path"))
            if f.is_file() and sha256_file(f) == item.get("digest"):
                found.add(item.get("series"))
    return found


def record_copies(record, series_of_users, considered, consumers, order):
    """``{series: path}`` from an asset record: its recorded sources that
    this run considers, that are not consumers, and that its users come
    from, in manifest order."""
    copies = {}
    for item in sorted(
        (record or {}).get("sources") or [],
        key=lambda i: order.index(i.get("series")) if i.get("series") in order else len(order),
    ):
        series = item.get("series")
        if series in considered and series not in consumers and series in series_of_users:
            copies.setdefault(series, item.get("path"))
    return copies


def holds(series: str, slug: str) -> bool:
    """Whether ``series``' mirror holds ``<slug>.md`` under exactly that name.
    The directory is listed, since a case-insensitive file system answers
    ``is_file()`` for ``Foo.md`` when only ``foo.md`` is there."""
    path = mirror_lectures(series) / f"{slug}.md"
    try:
        return path.name in os.listdir(path.parent) and path.is_file()
    except OSError:
        return False


def toc_lists(series: str, slug: str):
    """Whether ``series``' mirror toc lists ``slug``; None when there is no
    toc there, or one that lists no lecture at all (empty, or a form this
    reader does not follow), which says nothing about any one lecture."""
    if not (mirror_lectures(series) / "_toc.yml").is_file():
        return None
    listed = toc_slugs(series)
    return slug in listed if listed else None


def inbound_links(slug: str, ledger_lectures):
    """Pool lectures whose text links to ``slug`` with a ``{doc}`` role."""
    pattern = re.compile(r"\{doc\}`(?:[^`<]*<)?(?:[\w-]+:)?" + re.escape(slug) + r">?`")
    found = []
    for key in sorted(ledger_lectures):
        other = slug_of(posixpath.basename(key))
        f = POOL_DIR / f"{other}.md"
        if other != slug and f.is_file() and pattern.search(f.read_text(encoding="utf-8", errors="replace")):
            found.append(other)
    return found


def retire_refusal(slug, ledger_lectures, order, considered, consumers):
    """Why ``--retire`` will not retire ``slug``, or None when it may.

    Retirement is for a lecture its home series no longer publishes. It never
    acts on an entry whose canonical series is outside ``sync/manifest.yml``:
    a series the pool has taken over is out of the manifest, and nothing of a
    pool-owned series is removed by this tool.
    """
    entry = ledger_lectures.get(f"lectures/{slug}.md")
    if entry is None:
        return f"lectures/{slug}.md is not in the ledger"
    canonical = entry.get("canonical")
    if canonical not in order:
        return (
            f"its canonical series '{canonical}' is not in sync/manifest.yml "
            "— a series the pool has taken over, or one no longer synced; "
            "retirement never acts on it"
        )
    if canonical not in considered:
        return f"its canonical series '{canonical}' is excluded from this run"
    listed = toc_lists(canonical, slug)
    if listed:
        return (
            f"{canonical}'s _toc.yml still lists it — it is still published "
            "there; remove it upstream first"
        )
    publishing = [
        s for s in considered
        if s != canonical and s not in consumers and holds(s, slug) and toc_lists(s, slug)
    ]
    if publishing:
        return (
            f"{', '.join(publishing)} still "
            + ("holds it and lists it in its" if len(publishing) == 1 else "hold it and list it in their")
            + f" _toc.yml — it is still published; `tools/promote {slug}` "
            "re-homes it there"
        )
    if listed is None and holds(canonical, slug):
        return (
            f"its canonical copy still exists in {canonical}, whose mirror "
            "has no _toc.yml, or one that lists no lecture, to show it was "
            "dropped"
        )
    return None


def refresh_targets(ledger_lectures, state, considered, consumers, order=None):
    """Ledger entries whose canonical series pin moved since promotion.

    Design note: refresh deliberately re-anchors each entry on its RECORDED
    canonical series (``requested=canonical``), not on a fresh priority
    resolution — refresh tracks the canonical copy's movement, so the entry's
    identity stays stable. A copy edited since its last promotion is refused
    like any other same-name collision (the canonical map settles it); one
    still at a version recorded then, while the canonical copy moved on, is
    stale and stays a source (see ``resolve_sources``). Only
    the canonical pin is watched (per the refresh spec); ``sources``/
    ``divergent``/``superseded`` provenance is as of each entry's last
    promotion.

    Returns ``(targets, skipped, refused)``. An entry this run cannot refresh
    (its canonical series is excluded, or is a consumer) is skipped while its
    pin has not moved, and REFUSED once it has: a silent skip would leave the
    pool copy behind upstream with a clean exit and a green run. An entry
    whose canonical copy is gone upstream is skipped whatever its pin: the
    refresh never retires, and the rest must still refresh.
    """
    targets, skipped, refused = [], [], []
    for key in sorted(ledger_lectures):
        entry = ledger_lectures[key]
        slug = slug_of(posixpath.basename(key))
        canonical = entry.get("canonical")
        pinned = (entry.get("promoted_at") or {}).get(canonical)
        current = (state.get(canonical) or {}).get("sha") or ""
        if order is not None and canonical not in order:
            why = f"canonical series '{canonical}' is not in sync/manifest.yml"
            remedy = (
                f"promote {slug} by name to re-home it to a series that holds "
                "it, or restore the series' stanza"
            )
            skip = f"{why} — {remedy}"
        elif canonical in consumers:
            why = f"canonical series '{canonical}' is a consumer"
            remedy = (
                f"promote {slug} by name to re-home it to a series that holds "
                "it, or decide whether to retire it"
            )
            skip = f"{why} — {remedy}"
        elif canonical not in considered:
            why = f"canonical series '{canonical}' is excluded"
            remedy = (
                "refresh without excluding it (CI's exclusions are "
                "PROMOTE_EXCLUDE in .github/workflows/drift-check.yml)"
            )
            skip = why
        else:
            if not (mirror_lectures(canonical) / key[len("lectures/"):]).is_file():
                # The refresh never retires, and one lecture gone upstream
                # must not stop the rest refreshing. The drift-check reports
                # it (canonical-removed) until it is retired or re-homed.
                skipped.append((
                    slug,
                    f"its canonical copy is gone from {canonical} upstream "
                    "(removed or renamed) — not refreshed, and never retired "
                    "by a refresh. " + retire_remedy(slug, canonical),
                ))
            elif pinned != current:
                targets.append((slug, canonical))
            continue
        if pinned != current:
            refused.append((
                slug, canonical,
                f"{why}, but its pin moved since promotion "
                f"({(pinned or 'none')[:12]} -> {current[:12] or 'none'}): {remedy}",
            ))
        else:
            skipped.append((slug, skip))
    return targets, skipped, refused


# --------------------------------------------------------------------------- #
# CLI                                                                          #
# --------------------------------------------------------------------------- #
def build_parser():
    parser = argparse.ArgumentParser(
        prog="tools/promote",
        description=(
            "Promote lectures from mirror/<series>/lectures/ into the "
            "lectures/ pool with their asset closures, recording provenance "
            "and every rewrite in sync/ledger.yml."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Series keys and classes are defined in sync/manifest.yml; the "
            "canonical map is sync/canonical.yml."
        ),
    )
    parser.add_argument(
        "slugs",
        nargs="*",
        metavar="SLUG",
        help="lecture slugs to promote (source resolved per-lecture).",
    )
    parser.add_argument(
        "--toc",
        metavar="SERIES",
        help="promote every lecture in mirror/SERIES/lectures/_toc.yml.",
    )
    parser.add_argument(
        "--refresh",
        action="store_true",
        help="re-promote pool files whose canonical series pin moved.",
    )
    parser.add_argument(
        "--retire",
        action="store_true",
        help="retire the named SLUGs: remove them from the pool and the "
        "ledger, with the assets no other pool lecture uses.",
    )
    parser.add_argument(
        "--exclude",
        nargs="+",
        metavar="SERIES",
        default=[],
        help="series excluded from source/dedup consideration for this run "
        "(none by default; CI excludes PROMOTE_EXCLUDE in "
        ".github/workflows/drift-check.yml).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the full plan without writing anything.",
    )
    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)

    modes = [bool(args.slugs), bool(args.toc), args.refresh]
    if args.retire and (args.toc or args.refresh or not args.slugs):
        parser.error("--retire takes the SLUGs to retire, and neither --toc nor --refresh")
    if sum(modes) != 1:
        parser.error("choose exactly one of: SLUG..., --toc SERIES, --refresh")

    order, consumers = load_manifest()
    excluded = set(args.exclude)
    unknown = [s for s in args.exclude if s not in order]
    if unknown:
        parser.error(
            "unknown series in --exclude: "
            + ", ".join(unknown)
            + "\nvalid keys: "
            + ", ".join(order)
        )

    considered = [s for s in order if s not in excluded]
    eligible = [s for s in considered if s not in consumers]
    if not eligible:
        parser.error(
            "every canonical-eligible series is excluded — nothing can be promoted."
        )
    if args.toc and args.toc not in order:
        parser.error(f"unknown series '{args.toc}' (valid: {', '.join(order)})")
    if args.toc and args.toc in excluded:
        parser.error(f"series '{args.toc}' is excluded from consideration.")
    canonical_map = load_canonical_map(order, consumers)

    # Dedup hashes across every considered series, so all their mirrors must
    # exist — a missing mirror would silently change canonical decisions.
    missing = [s for s in considered if not mirror_lectures(s).is_dir()]
    if missing:
        sys.stderr.write(
            "error: mirror missing for: "
            + ", ".join(missing)
            + "\n       Run `tools/sync "
            + " ".join(missing)
            + "` first (dedup must see every non-excluded series).\n"
        )
        return 1
    for slug in map_slugs_held_nowhere(canonical_map, order, consumers):
        print(
            f"[{slug}] WARN: {CANONICAL_MAP_PATH.name} names {slug}, but no "
            f"canonical-eligible series mirror holds {slug}.md — a typo, or a "
            "lecture renamed or retired upstream"
        )

    state = load_state()
    for s in considered:
        if not ((state.get(s) or {}).get("sha") or ""):
            sys.stderr.write(
                f"error: no pinned SHA for '{s}' in {STATE_PATH.name} — "
                "promotion records pins; run `tools/sync --update` first.\n"
            )
            return 1

    ledger_lectures, ledger_assets = load_ledger()

    # ------------------------------------------------------------------ #
    # Target selection                                                    #
    # ------------------------------------------------------------------ #
    skips = []  # (slug, reason)
    retired = []  # slugs leaving the pool in this run
    retire_notes = []  # lines printed with the plan
    if args.retire:
        slugs, refusals = [], []
        for slug in dict.fromkeys(slug_of(s) for s in args.slugs):
            why = retire_refusal(slug, ledger_lectures, order, considered, consumers)
            if why:
                refusals.append((slug, why))
                continue
            slugs.append(slug)
            held = [s for s in considered if holds(s, slug)]
            listing = [s for s in held if toc_lists(s, slug)]
            if held:
                retire_notes.append(
                    f"[{slug}] WARN: {', '.join(held)} still "
                    + ("holds" if len(held) == 1 else "hold")
                    + f" {slug}.md"
                    + (f", and the toc of {', '.join(listing)} lists it" if listing else "")
                    + " — what is built from there needs a decision"
                )
        if refusals:
            for slug, why in refusals:
                sys.stderr.write(f"[{slug}] FAILED: not retired: {why}\n")
            sys.stderr.write(
                f"error: nothing was retired ({len(refusals)} of "
                f"{len(slugs) + len(refusals)} refused; --retire is all or nothing).\n"
            )
            return 1
        retired = slugs
        targets = []
    elif args.refresh:
        targets, refresh_skips, refresh_refused = refresh_targets(
            ledger_lectures, state, considered, consumers, order
        )
        skips.extend(refresh_skips)
        # A shared file whose version changes (a series leads, or the
        # holders of the pool's version dropped it) is refreshed through the
        # lectures that use it, whether or not their own pins moved: the
        # series that changed it may have no moved lecture that does.
        chosen = {slug for slug, _ in targets}
        barred = {slug for slug, _ in refresh_skips} | {slug for slug, _, _ in refresh_refused}
        for dest in sorted(ledger_assets):
            record = ledger_assets[dest]
            users = asset_users(dest, ledger_lectures)
            series_of_users = users_series(users.values())
            copies = record_copies(record, series_of_users, considered, consumers, order)
            # A record whose canonical series none of its lectures come from
            # any more is rewritten through its users.
            rewrite = record.get("canonical") not in series_of_users
            if not rewrite:
                if len(copies) < 2 and not dest.startswith(ADMONITION_DEST):
                    continue  # one series: its own pin moves when the file does
                plain = {i.get("series") for i in record.get("sources") or [] if not i.get("differs")}
                try:
                    version = asset_version(
                        dest, copies, record, state,
                        [x for x in order if x not in considered], set(copies) - plain,
                    )
                except PromoteError:
                    continue  # refused, with its reason, when a user is planned
                # The version moved, or a copy caught up (or fell behind):
                # the record must say so, or the copy is misjudged next time.
                behind = {
                    i.get("series") for i in record.get("sources") or []
                    if "digest" in i and i.get("series") in copies
                }
                rewrite = (
                    version["digest"] != ledger_asset_digest(dest, record)
                    or set(version["stale"]) | set(version["differs"]) != behind
                )
            if not rewrite:
                continue
            for slug in sorted(users):
                if slug not in chosen | barred:
                    chosen.add(slug)
                    targets.append((slug, users[slug].get("canonical")))
        if not targets and not refresh_skips and not refresh_refused:
            print("nothing to refresh — every canonical pin matches its ledger entry.")
            return 0
    elif args.toc:
        # A consumer's toc names lectures it republishes: each comes from its
        # canonical home, resolved by priority, never from the consumer.
        requested = None if args.toc in consumers else args.toc
        listed = toc_slugs(args.toc)
        targets = [(slug, requested) for slug in listed]
        # Retire what this series dropped, before the batch is planned, so a
        # retired lecture's assets are not counted as still in use.
        for key in sorted(ledger_lectures):
            # The slug with any folder, as the toc spells it: a lecture moved
            # into a subfolder is retired here and promoted there.
            slug = slug_of(key[len("lectures/"):])
            if (
                args.toc in consumers
                or ledger_lectures[key].get("canonical") != args.toc
                or not listed  # an empty toc says nothing was dropped
                or slug in listed
                or holds(args.toc, slug)
            ):
                continue
            holders = [s for s in order if s != args.toc and holds(s, slug)]
            unseen = [
                s for s in order
                if s not in considered and not mirror_lectures(s).is_dir()
            ]
            if holders or unseen:
                retire_notes.append(
                    f"[{slug}] WARN: left {args.toc}'s toc and its canonical "
                    "copy is gone, but "
                    + (
                        f"{', '.join(holders)} still "
                        + ("holds" if len(holders) == 1 else "hold")
                        + f" {slug}.md"
                        if holders
                        else f"{', '.join(unseen)} (excluded, with no mirror on disk) could not be checked"
                    )
                    + " — not retired: "
                    + (
                        f"`tools/promote {slug}` re-homes it, or "
                        if any(s not in consumers for s in holders) or not holders
                        else ""
                    )
                    + f"`tools/promote --retire {slug}` retires it"
                )
                continue
            retired.append(slug)
        if len(retired) > RETIRE_CAP:
            sys.stderr.write(
                f"error: {len(retired)} lectures canonical in {args.toc} have "
                "left its toc with their copies gone and their names held by "
                f"no series: {', '.join(retired)}.\n"
                f"       More than {RETIRE_CAP} are never retired by a --toc "
                "run (a toc or folder lost upstream must not empty the pool). "
                "Nothing was retired or promoted.\n"
                "       If they are real removals, retire them by name: "
                f"`tools/promote --retire {' '.join(retired)}`.\n"
            )
            return 1
    else:
        targets = [(slug_of(s), None) for s in args.slugs]

    for slug in retired:
        del ledger_lectures[f"lectures/{slug}.md"]
    for slug in retired:
        linking = inbound_links(slug, ledger_lectures)
        if linking:
            retire_notes.append(
                f"[{slug}] WARN: {len(linking)} pool lecture(s) link to {slug} "
                f"with {{doc}} and will not resolve it: {', '.join(linking)}"
            )

    plans, seen_slugs = [], set()
    for slug, requested in targets:
        if slug in seen_slugs:
            continue
        seen_slugs.add(slug)
        if posixpath.basename(slug) in PRODUCT_PAGES:
            # Product pages are never pool content. Encountered via --toc
            # they are expected and skipped (the spec's rule); named
            # EXPLICITLY they are refused as an error — an operator asking
            # for one must not get a silent success.
            reason = (
                "product page (per-series boilerplate) — becomes a "
                "products/<key>/ page in M3, not pool content"
            )
            if args.toc:
                skips.append((slug, reason))
            else:
                plan = Plan(slug, requested)
                plan.error = f"refusing to promote a {reason}"
                plans.append(plan)
            continue
        plans.append(Plan(slug, requested))
    if args.refresh:
        for slug, canonical, reason in refresh_refused:
            plan = Plan(slug, canonical)
            plan.error = reason
            plans.append(plan)

    # ------------------------------------------------------------------ #
    # Phase 1 — resolve sources and parse closures (per-lecture errors    #
    # are recorded and never abort the rest of the batch).                #
    # ------------------------------------------------------------------ #
    consumer_series = consumers  # the loop below reuses the name `consumers`
    not_considered = [s for s in order if s not in considered]
    texts = {}

    def prepare(plan):
        """Phase 1 for one plan: its sources, text and closure as its own
        series has them (``plan.own_refs``)."""
        try:
            text = resolve_sources(
                plan, considered, consumer_series, canonical_map,
                ledger_lectures.get(f"lectures/{plan.slug}.md"), order,
            )
            collect_refs(plan, text)
            plan.own_refs = list(plan.refs)
            texts[plan.slug] = text
        except PromoteError as exc:
            plan.error = str(exc)
        except Exception as exc:  # never let one lecture abort the rest
            plan.error = f"unexpected: {exc}"

    for plan in plans:
        if plan.error is None:
            prepare(plan)

    ok = [p for p in plans if p.error is None]

    # ------------------------------------------------------------------ #
    # Phases 2–4 — the pool's version of each recorded asset, consumer    #
    # counts, destination decisions, asset bytes, collision checks, and   #
    # rewrites. Destination decisions depend on which plans SURVIVE, so   #
    # the phases iterate to a fixed point: after every cull (and every    #
    # lecture pulled in), versions, consumers and destinations are        #
    # re-derived from the surviving batch. The pool layout therefore      #
    # never counts a failed plan (or a re-promoted lecture's stale old    #
    # closure) as a consumer. Culled plans keep their first error; none   #
    # are revived.                                                        #
    # ------------------------------------------------------------------ #
    # A NEW asset's identity is (src_rel, digest), NOT the path alone: two
    # series can carry same-named but byte-different files, and keying by
    # path would conflate them into phantom shared consumers and unresolvable
    # collisions. A RECORDED asset is found by the copy the ledger records
    # for the lecture's own series, whatever its bytes are now: the pool
    # keeps one version of it (``asset_version``).
    src_to_pool = {}  # (src_rel, digest) -> pool path already in the ledger
    recorded_at = {}  # (series, src_rel) -> pool path already in the ledger
    by_bytes = {}  # digest -> pool paths recorded with those bytes
    for pool_path, meta in ledger_assets.items():
        digest = ledger_asset_digest(pool_path, meta)
        by_bytes.setdefault(digest, []).append(pool_path)
        for src in meta.get("sources") or []:
            src_to_pool.setdefault((src.get("path"), digest), pool_path)
            if not src.get("differs"):
                # A copy recorded as a different file is not this asset: a
                # lecture of that series using the name has its own file.
                recorded_at.setdefault((src.get("series"), src.get("path")), pool_path)

    def recorded_asset(plan, src_rel, digest):
        """The pool path of the recorded asset a reference belongs to, if any."""
        found = recorded_at.get((plan.canonical, src_rel)) or src_to_pool.get((src_rel, digest))
        if found is None:
            # The series moved or renamed the file: the same bytes, and its
            # recorded path is gone. It is still that asset, at a new path.
            for pool_path in by_bytes.get(digest, ()):
                for src in ledger_assets[pool_path].get("sources") or []:
                    if (
                        src.get("series") == plan.canonical
                        and not src.get("differs")
                        and not (mirror_lectures(plan.canonical) / str(src.get("path"))).is_file()
                    ):
                        found = pool_path
        if found is None and src_rel.startswith(ADMONITION_SRC):
            dest = ADMONITION_DEST + src_rel[len(ADMONITION_SRC):]
            found = dest if dest in ledger_assets else None
        return found

    pulled = {}  # slug -> the slug whose asset move pulled it into the batch
    optional = set()  # pulled in only so a record could follow its users
    declined = {}  # optional pull-ins that could not be re-promoted -> why
    while True:
        # An optional pull-in that cannot be re-promoted is let go, with a
        # note: its own pin did not move, and nothing in this run needs it.
        for plan in [p for p in plans if p.slug in optional and p.error is not None]:
            declined[plan.slug] = plan.error
            optional.discard(plan.slug)
            pulled.pop(plan.slug, None)
            plans.remove(plan)
        replanned = {p.slug for p in ok}
        kept_entries = {  # ledger lectures NOT being re-promoted
            slug_of(key[len("lectures/"):]): entry
            for key, entry in ledger_lectures.items()
            if slug_of(key[len("lectures/"):]) not in replanned
        }

        # The pool's version of every recorded asset this batch touches, and
        # each reference pointed at it: the pool holds ONE version of a
        # shared file, which need not be the lecture's own series' copy.
        touched = {}  # pool path -> {"plans": [...], "copies": {series: path}}
        for plan in ok:
            plan.refs = list(plan.own_refs)
            for _, _, src_rel, digest in plan.own_refs:
                pool_path = recorded_asset(plan, src_rel, digest)
                if pool_path is None and src_rel.startswith(ADMONITION_SRC):
                    pool_path = ADMONITION_DEST + src_rel[len(ADMONITION_SRC):]  # rule 4, unrecorded
                if pool_path is None:
                    continue
                entry = touched.setdefault(pool_path, {"plans": [], "extra": {}, "homes": set()})
                entry["plans"].append(plan)
                entry["homes"].add(plan.canonical)
                for series in [plan.canonical] + [x for x in plan.sources if x != plan.canonical]:
                    if (mirror_lectures(series) / src_rel).is_file():
                        entry["extra"].setdefault(series, src_rel)
        versions = {}  # pool path -> asset_version()'s result
        for pool_path, entry in touched.items():
            record = ledger_assets.get(pool_path)
            series_of_users = users_series(
                e for slug, e in kept_entries.items() if pool_path in (e.get("assets") or [])
            ) | set(entry["extra"])
            copies = record_copies(record, series_of_users, considered, consumer_series, order)
            for series, path in entry["extra"].items():
                # The path a lecture uses now wins over a recorded one that
                # is gone upstream (the file was moved or renamed).
                if series not in copies or not (mirror_lectures(series) / str(copies[series])).is_file():
                    copies[series] = path
            copies = {x: copies[x] for x in order if x in copies}
            recorded = {i.get("series") for i in (record or {}).get("sources") or [] if not i.get("differs")}
            tolerated = set(copies) - recorded - entry["homes"]
            try:
                versions[pool_path] = asset_version(pool_path, copies, record, state, not_considered, tolerated)
            except PromoteError as exc:
                # A lecture from a series new to this asset that brings
                # different bytes is refused on its own: the lectures that
                # already use the asset are not held back by it.
                blamed = entry["plans"]
                newcomers = [p for p in entry["plans"] if p.canonical not in recorded]
                if record and newcomers and len(newcomers) < len(entry["plans"]):
                    rest = {x: path for x, path in copies.items() if x in recorded}
                    try:
                        asset_version(pool_path, rest, record, state, not_considered)
                        blamed = newcomers
                    except PromoteError:
                        pass
                for plan in blamed:
                    if plan.error is None:
                        plan.error = str(exc)
        if any(p.error is not None for p in ok):
            ok = [p for p in ok if p.error is None]
            continue
        asset_of = {}  # (src_rel, digest) as re-pointed -> pool path of its record
        for plan in ok:
            try:
                for i, (kind, literal, src_rel, digest) in enumerate(plan.own_refs):
                    pool_path = recorded_asset(plan, src_rel, digest)
                    if pool_path is None and src_rel.startswith(ADMONITION_SRC):
                        pool_path = ADMONITION_DEST + src_rel[len(ADMONITION_SRC):]
                    if pool_path is None:
                        continue
                    version = versions[pool_path]
                    if kind == "include" and version["series"] != plan.canonical:
                        check_include_is_leaf(mirror_lectures(version["series"]), version["path"])
                    plan.refs[i] = (kind, literal, src_rel, version["digest"])
                    if pool_path in ledger_assets:
                        asset_of[(src_rel, version["digest"])] = pool_path
            except PromoteError as exc:
                plan.error = str(exc)
        if any(p.error is not None for p in ok):
            ok = [p for p in ok if p.error is None]
            continue

        consumers = {}  # (src_rel, digest) -> set of consuming slugs
        counted_via = {}  # (src_rel, digest) -> {kept slug: the pool path it uses}
        for plan in ok:
            for _, _, src_rel, digest in plan.refs:
                consumers.setdefault((src_rel, digest), set()).add(plan.slug)
        kept_consumers = {}  # pool path -> ledger slugs NOT being re-promoted
        for slug, entry in kept_entries.items():
            # A batch that replaces an entry never counts its OLD closure —
            # a dropped reference would otherwise linger as a phantom
            # consumer and misplace single-consumer assets.
            for pool_path in entry.get("assets") or []:
                kept_consumers.setdefault(pool_path, set()).add(slug)
                meta = ledger_assets.get(pool_path) or {}
                # A lecture outside the batch uses the pool's one file, so it
                # counts as a user of the version this batch gives it: a
                # shared file must never split across two pool paths.
                version = versions.get(pool_path)
                digest = version["digest"] if version else ledger_asset_digest(pool_path, meta)
                paths = {src.get("path") for src in meta.get("sources") or []}
                if version:
                    paths |= set(version["copies"].values())
                for path in paths:
                    consumers.setdefault((path, digest), set()).add(slug)
                    counted_via.setdefault((path, digest), {})[slug] = pool_path

        # A recorded asset is ONE file however its series spell its path:
        # every reference to it shares its users, and its pool path is the
        # one the copy the pool takes would have.
        one_asset = {}  # (src_rel, digest) -> (the path that decides, all its users)
        for pool_path, version in versions.items():
            if pool_path not in ledger_assets:
                continue
            paths = set(version["copies"].values()) | {
                src.get("path") for src in ledger_assets[pool_path].get("sources") or []
            }
            keys = [k for k in consumers if k[1] == version["digest"] and k[0] in paths]
            everyone = set().union(*(consumers[k] for k in keys)) if keys else set()
            for k in keys:
                consumers[k] = everyone
                one_asset[k] = version["path"]

        dest_map = {}
        for (src_rel, digest), cons in consumers.items():
            dest_map[(src_rel, digest)] = plan_destination(one_asset.get((src_rel, digest), src_rel), sorted(cons))

        # A previously promoted asset whose destination decision has now
        # changed (a second consumer arrived, so it belongs in _shared/)
        # moves only with every lecture that references the old location:
        # those outside the batch are pulled into it, and re-promoted from
        # their own canonical series. One that cannot be (it was refused or
        # skipped in this run) holds the mover back, so the lectures that
        # share a file stay together.
        # Likewise a lecture outside the batch that was counted as a user of
        # a file through ANOTHER pool path (its series' copy has become the
        # same file), and the remaining users of a file a batch lecture
        # stopped using, whose path and record follow its users.
        wanted = {}  # slug to pull in -> (the plan that needs it, old pool path, must it succeed)

        def stuck_reason(slug):
            """Why a kept lecture cannot be pulled into this batch, or None."""
            known = {p.slug: p for p in plans}
            if slug in declined:
                return declined[slug]
            if slug in known:
                return known[slug].error or "it was dropped from this batch"
            if slug in {x for x, _ in skips}:
                return "skipped in this run"
            canonical = kept_entries[slug].get("canonical")
            if canonical not in order:
                return f"its canonical series '{canonical}' is not in sync/manifest.yml"
            if canonical not in considered:
                return f"its canonical series '{canonical}' is excluded from this run"
            if canonical in consumer_series:
                return f"its canonical series '{canonical}' is a consumer"
            return None

        for plan in ok:
            for _, _, src_rel, digest in plan.refs:
                old = asset_of.get((src_rel, digest)) or src_to_pool.get((src_rel, digest))
                new = dest_map[(src_rel, digest)]
                movers = set()
                if old and old != new:
                    movers |= kept_consumers.get(old, set())
                    # The file at the old path goes when the asset moves: a
                    # hand edit there must not vanish with it.
                    was = (ledger_assets.get(old) or {}).get("digest")
                    f = POOL_DIR / old
                    if was and f.is_file() and sha256_file(f) != was:
                        plan.error = (
                            f"asset {src_rel} moves from {old} to {new}, but the "
                            f"pool file at {old} differs from its recorded digest "
                            "(edited directly?) — reconcile deliberately"
                        )
                        break
                movers |= {x for x, via in counted_via.get((src_rel, digest), {}).items() if via != new}
                if not movers:
                    continue
                reasons = {x: stuck_reason(x) for x in sorted(movers)}
                stuck = [x for x in reasons if reasons[x]]
                if stuck:
                    plan.error = (
                        f"asset {src_rel} "
                        + (f"is recorded at {old} but now maps to {new}" if old and old != new else f"now maps to {new}")
                        + f", so it moves with its other consumer(s) ({', '.join(sorted(movers))}), "
                        f"and {stuck[0]} could not be re-promoted: {reasons[stuck[0]]}"
                    )
                    break
                for slug in sorted(movers):
                    wanted.setdefault(slug, (plan, old or new, True))
            if plan.error is not None:
                continue
            # What this lecture used and no longer does.
            now = {dest_map[(r[2], r[3])] for r in plan.refs}
            for dropped in (ledger_lectures.get(f"lectures/{plan.slug}.md") or {}).get("assets") or []:
                if dropped in now:
                    continue
                for slug in sorted(kept_consumers.get(dropped, ())):
                    if stuck_reason(slug) is None and slug not in declined:
                        wanted.setdefault(slug, (plan, dropped, False))
        if any(p.error is not None for p in ok):
            ok = [p for p in ok if p.error is None]
            continue
        if wanted:
            for slug, (needing, old, needed) in wanted.items():
                plan = Plan(slug, kept_entries[slug].get("canonical"))
                pulled[slug] = (needing.slug, old)
                if not needed:
                    optional.add(slug)
                plans.append(plan)
                prepare(plan)
                if plan.error is None:
                    ok.append(plan)
            continue

        # Asset bytes and collision detection. Every source path
        # contributing the same bytes to a destination is kept
        # (``src_rels``) so the ledger records the full dedup provenance.
        # Two lectures that bring DIFFERENT bytes to one destination are
        # both refused: which file the pool keeps never falls out of run
        # order.
        claims = {}  # dest -> {digest: [(plan, series, src_rel)]}
        record_of = {}  # dest -> the pool path its record is under (it may be moving)
        for plan in ok:
            for _, _, src_rel, digest in plan.refs:
                dest = dest_map[(src_rel, digest)]
                if (src_rel, digest) in asset_of:
                    record_of.setdefault(dest, asset_of[(src_rel, digest)])
                version = versions.get(asset_of.get((src_rel, digest)) or dest)
                series, path = (version["series"], version["path"]) if version else (plan.canonical, src_rel)
                claims.setdefault(dest, {}).setdefault(digest, []).append((plan, series, path))
        planned = {}  # dest -> {digest, src_rel(s), series, path (source)}
        for dest, by_digest in claims.items():
            if len(by_digest) > 1:
                parts = sorted(
                    " and ".join(sorted({f"{series}:{path} (used by {plan.slug})" for plan, series, path in group}))
                    for group in by_digest.values()
                )
                for group in by_digest.values():
                    for plan, _, _ in group:
                        if plan.error is None:
                            plan.error = (
                                f"asset destination collision at {dest}: "
                                + " differs from ".join(parts)
                                + " — one pool path holds one file: reconcile the "
                                "copies upstream, or rename one"
                            )
                continue
            ((digest, group),) = by_digest.items()
            _, series, path = group[0]
            planned[dest] = {
                "digest": digest,
                "src_rel": path,
                "src_rels": {p for _, _, p in group},
                "series": series,
                "path": mirror_lectures(series) / path,
            }
        if any(p.error is not None for p in ok):
            ok = [p for p in ok if p.error is None]
            continue

        # Existing pool bytes may only change under a recorded re-promotion:
        # a differing file that is still referenced by lectures OUTSIDE the
        # batch, or that has NO ledger record at all (hand-dropped, or
        # orphaned by a crash), is a hard error — never silently clobbered.
        # A recorded asset whose version ``asset_version`` has just moved on
        # is the exception to the first: it is one file for every lecture
        # that uses it, in the batch or not. Only that: the file must still
        # be the recorded version, so a hand edit is never overwritten.
        blocked = {}
        for dest, rec in planned.items():
            target = POOL_DIR / dest
            if target.is_file() and sha256_file(target) != rec["digest"]:
                kept = kept_consumers.get(dest)
                was = (ledger_assets.get(dest) or {}).get("digest")
                if dest in versions and was and sha256_file(target) != was and (
                    kept or was != rec["digest"] or dest.startswith("_static/_shared/")
                ):
                    # (A lecture's OWN file, with the version unchanged, is
                    # restored by re-promoting the lecture. A shared file
                    # never is: the edit may be something its other users
                    # were meant to see.)
                    blocked[dest] = "the pool file differs from its recorded digest (edited directly?)"
                elif kept and not (dest in versions and was not in (None, rec["digest"])):
                    blocked[dest] = (
                        "referenced by lectures outside this batch: "
                        + ", ".join(sorted(kept))
                    )
                elif dest not in ledger_assets:
                    blocked[dest] = "not recorded in the ledger"
        for plan in ok:
            hits = sorted(
                {dest_map[(r[2], r[3])] for r in plan.refs if dest_map[(r[2], r[3])] in blocked}
            )
            if hits:
                plan.error = (
                    "pool asset(s) exist with different bytes and may not be "
                    "overwritten — reconcile deliberately: "
                    + "; ".join(f"{d} ({blocked[d]})" for d in hits)
                )
        if any(p.error is not None for p in ok):
            ok = [p for p in ok if p.error is None]
            continue

        # Rewrites and pool text (destination-dependent, so inside the loop).
        for plan in ok:
            try:
                build_rewrites(plan, texts[plan.slug], dest_map)
                plan.assets = sorted({dest_map[(r[2], r[3])] for r in plan.refs})
                pool_file = POOL_DIR / f"{plan.slug}.md"
                key = f"lectures/{plan.slug}.md"
                if (
                    pool_file.is_file()
                    and key not in ledger_lectures
                    and pool_file.read_bytes() != plan.pool_text.encode("utf-8")
                ):
                    raise PromoteError(
                        f"lectures/{plan.slug}.md already exists with different "
                        "bytes but has no ledger entry — refusing to overwrite an "
                        "unrecorded pool file"
                    )
            except PromoteError as exc:
                plan.error = str(exc)
        if any(p.error is not None for p in ok):
            ok = [p for p in ok if p.error is None]
            continue

        # A lecture pulled in for a move that is no longer happening (the
        # lecture that needed it was refused later) goes back out, unwritten:
        # a failed promotion re-promotes nothing nobody asked for.
        alive = {p.slug for p in ok}
        orphans = [p for p in ok if p.slug in pulled and pulled[p.slug][0] not in alive]
        if orphans:
            for plan in orphans:
                del pulled[plan.slug]
                plans.remove(plan)
            ok = [p for p in ok if p not in orphans]
            continue

        break  # a full pass with no culls: the plan set is stable

    def asset_provenance(dest):
        """The record of a pool asset: where its bytes come from, and every
        copy the drift-check should watch.

        Its sources are the copies in the series its user lectures come from
        (each user's canonical series and the series recorded as holding the
        same lecture), never a series that merely has a file of that name,
        and never a consumer. A copy with the pool's bytes is recorded plain.
        A copy that has fallen behind the pool's version is recorded with
        its own ``digest`` and a ``stale_since`` time (``asset_version``),
        and one that was never the pool's version with its ``digest`` and
        ``differs: true``, so neither is dropped silently and the
        drift-check reports both. The asset's
        canonical is the highest-priority series that is canonical for one
        of its users and holds the pool's bytes."""
        rec = planned[dest]
        # The record may be under another pool path than ``dest``: the asset
        # is moving in this run, and its history moves with it.
        origin = record_of.get(dest, dest)
        version = versions.get(origin)
        users = [p for p in ok if dest in p.assets]
        kept = [e for e in kept_entries.values() if dest in (e.get("assets") or [])]
        series_of_users = users_series(kept) | {x for p in users for x in [p.canonical, *p.sources]}
        # A series this run leaves out was not read. It stays a user series
        # if the ledger has it as one: canonical for, or a recorded source
        # of, a lecture that used the asset.
        left_out_users = set()
        for entry in ledger_lectures.values():
            if origin in (entry.get("assets") or []):
                left_out_users.add(entry.get("canonical"))
                left_out_users |= {i.get("series") for i in entry.get("sources") or []}
        homes = {p.canonical for p in users} | {e.get("canonical") for e in kept}
        sources = []
        for series in eligible:
            if series not in series_of_users:
                continue
            paths = [version["copies"][series]] if version and series in version["copies"] else sorted(rec["src_rels"])
            for src_rel in paths:
                f = mirror_lectures(series) / src_rel
                if not f.is_file():
                    continue
                digest = sha256_file(f)
                if digest == rec["digest"]:
                    sources.append({"series": series, "path": src_rel})
                elif version and series in version["stale"]:
                    sources.append({
                        "series": series,
                        "path": src_rel,
                        "digest": digest,
                        "stale_since": version["stale"][series],
                    })
                else:
                    # Never the pool's version: a different file under the
                    # same name, recorded so that it is never mistaken for
                    # this asset and the drift-check can say so.
                    sources.append({"series": series, "path": src_rel, "digest": digest, "differs": True})
        # A series this run leaves out keeps its recorded item, stale or not:
        # dropping it would stop the drift-check watching the copy and make
        # it a never-recorded one at the next full run. Its copy was not
        # read. If the pool's version changes in this run, an item recorded
        # as current is no longer known to be: it is recorded as stale at the
        # version it was last seen at, so the next full run judges it (still
        # there, caught up, or forked) and it can never be taken for a holder
        # of the new version.
        for item in (ledger_assets.get(origin) or {}).get("sources") or []:
            if item.get("series") in not_considered and item.get("series") in left_out_users:
                item = dict(item)
                if "digest" not in item and version and version.get("was") not in (None, rec["digest"]):
                    item["digest"] = version["was"]
                    item["stale_since"] = version["since"]
                sources.append(item)
        sources.sort(key=lambda item: order.index(item["series"]))
        current = [x for x in sources if "digest" not in x]
        canonical = next((x for x in current if x["series"] in homes), current[0])
        return {
            "canonical": canonical["series"],
            "digest": rec["digest"],
            "sources": sources,
        }

    new_lectures = dict(ledger_lectures)
    new_assets = dict(ledger_assets)
    for plan in ok:
        pin_series = set(plan.sources) | set(plan.divergent) | set(plan.superseded)
        promoted_at = {
            s: (state.get(s) or {}).get("sha") or ""
            for s in order
            if s in pin_series
        }
        new_lectures[f"lectures/{plan.slug}.md"] = ordered_entry(
            canonical=plan.canonical,
            interim=bool(plan.divergent),
            sources=[
                {"series": s, "path": f"{plan.slug}.md", "digest": plan.digests[s]}
                for s in plan.sources
            ],
            divergent=[
                {"series": s, "path": f"{plan.slug}.md", "digest": plan.digests[s]}
                for s in order
                if s in plan.divergent
            ],
            superseded=[
                {"series": s, "path": f"{plan.slug}.md", "digest": plan.digests[s]}
                for s in order
                if s in plan.superseded
            ],
            promoted_at=promoted_at,
            assets=plan.assets,
            rewrites=[{"from": f, "to": t} for f, t in plan.rewrites],
        )
        for dest in plan.assets:
            new_assets[dest] = asset_provenance(dest)

    # Prune assets no longer referenced by any ledger entry (a re-promotion
    # may have moved them), so the pool never accretes dead weight.
    referenced = set()
    for entry in new_lectures.values():
        referenced.update(entry.get("assets") or [])
    stale = [k for k in new_assets if k not in referenced]
    for k in stale:
        del new_assets[k]

    # ------------------------------------------------------------------ #
    # Phase 5 — report the plan; write unless --dry-run.                  #
    # ------------------------------------------------------------------ #
    for slug, reason in skips:
        print(f"[{slug}] SKIP: {reason}")
    for line in retire_notes:
        print(line)
    for slug in sorted(declined):
        print(
            f"[{slug}] WARN: not re-promoted with the lecture that stopped using a file they shared "
            f"({declined[slug]}); the file's record is rewritten when {slug} next refreshes"
        )
    for slug in sorted(pulled):
        if any(p.slug == slug for p in plans):
            print(f"[{slug}] PULLED IN: it shares {pulled[slug][1]} with {pulled[slug][0]}, and lectures that share a file are promoted together")
    for dest in sorted(planned):
        version = versions.get(record_of.get(dest, dest))
        if version and version["stale"]:
            print(
                f"[{dest}] STALE: {', '.join(version['stale'])} "
                + ("holds" if len(version["stale"]) == 1 else "hold")
                + f" a version that is not the pool's; the pool takes {version['series']}'s"
            )
    for plan in plans:
        for warning in plan.warnings:
            print(f"[{plan.slug}] WARN: {warning}")
        if plan.error is not None:
            sys.stderr.write(f"[{plan.slug}] FAILED: {plan.error}\n")

    unchanged = []  # ok plans whose pool text was already byte-identical
    if args.dry_run:
        for plan in ok:
            line = f"[{plan.slug}] plan: canonical={plan.canonical} sources={plan.sources}"
            if plan.stale:
                line += f" stale={plan.stale}"
            if plan.divergent:
                line += f" divergent={plan.divergent} (interim)"
            if plan.superseded:
                line += f" superseded={plan.superseded}"
            print(line)
            for _, _, src_rel, digest in sorted(set(plan.refs), key=lambda r: (r[2], r[0], r[1])):
                dest = dest_map[(src_rel, digest)]
                cons = sorted(consumers[(src_rel, digest)])
                note = f"  [consumers: {', '.join(cons)}]" if len(cons) > 1 else ""
                print(f"[{plan.slug}]   asset: {src_rel} -> {dest}{note}")
            for frm, to in plan.rewrites:
                print(f"[{plan.slug}]   rewrite: {frm!r} -> {to!r}")
        for slug in retired:
            print(f"[{slug}] would retire: lectures/{slug}.md and its ledger entry")
        for k in stale:
            print(f"[ledger] would prune stale asset: {k}")
    else:
        written_assets = set()
        for plan in ok:
            pool_file = POOL_DIR / f"{plan.slug}.md"
            changed = (
                not pool_file.is_file()
                or pool_file.read_bytes() != plan.pool_text.encode("utf-8")
            )
            if changed:
                atomic_write(pool_file, plan.pool_text.encode("utf-8"))
            else:
                unchanged.append(plan.slug)
            for dest in plan.assets:
                if dest in written_assets:
                    continue
                written_assets.add(dest)
                target = POOL_DIR / dest
                rec = planned[dest]
                if not target.is_file() or sha256_file(target) != rec["digest"]:
                    target.parent.mkdir(parents=True, exist_ok=True)
                    tmp = tmp_sibling(target)
                    try:
                        shutil.copyfile(rec["path"], tmp)
                        os.replace(tmp, target)
                    finally:
                        tmp.unlink(missing_ok=True)
            state_word = "promoted" if changed else "unchanged"
            print(
                f"[{plan.slug}] {state_word} -> lectures/{plan.slug}.md "
                f"(canonical {plan.canonical}, {len(plan.assets)} assets, "
                f"{len(plan.rewrites)} rewrites"
                + (f", stale: {', '.join(plan.stale)} at an earlier promoted version" if plan.stale else "")
                + (", interim: canonical map over differing copies" if plan.divergent else "")
                + ")"
            )
        # The ledger is written BEFORE stale assets are unlinked: a crash in
        # between leaves orphaned pool files (loudly refused if ever
        # recontested) rather than a ledger referencing files that no longer
        # exist. Pool writes above precede the ledger for the same reason.
        # A retired lecture's file goes BEFORE the ledger, the other way
        # round: if the run dies in between, the ledger still names a file
        # the pool lacks, which the drift-check reports (pool-missing) and a
        # second `--retire` finishes; an unrecorded pool lecture would be
        # seen by no check.
        for slug in retired:
            target = POOL_DIR / f"{slug}.md"
            # On a case-insensitive file system a surviving entry whose name
            # differs only in case is the SAME file: leave it.
            twins = [
                REPO_ROOT / k for k in new_lectures
                if k.lower() == f"lectures/{slug}.md".lower()
            ]
            if not any(t.exists() and target.exists() and os.path.samefile(t, target) for t in twins):
                target.unlink(missing_ok=True)
                parent = target.parent
                while parent != POOL_DIR and not any(parent.iterdir()):
                    parent.rmdir()
                    parent = parent.parent
            print(f"[{slug}] retired: lectures/{slug}.md and its ledger entry removed")
        if ok or stale or retired:
            body = dump_ledger(new_lectures, new_assets)
            if not LEDGER_PATH.exists() or LEDGER_PATH.read_bytes() != body.encode("utf-8"):
                atomic_write(LEDGER_PATH, body.encode("utf-8"))
        for k in stale:
            target = POOL_DIR / k
            if target.is_file():
                target.unlink()
                parent = target.parent
                while parent != POOL_DIR and not any(parent.iterdir()):
                    parent.rmdir()
                    parent = parent.parent
            print(f"[ledger] pruned stale asset: {k}")

    # ----------------------------------------------------------------------- #
    # Summary                                                                  #
    # ----------------------------------------------------------------------- #
    failed = [p.slug for p in plans if p.error is not None]
    promoted = [p.slug for p in ok]

    print("\n" + "─" * 60)
    mode = (
        "refresh"
        if args.refresh
        else (f"toc {args.toc}" if args.toc else ("retire" if args.retire else "promote"))
    )
    if args.dry_run:
        mode += ", dry-run"
    print(
        f"summary [{mode}]: {len(promoted) - len(unchanged)} promoted, "
        f"{len(unchanged)} unchanged, {len(skips)} skipped, {len(failed)} failed"
        + (f", {len(retired)} retired" if retired else "")
    )
    if promoted:
        print("  PASS: " + ", ".join(promoted))
    if skips:
        print("  SKIP: " + ", ".join(s for s, _ in skips))
    also = sorted(x for x in pulled if any(p.slug == x for p in plans))
    if also:
        print("  PULLED IN: " + ", ".join(also))
    if retired:
        print("  RETIRED: " + ", ".join(retired))
    if failed:
        print("  FAIL: " + ", ".join(failed))
    print("─" * 60)

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
