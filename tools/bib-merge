import bibtexparser
import yaml

ROOT = Path(__file__).resolve().parent.parent
SYNC_DIR = ROOT / "sync"
RULINGS_PATH = SYNC_DIR / "bib.yml"
MANIFEST_PATH = SYNC_DIR / "manifest.yml"
MIRROR_DIR = ROOT / "mirror"
POOL_DIR = ROOT / "lectures"
BIB_BASENAME = "quant-econ.bib"
POOL_BIB = POOL_DIR / "_static" / BIB_BASENAME

# Fields the house style drops (rules 8 and 10).
DROP_FIELDS = {"month", "abstract", "keywords", "file", "date-added", "date-modified", "issn"}

# The order fields are written in; any other field follows, alphabetically.
FIELD_ORDER = [
    "author", "editor", "title", "booktitle", "journal", "series", "edition",
    "volume", "number", "pages", "chapter", "publisher", "institution",
    "school", "organization", "address", "howpublished", "type", "year",
    "note", "doi", "url",
]
KNOWN_FIELDS = set(FIELD_ORDER) | {"isbn", "eprint", "archiveprefix", "primaryclass", "urldate", "language"}

# Rule 2: the fields each entry type needs. ERRORS are what the build or the
# reader depends on; the INFO pairs are reported only.
REQUIRED = {
    "article": ("journal",),
    "book": ("publisher",),
    "incollection": ("booktitle", "publisher"),
    "techreport": ("institution",),
}
REQUIRED_INFO = {"techreport": ("number",), "misc": ("url",)}

NUMBER_RE = re.compile(r"[0-9]+")
MACRO_RE = re.compile(r"[^\s\"#%'(),={}0-9][^\s\"#%'(),={}]*")
PAGES_DASH_RE = re.compile(r"(?<=\S)\s*(?:-{1,3}|[\u2013\u2014])\s*(?=\S)")
DOI_URL_RE = re.compile(r"^(?:https?://(?:dx\.)?doi\.org/|doi:\s*)", re.IGNORECASE)
# An accented or special letter written as LaTeX (\'e, \"{a}, \v{c}, \H{o}, \o,
# \ss), not a formatting command such as \emph or \textit.
LATEX_ESCAPE_RE = re.compile(
    r"\\[`'^\"~=.]"
    r"|\\[uvHtcdbk](?:\{|\s+[A-Za-z])"
    r"|\\(?:o|O|l|L|i|j|ss|ae|AE|oe|OE|aa|AA)(?![A-Za-z])"
)
# {cite}`a,b`, {cite:t}`a`, {footcite:p}`a` …
CITE_RE = re.compile(r"\{(?:foot)?cite(?::[a-z]+)?\}`([^`]+)`")

HEADER = (
    "% generated by tools/bib-merge — do not hand-edit\n"
    "% The merged bibliography of the lecture series: every entry of each series'\n"
    "% own lectures/_static/quant-econ.bib, normalised to the house style, with\n"
    "% conflicts settled by the rulings in sync/bib.yml.\n"
)
INPUTS_PREFIX = "% inputs: "


class Refused(Exception):
    """A file this tool cannot read exactly. Stops the run."""


class ConfigError(Exception):
    """sync/bib.yml or sync/manifest.yml is malformed. Stops the run."""


# --------------------------------------------------------------------------- #
# Reading and normalising                                                      #
# --------------------------------------------------------------------------- #
def _match_brace(s: str) -> int:
    depth = 0
    for i, c in enumerate(s):
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i
    return -1


def _match_quote(s: str) -> int:
    depth = 0
    for i, c in enumerate(s[1:], 1):
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
        elif c == '"' and depth == 0:
            return i
    return -1


def raw_content(where: str, field: str, raw: str):
    """The text of one field value, or None for a bare month macro.

    bibtexparser is used only to split the file into blocks (``parse_stack=[]``
    keeps each value's exact source text, delimiters included), so what a value
    means is decided here and nothing is interpolated behind our back.
    """
    raw = raw.strip()
    if raw.startswith("{") and _match_brace(raw) == len(raw) - 1:
        return raw[1:-1]
    if raw.startswith('"') and _match_quote(raw) == len(raw) - 1:
        return raw[1:-1]
    if NUMBER_RE.fullmatch(raw):
        return raw
    if MACRO_RE.fullmatch(raw):
        if field == "month":
            return None
        raise Refused(f"{where}: field `{field}` is the bare macro {raw!r}; the house style uses no @string macros")
    raise Refused(f"{where}: field `{field}` is a concatenation or cannot be read: {raw[:60]!r}")


def normalise_value(field: str, value: str) -> str:
    value = re.sub(r"\s+", " ", value).strip()
    if field == "pages":
        value = PAGES_DASH_RE.sub("--", value)
    elif field == "doi":
        value = DOI_URL_RE.sub("", value).strip()
    return value


def read_bib(series: str, path: Path) -> dict:
    """{key: (entry_type, {field: value})} for one series, normalised."""
    lib = bibtexparser.parse_file(str(path), parse_stack=[])
    if lib.failed_blocks:
        problems = "; ".join(
            f"{type(b).__name__} at line {b.start_line + 1}: {str(b.error).strip() or 'a syntax error'}"
            for b in lib.failed_blocks
        )
        raise Refused(f"{series}: {path.relative_to(ROOT)} cannot be read exactly: {problems}")
    if lib.strings or lib.preambles:
        raise Refused(f"{series}: {path.relative_to(ROOT)} has @string or @preamble, which the house style does not use")
    out = {}
    for entry in lib.entries:
        where = f"{series}:{entry.key}"
        fields = {}
        for f in entry.fields:
            name = f.key.lower()
            if name in DROP_FIELDS:
                continue
            value = raw_content(where, name, f.value)
            if value is None:
                continue
            value = normalise_value(name, value)
            if value:
                fields[name] = value
        out[entry.key] = (entry.entry_type.lower(), fields)
    return out


def digest(entry) -> str:
    etype, fields = entry
    payload = json.dumps([etype, sorted(fields.items())], ensure_ascii=False, separators=(",", ":"))
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]


def file_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()[:16]


# --------------------------------------------------------------------------- #
# Configuration                                                                #
# --------------------------------------------------------------------------- #
RULING_KEYS = {"take", "set", "drop", "type", "because", "seal"}


def load_rulings(path: Path = RULINGS_PATH):
    """(series list, {key: ruling}) from sync/bib.yml, validated."""
    if not path.exists():
        raise ConfigError(f"{path.relative_to(ROOT)} is missing")
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    series = data.get("series")
    if not isinstance(series, list) or not series or not all(isinstance(s, str) for s in series):
        raise ConfigError("sync/bib.yml: `series` must be a non-empty list of series keys")
    rulings = data.get("rulings") or {}
    if not isinstance(rulings, dict):
        raise ConfigError("sync/bib.yml: `rulings` must be a mapping of key to ruling")
    for key, r in rulings.items():
        where = f"sync/bib.yml: ruling `{key}`"
        if not isinstance(r, dict):
            raise ConfigError(f"{where} must be a mapping")
        unknown = set(r) - RULING_KEYS
        if unknown:
            raise ConfigError(f"{where} has unknown fields: {', '.join(sorted(unknown))}")
        for required in ("take", "because", "seal"):
            if required not in r:
                raise ConfigError(f"{where} needs `{required}`")
        if r["take"] not in series:
            raise ConfigError(f"{where} takes `{r['take']}`, which is not in `series`")
        if not isinstance(r["seal"], dict) or not r["seal"]:
            raise ConfigError(f"{where}: `seal` must map each series to its copy's digest")
        for s, d in r["seal"].items():
            if s not in series or not isinstance(d, str) or not re.fullmatch(r"[0-9a-f]{16}", d):
                raise ConfigError(f"{where}: seal entry {s}: {d!r} is not a known series with a 16-hex digest")
        if not isinstance(r.get("set", {}), dict) or not all(isinstance(v, str) for v in r.get("set", {}).values()):
            raise ConfigError(f"{where}: `set` must map field names to string values")
        if not isinstance(r.get("drop", []), list):
            raise ConfigError(f"{where}: `drop` must be a list of field names")
        if "type" in r and not isinstance(r["type"], str):
            raise ConfigError(f"{where}: `type` must be an entry type")
    return series, rulings


def manifest_series():
    data = yaml.safe_load(MANIFEST_PATH.read_text(encoding="utf-8")) or {}
    return list((data.get("series") or {}).keys())


def series_bib(series: str) -> Path:
    return MIRROR_DIR / series / "lectures" / "_static" / BIB_BASENAME


# --------------------------------------------------------------------------- #
# Merging                                                                      #
# --------------------------------------------------------------------------- #
def apply_ruling(base, ruling):
    etype, fields = base
    fields = dict(fields)
    for name in ruling.get("drop", []):
        fields.pop(name.lower(), None)
    for name, value in ruling.get("set", {}).items():
        name = name.lower()
        value = normalise_value(name, value)
        if value:
            fields[name] = value
        else:
            fields.pop(name, None)
    return (ruling.get("type", etype).lower(), fields)


class Merge:
    """The merged entries of one run, and everything found on the way."""

    def __init__(self, series, rulings, copies, committed):
        self.series = series
        self.rulings = rulings
        self.copies = copies              # {key: {series: entry}}
        self.entries = {}                 # {key: entry}
        self.refused = {}                 # {key: reason}
        self.carried = set()              # refused keys kept from the committed file
        self.info = []                    # (kind, message)
        self._merge(committed)

    def conflicts(self):
        return sorted(k for k, held in self.copies.items() if len({digest(e) for e in held.values()}) > 1)

    def _merge(self, committed):
        for key in sorted(self.copies, key=lambda k: (k.lower(), k)):
            held = self.copies[key]
            ruling = self.rulings.get(key)
            if ruling is None:
                if len({digest(e) for e in held.values()}) == 1:
                    self.entries[key] = next(iter(held.values()))
                    continue
                self._refuse(key, f"held by {', '.join(held)} with differing copies and no ruling in sync/bib.yml (run --propose)", committed)
                continue
            take = ruling["take"]
            if take not in held:
                self._refuse(key, f"its ruling takes `{take}`, which no longer holds it (held by {', '.join(held) or 'none'})", committed)
                continue
            result = apply_ruling(held[take], ruling)
            reopened = [s for s, e in held.items() if ruling["seal"].get(s) != digest(e) and e != result]
            if reopened:
                self._refuse(key, f"reopened: the copy in {', '.join(reopened)} changed since the ruling (re-seal it with --propose)", committed)
                continue
            if len({digest(e) for e in held.values()}) == 1 and not ruling.get("set") and not ruling.get("drop") and "type" not in ruling:
                self.info.append(("ruling-unneeded", f"{key}: every copy now agrees; its ruling can be removed"))
            self.entries[key] = result
        for key in sorted(set(self.rulings) - set(self.copies)):
            self.info.append(("ruling-orphaned", f"{key}: no series holds it any more; its ruling can be removed"))

    def _refuse(self, key, reason, committed):
        self.refused[key] = reason
        if key in committed:
            self.entries[key] = committed[key]
            self.carried.add(key)


def collect_copies(series):
    copies, inputs = {}, {}
    for s in series:
        path = series_bib(s)
        if not path.exists():
            raise Refused(f"{s}: {path.relative_to(ROOT)} is missing (run tools/sync {s}, or pass --reconstruct)")
        inputs[s] = file_digest(path)
        for key, entry in read_bib(s, path).items():
            copies.setdefault(key, {})[s] = entry
    return copies, inputs


def read_committed():
    """(entries, recorded input digests) of the committed pool file."""
    if not POOL_BIB.exists():
        return {}, None
    text = POOL_BIB.read_text(encoding="utf-8")
    recorded = None
    for line in text.splitlines():
        if line.startswith(INPUTS_PREFIX):
            recorded = dict(p.split("=", 1) for p in line[len(INPUTS_PREFIX):].split())
            break
    try:
        entries = read_bib("pool", POOL_BIB)
    except Refused:
        entries = {}
    return entries, recorded


# --------------------------------------------------------------------------- #
# Writing                                                                      #
# --------------------------------------------------------------------------- #
def ordered_fields(fields):
    known = [f for f in FIELD_ORDER if f in fields]
    rest = sorted(f for f in fields if f not in FIELD_ORDER)
    return known + rest


def render(entries, inputs) -> str:
    out = [HEADER, INPUTS_PREFIX + " ".join(f"{s}={inputs[s]}" for s in sorted(inputs)) + "\n"]
    for key in sorted(entries, key=lambda k: (k.lower(), k)):
        etype, fields = entries[key]
        names = ordered_fields(fields)
        width = max((len(n) for n in names), default=0)
        body = ",\n".join(f"  {n:<{width}} = {{{fields[n]}}}" for n in names)
        out.append("\n" + (f"@{etype}{{{key},\n{body}\n}}\n" if names else f"@{etype}{{{key},\n}}\n"))
    return "".join(out)


# --------------------------------------------------------------------------- #
# Checks                                                                       #
# --------------------------------------------------------------------------- #
def split_top(text: str, sep: str):
    """Split on ``sep`` at brace depth 0."""
    parts, depth, cur, i = [], 0, [], 0
    while i < len(text):
        c = text[i]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
        if depth == 0 and text.startswith(sep, i):
            parts.append("".join(cur))
            cur = []
            i += len(sep)
            continue
        cur.append(c)
        i += 1
    parts.append("".join(cur))
    return parts


def top_level(text: str) -> str:
    """The characters of ``text`` outside any brace group."""
    out, depth = [], 0
    for c in text:
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
        elif depth == 0:
            out.append(c)
    return "".join(out)


def style_findings(entries):
    """(errors, infos): the house-style rules the normalising cannot apply."""
    errors, infos = [], []
    for key, (etype, fields) in entries.items():
        for need in REQUIRED.get(etype, ()):
            if need not in fields:
                errors.append(f"{key}: @{etype} needs `{need}` (rule 2)")
        for need in REQUIRED_INFO.get(etype, ()):
            if need not in fields:
                infos.append(("style-field", f"{key}: @{etype} has no `{need}` (rule 2)"))
        for role in ("author", "editor"):
            if role not in fields:
                continue
            for name in split_top(fields[role], " and "):
                bare = name.strip()
                outside = top_level(bare.replace("\\&", ""))
                if "&" in outside or ";" in outside:
                    errors.append(f"{key}: {role} `{bare}` joins names with `&` or `;`, not `and` (rule 3)")
                    break
                if len(split_top(bare, ",")) > 3:
                    errors.append(f"{key}: {role} `{bare}` separates names with commas, not `and` (rule 3)")
                    break
        for name in sorted(set(fields) - KNOWN_FIELDS):
            infos.append(("style-field", f"{key}: unknown field `{name}`"))
        if any(LATEX_ESCAPE_RE.search(v) for v in fields.values()):
            infos.append(("latex-escape", f"{key}: LaTeX escape for an accented character (rule 11: type it directly)"))
    seen = {}
    for key in sorted(entries):
        other = seen.setdefault(key.lower(), key)
        if other != key:
            errors.append(f"{key}: equal to `{other}` when case is ignored (rule 12)")
    return errors, infos


def cited_keys(directory: Path):
    keys = {}
    for md in sorted(directory.glob("*.md")):
        for m in CITE_RE.finditer(md.read_text(encoding="utf-8", errors="replace")):
            for k in m.group(1).split(","):
                k = k.strip()
                if k:
                    keys.setdefault(k, set()).add(md.name)
    return keys


def closure_findings(entries):
    """(errors, infos): pool citations that do not resolve; keys cited nowhere."""
    errors, infos = [], []
    lower = {k.lower(): k for k in entries}
    for key, files in sorted(cited_keys(POOL_DIR).items()):
        if key in entries:
            continue
        hint = f" (the file has `{lower[key.lower()]}`)" if key.lower() in lower else ""
        errors.append(f"{key}: cited by {', '.join(sorted(files))} but not in the merged file{hint}")
    cited = set()
    for s in manifest_series():
        d = MIRROR_DIR / s / "lectures"
        if d.is_dir():
            cited |= set(cited_keys(d))
    cited |= set(cited_keys(POOL_DIR))
    unused = sorted(set(entries) - cited, key=str.lower)
    if unused:
        infos.append(("unused", f"{len(unused)} keys are cited by no lecture of any series reconstructed in mirror/: {', '.join(unused)}"))
    return errors, infos


def _pybtex_view(entry):
    """(type, {field: value}, {role: [person]}) as pybtex reads an entry."""
    fields = {f.lower(): re.sub(r"\s+", " ", v).strip() for f, v in entry.fields.items()}
    persons = {r.lower(): [str(p) for p in ps] for r, ps in entry.persons.items()}
    return entry.type.lower(), fields, persons


def equivalence_findings(text, merge):
    """Errors where pybtex reads a merged entry differently from its source."""
    from pybtex.database import parse_file, parse_string

    try:
        merged = parse_string(text, "bibtex").entries
        sources = {s: parse_file(str(series_bib(s)), "bibtex").entries for s in merge.series}
    except Exception as exc:  # pybtex refuses, e.g., two keys equal when case is ignored
        return [f"pybtex cannot read the merged file or a series' file: {exc}"]
    errors = []
    for key in sorted(merge.entries, key=str.lower):
        if key in merge.carried:
            continue
        ruling = merge.rulings.get(key)
        held = merge.copies[key]
        series = ruling["take"] if ruling else next(s for s in merge.series if s in held)
        etype, fields, persons = _pybtex_view(sources[series][key])
        fields = {f: normalise_value(f, v) for f, v in fields.items() if f not in DROP_FIELDS}
        fields = {f: v for f, v in fields.items() if v}
        if ruling:
            etype = ruling.get("type", etype).lower()
            for name in ruling.get("drop", []):
                fields.pop(name.lower(), None)
                persons.pop(name.lower(), None)
            for name, value in ruling.get("set", {}).items():
                name = name.lower()
                if name in ("author", "editor"):
                    one = parse_string(f"@misc{{x, {name} = {{{value}}}}}", "bibtex").entries["x"]
                    persons[name] = [str(p) for p in one.persons[name]]
                else:
                    fields[name] = normalise_value(name, value)
        got = _pybtex_view(merged[key])
        if got != (etype, fields, persons):
            diff = [f for f in sorted(set(fields) | set(got[1])) if fields.get(f) != got[1].get(f)]
            diff += [r for r in sorted(set(persons) | set(got[2])) if persons.get(r) != got[2].get(r)]
            if got[0] != etype:
                diff.insert(0, "(type)")
            errors.append(f"{key}: pybtex reads the merged entry differently from {series}'s copy in {', '.join(diff)}")
    return errors


# --------------------------------------------------------------------------- #
# Report and proposals                                                         #
# --------------------------------------------------------------------------- #
def report(merge) -> str:
    keys = merge.conflicts()
    lines = [
        f"## Bibliography conflicts ({len(keys)})",
        "",
        "Fields that agree in every copy are left out; \"—\" means the field is absent and \"·\" that the series does not hold the key.",
        "",
    ]
    for key in keys:
        held = merge.copies[key]
        status = "refused: " + merge.refused[key] if key in merge.refused else f"ruled: takes {merge.rulings[key]['take']}"
        lines += [f"### `{key}`: {status}", "", "| field | " + " | ".join(merge.series) + " | result |", "|---" * (len(merge.series) + 2) + "|"]
        result = merge.entries.get(key)
        names = sorted({f for _, fs in held.values() for f in fs} | set(result[1] if result else ()))
        rows = [("(type)", lambda e: e[0])] + [(n, lambda e, n=n: e[1].get(n, "—")) for n in names]
        for label, get in rows:
            values = [get(held[s]) if s in held else "·" for s in merge.series]
            if len({v for v in values if v != "·"}) <= 1 and (result is None or get(result) in values):
                continue
            res = get(result) if result else "·"
            cells = [f"`{v}`" if v not in ("·", "—") else v for v in values + [res]]
            lines.append(f"| {label} | " + " | ".join(c.replace("|", "\\|") for c in cells) + " |")
        lines.append("")
    return "\n".join(lines)


def propose(merge) -> str:
    out = []
    for key in sorted(merge.refused, key=str.lower):
        held = merge.copies.get(key)
        if not held:
            continue
        take, why = proposal(held, merge.series)
        out.append(f"  {key}:")
        out.append(f"    take: {take}    # {why}")
        out.append("    because: TODO")
        out.append("    seal:")
        for s in merge.series:
            if s in held:
                out.append(f"      {s}: {digest(held[s])}")
    return "\n".join(out) + ("\n" if out else "")


def proposal(held, order):
    """A starting point for a ruling: the copy that holds every other copy."""
    items = [(s, held[s]) for s in order if s in held]
    for s, (etype, fields) in items:
        if all(e[0] == etype and all(fields.get(k) == v for k, v in e[1].items()) for _, e in items):
            return s, "its fields include every other copy's (one copy has more fields)"
    return items[0][0], "PICK: no copy contains the others"


