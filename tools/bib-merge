def reconstruct(series_list):
    sync = ROOT / "tools" / "sync"
    cmd = ["uv", "run", "--quiet", "--script", str(sync), *series_list] if shutil.which("uv") else [str(sync), *series_list]
    print("reconstructing mirror/ for:", " ".join(series_list))
    if subprocess.call(cmd, cwd=str(ROOT)) != 0:
        raise Refused("tools/sync failed")


def github_output(**values):
    path = os.environ.get("GITHUB_OUTPUT")
    if path:
        with open(path, "a", encoding="utf-8") as fh:
            for k, v in values.items():
                fh.write(f"{k}={v}\n")


def main(argv=None):
    p = argparse.ArgumentParser(prog="tools/bib-merge", description=__doc__.split("\n\n")[0])
    p.add_argument("--write", action="store_true", help="write lectures/_static/quant-econ.bib")
    p.add_argument("--report", nargs="?", const="-", metavar="PATH", help="write the conflict report (markdown) to PATH, or stdout")
    p.add_argument("--propose", action="store_true", help="print sync/bib.yml stubs for every refused key")
    p.add_argument("--reconstruct", action="store_true", help="rebuild mirror/ for every manifest series first")
    args = p.parse_args(argv)

    try:
        series, rulings = load_rulings()
        if args.reconstruct:
            reconstruct(manifest_series())
        missing = [s for s in series if s not in manifest_series()]
        if missing:
            raise ConfigError(f"sync/bib.yml: series {', '.join(missing)} are not in sync/manifest.yml")
        copies, inputs = collect_copies(series)
    except (Refused, ConfigError) as exc:
        print(f"bib-merge: {exc}", file=sys.stderr)
        github_output(bib_state="error", bib_failed="true", bib_refresh="false")
        return 2

    committed, recorded = read_committed()
    merge = Merge(series, rulings, copies, committed)
    text = render(merge.entries, inputs)

    unlisted = [s for s in manifest_series() if s not in series and series_bib(s).exists()]
    for s in unlisted:
        merge.info.append(("series-unlisted", f"{s} has a {BIB_BASENAME} but is not in sync/bib.yml's `series`"))

    style_errors, style_infos = style_findings(merge.entries)
    closure_errors, closure_infos = closure_findings(merge.entries)
    equivalence_errors = equivalence_findings(text, merge)
    merge.info += style_infos + closure_infos

    if args.report:
        body = report(merge)
        if args.report == "-":
            print(body)
        else:
            Path(args.report).write_text(body, encoding="utf-8")
    if args.propose:
        print(propose(merge), end="")

    current = POOL_BIB.read_text(encoding="utf-8") if POOL_BIB.exists() else None
    if args.write:
        if current != text:
            POOL_BIB.parent.mkdir(parents=True, exist_ok=True)
            with open(POOL_BIB, "w", encoding="utf-8", newline="\n") as fh:
                fh.write(text)
            print(f"wrote {POOL_BIB.relative_to(ROOT)} ({len(merge.entries)} entries)")
        state = "clean"
    elif current == text:
        state = "clean"
    elif current is None:
        state = "missing"
    elif recorded is not None and recorded != inputs:
        state = "refresh"
    else:
        state = "violation"

    print(f"keys {len(merge.copies)} · held by two or more series {sum(1 for h in merge.copies.values() if len(h) > 1)} · "
          f"conflicts {len(merge.conflicts())} · rulings {len(rulings)} · merged {len(merge.entries)}")
    for key, reason in sorted(merge.refused.items(), key=lambda kv: kv[0].lower()):
        kept = " (the committed entry is kept)" if key in merge.carried else ""
        print(f"[refused] {key}: {reason}{kept}")
    for e in style_errors:
        print(f"[style] {e}")
    for e in closure_errors:
        print(f"[closure] {e}")
    for e in equivalence_errors:
        print(f"[equivalence] {e}")
    if state == "refresh":
        print(f"[refresh] the series' files moved since {POOL_BIB.relative_to(ROOT)} was generated: run tools/bib-merge --write")
    elif state == "violation":
        print(f"[violation] {POOL_BIB.relative_to(ROOT)} is not what the same inputs generate: "
              "a hand edit, or a ruling or tool change that was not regenerated (run tools/bib-merge --write)")
    elif state == "missing":
        print(f"[violation] {POOL_BIB.relative_to(ROOT)} is missing (run tools/bib-merge --write)")
    for kind, message in merge.info:
        print(f"[info:{kind}] {message}")

    failed = bool(merge.refused or style_errors or closure_errors or equivalence_errors or state in ("violation", "missing"))
    github_output(bib_state=state, bib_failed=str(failed).lower(), bib_refresh=str(state == "refresh").lower())
    if failed:
        return 2
    return 1 if state == "refresh" else 0


if __name__ == "__main__":
    sys.exit(main())
