ROOT = Path(__file__).resolve().parent.parent
SYNC_DIR = ROOT / "sync"
RULINGS_PATH = SYNC_DIR / "bib.yml"
MANIFEST_PATH = SYNC_DIR / "manifest.yml"
MIRROR_DIR = ROOT / "mirror"
POOL_DIR = ROOT / "lectures"
BIB_BASENAME = "quant-econ.bib"
POOL_BIB = POOL_DIR / "_static" / BIB_BASENAME

# Fields the house style drops (rules 8 and 10).
DROP_FIELDS = {"month", "abstract", "keywords", "file", "date-added", "date-modified", "issn"}

# The order fields are written in; any other field follows, alphabetically.
FIELD_ORDER = [
    "author", "editor", "title", "booktitle", "journal", "series", "edition",
    "volume", "number", "pages", "chapter", "publisher", "institution",
    "school", "organization", "address", "howpublished", "type", "year",
    "note", "doi", "url",
]
KNOWN_FIELDS = set(FIELD_ORDER) | {"isbn", "eprint", "archiveprefix", "primaryclass", "urldate", "language"}

# Rule 2: the fields each entry type needs. ERRORS are what the build or the
# reader depends on; the INFO pairs are reported only.
REQUIRED = {
    "article": ("journal",),
    "book": ("publisher",),
    "incollection": ("booktitle", "publisher"),
    "techreport": ("institution",),
}
REQUIRED_INFO = {"techreport": ("number",), "misc": ("url",)}

FIELD_NAME_RE = re.compile(r"[a-z][a-z0-9_-]*")
ENTRY_TYPE_RE = re.compile(r"[a-z]+")
NUMBER_RE = re.compile(r"[0-9]+")
MACRO_RE = re.compile(r"[^\s\"#%'(),={}0-9][^\s\"#%'(),={}]*")
DASHES = "\u2010\u2012\u2013\u2014\u2212"  # hyphen, figure dash, en dash, em dash, minus
PAGE_RANGE_RE = re.compile(rf"([^\s\-{DASHES}]+)\s*(?:-{{1,3}}|[{DASHES}])\s*([^\s\-{DASHES}]+)")
DOI_PREFIX_RE = re.compile(r"^(?:(?:https?://)?(?:www\.)?(?:dx\.)?doi\.org/|doi:\s*)", re.IGNORECASE)
# An accented or special letter written as LaTeX (\'e, \"{a}, \v{c}, \H{o}, \o,
# \ss), not a formatting command such as \emph or \textit.
LATEX_ESCAPE_RE = re.compile(
    r"\\[`'^\"~=.]"
    r"|\\[uvHtcdbk](?:\{|\s+[A-Za-z])"
    r"|\\(?:o|O|l|L|i|j|ss|ae|AE|oe|OE|aa|AA)(?![A-Za-z])"
)
# {cite}`a,b`, {cite:t}`a`, {footcite:p}`a` …
CITE_RE = re.compile(r"\{(?:foot)?cite(?::[a-z]+)?\}`([^`]+)`")

HEADER = (
    "% generated by tools/bib-merge — do not hand-edit\n"
    "% The merged bibliography of the lecture series: every entry of each series'\n"
    "% own lectures/_static/quant-econ.bib, normalised to the house style, with\n"
    "% conflicts settled by the rulings in sync/bib.yml.\n"
)
INPUTS_PREFIX = "% inputs: "
RULINGS_PREFIX = "% rulings: "
BODY_PREFIX = "% body: "


class Refused(Exception):
    """A file this tool cannot read exactly. Stops the run."""


class ConfigError(Exception):
    """sync/bib.yml or sync/manifest.yml is malformed. Stops the run."""


def sha16(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()[:16]


# --------------------------------------------------------------------------- #
# Reading and normalising                                                      #
# --------------------------------------------------------------------------- #
def _match_brace(s: str) -> int:
    depth = 0
    for i, c in enumerate(s):
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i
    return -1


def _match_quote(s: str) -> int:
    depth = 0
    for i, c in enumerate(s[1:], 1):
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth < 0:
                return -1
        elif c == '"' and depth == 0:
            return i
    return -1


def raw_content(where: str, field: str, raw: str):
    """The text of one field value, or None for a bare month macro.

    bibtexparser is used only to split the file into blocks (``parse_stack=[]``
    keeps each value's exact source text, delimiters included), so what a value
    means is decided here and nothing is interpolated behind our back.
    """
    raw = raw.strip()
    if raw.startswith("{") and _match_brace(raw) == len(raw) - 1:
        return raw[1:-1]
    if raw.startswith('"') and _match_quote(raw) == len(raw) - 1:
        return raw[1:-1]
    if NUMBER_RE.fullmatch(raw):
        return raw
    if MACRO_RE.fullmatch(raw):
        if field == "month":
            return None
        raise Refused(f"{where}: field `{field}` is the bare macro {raw!r}; the house style uses no @string macros")
    raise Refused(f"{where}: field `{field}` is a concatenation or cannot be read: {raw[:60]!r}")


def normalise_pages(value: str) -> str:
    parts = [p.strip() for p in value.split(",")]
    out = []
    for part in parts:
        m = PAGE_RANGE_RE.fullmatch(part)
        out.append(f"{m.group(1)}--{m.group(2)}" if m else part)
    return ", ".join(out) if out != parts else value


def normalise_value(field: str, value: str) -> str:
    value = re.sub(r"\s+", " ", value).strip()
    if field == "pages":
        value = normalise_pages(value)
    elif field == "doi":
        value = DOI_PREFIX_RE.sub("", value).strip()
    return value


def parse_bib_text(label: str, text: str) -> dict:
    """{key: (entry_type, {field: value})}, normalised; refuses what it cannot read exactly."""
    lib = bibtexparser.parse_string(text, parse_stack=[])
    if lib.failed_blocks:
        problems = "; ".join(
            f"{type(b).__name__} at line {b.start_line + 1}: {str(b.error).strip() or 'a syntax error'}"
            for b in lib.failed_blocks
        )
        raise Refused(f"{label} cannot be read exactly: {problems}")
    if lib.strings or lib.preambles:
        raise Refused(f"{label} has @string or @preamble, which the house style does not use")
    out = {}
    for entry in lib.entries:
        where = f"{label}:{entry.key}"
        etype = entry.entry_type.lower()
        if not ENTRY_TYPE_RE.fullmatch(etype):
            raise Refused(f"{where}: {entry.entry_type!r} is not an entry type")
        fields, seen = {}, set()
        for f in entry.fields:
            name = f.key.lower()
            if not FIELD_NAME_RE.fullmatch(name):
                raise Refused(f"{where}: {f.key!r} is not a field name (a commented-out line inside an entry?)")
            if name in seen:
                raise Refused(f"{where}: field `{name}` appears twice (case is ignored)")
            seen.add(name)
            if name in DROP_FIELDS:
                continue
            value = raw_content(where, name, f.value)
            if value is None:
                continue
            value = normalise_value(name, value)
            if value:
                fields[name] = value
        out[entry.key] = (etype, fields)
    return out


def pybtex_entries(label: str, text: str):
    from pybtex.database import parse_string

    try:
        return parse_string(text, "bibtex").entries
    except Exception as exc:
        raise Refused(f"{label}: pybtex cannot read it: {exc}") from exc


def read_bib(series: str, path: Path):
    """(entries, pybtex entries) for one series' file, both readers agreeing on its keys."""
    label = f"{series}: {path.relative_to(ROOT)}"
    try:
        text = path.read_bytes().decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused(f"{label} is not UTF-8: {exc}") from exc
    entries = parse_bib_text(series, text)
    pyb = pybtex_entries(label, text)
    ours, theirs = set(entries), set(pyb.keys())
    if ours != theirs:
        only_ours = ", ".join(sorted(ours - theirs)) or "none"
        only_theirs = ", ".join(sorted(theirs - ours)) or "none"
        raise Refused(f"{label}: bibtexparser and pybtex find different keys (only bibtexparser: {only_ours}; "
                      f"only pybtex: {only_theirs}); an @comment that hides an entry?")
    return entries, pyb


def digest(entry) -> str:
    etype, fields = entry
    payload = json.dumps([etype, sorted(fields.items())], ensure_ascii=False, separators=(",", ":"))
    return sha16(payload.encode("utf-8"))


def entries_digest(entries) -> str:
    payload = json.dumps(sorted((k, digest(e)) for k, e in entries.items()), separators=(",", ":"))
    return sha16(payload.encode("utf-8"))


# --------------------------------------------------------------------------- #
# Configuration                                                                #
# --------------------------------------------------------------------------- #
RULING_KEYS = {"take", "set", "drop", "type", "because", "seal"}


def load_rulings(path: Path = RULINGS_PATH):
    """(series list, {key: ruling}, digest of the file) from sync/bib.yml, validated."""
    if not path.exists():
        raise ConfigError(f"{path.relative_to(ROOT)} is missing")
    raw = path.read_bytes()
    try:
        data = yaml.safe_load(raw.decode("utf-8")) or {}
    except (yaml.YAMLError, UnicodeDecodeError) as exc:
        raise ConfigError(f"sync/bib.yml cannot be read: {exc}") from exc
    if not isinstance(data, dict):
        raise ConfigError("sync/bib.yml must be a mapping with `series` and `rulings`")
    series = data.get("series")
    if not isinstance(series, list) or not series or not all(isinstance(s, str) for s in series):
        raise ConfigError("sync/bib.yml: `series` must be a non-empty list of series keys")
    rulings = data.get("rulings") or {}
    if not isinstance(rulings, dict):
        raise ConfigError("sync/bib.yml: `rulings` must be a mapping of key to ruling")
    for key, r in rulings.items():
        where = f"sync/bib.yml: ruling `{key}`"
        if not isinstance(key, str):
            raise ConfigError(f"{where}: the key must be a string (quote it)")
        if not isinstance(r, dict):
            raise ConfigError(f"{where} must be a mapping")
        unknown = set(r) - RULING_KEYS
        if unknown:
            raise ConfigError(f"{where} has unknown fields: {', '.join(sorted(map(str, unknown)))}")
        for required in ("take", "because", "seal"):
            if required not in r:
                raise ConfigError(f"{where} needs `{required}`")
        if r["take"] not in series:
            raise ConfigError(f"{where} takes `{r['take']}`, which is not in `series`")
        because = r["because"]
        if not isinstance(because, str) or not because.strip() or because.strip().upper().startswith("TODO"):
            raise ConfigError(f"{where}: `because` must say why, with its source (not TODO)")
        seal = r["seal"]
        if not isinstance(seal, dict) or not seal:
            raise ConfigError(f"{where}: `seal` must map each series to its copy's digest")
        for s, d in seal.items():
            if s not in series or not isinstance(d, str) or not re.fullmatch(r"[0-9a-f]{16}", d):
                raise ConfigError(f"{where}: seal entry {s}: {d!r} is not a known series with a 16-hex digest (quote it)")
        sets = r.get("set", {})
        if not isinstance(sets, dict) or not all(
            isinstance(k, str) and FIELD_NAME_RE.fullmatch(k.lower()) and isinstance(v, str) for k, v in sets.items()
        ):
            raise ConfigError(f"{where}: `set` must map field names to string values")
        drops = r.get("drop", [])
        if not isinstance(drops, list) or not all(isinstance(d, str) and FIELD_NAME_RE.fullmatch(d.lower()) for d in drops):
            raise ConfigError(f"{where}: `drop` must be a list of field names")
        if "type" in r and not (isinstance(r["type"], str) and ENTRY_TYPE_RE.fullmatch(r["type"].lower())):
            raise ConfigError(f"{where}: `type` must be an entry type")
    return series, rulings, sha16(raw)


def manifest_series():
    data = yaml.safe_load(MANIFEST_PATH.read_text(encoding="utf-8")) or {}
    return list((data.get("series") or {}).keys())


def series_bib(series: str) -> Path:
    return MIRROR_DIR / series / "lectures" / "_static" / BIB_BASENAME


# --------------------------------------------------------------------------- #
# Merging                                                                      #
# --------------------------------------------------------------------------- #
def apply_ruling(base, ruling):
    etype, fields = base
    fields = dict(fields)
    for name in ruling.get("drop", []):
        fields.pop(name.lower(), None)
    for name, value in ruling.get("set", {}).items():
        name = name.lower()
        value = normalise_value(name, value)
        if value:
            fields[name] = value
        else:
            fields.pop(name, None)
    return (ruling.get("type", etype).lower(), fields)


def modifies(ruling) -> bool:
    return bool(ruling.get("set") or ruling.get("drop") or "type" in ruling)


class Merge:
    """The merged entries of one run, and everything found on the way."""

    def __init__(self, series, rulings, copies, committed):
        self.series = series
        self.rulings = rulings
        self.copies = copies              # {key: {series: entry}}
        self.entries = {}                 # {key: entry}
        self.refused = {}                 # {key: reason}
        self.carried = set()              # refused keys kept from the committed file
        self.info = []                    # (kind, message)
        self._merge(committed)

    def conflicts(self):
        return sorted(k for k, held in self.copies.items() if len({digest(e) for e in held.values()}) > 1)

    def _merge(self, committed):
        for key in sorted(self.copies, key=lambda k: (k.lower(), k)):
            held = self.copies[key]
            ruling = self.rulings.get(key)
            if ruling is None:
                if len({digest(e) for e in held.values()}) == 1:
                    self.entries[key] = next(iter(held.values()))
                    continue
                self._refuse(key, f"held by {', '.join(held)} with differing copies and no ruling in sync/bib.yml (run --propose)", committed)
                continue
            take = ruling["take"]
            if take not in held:
                self._refuse(key, f"its ruling takes `{take}`, which no longer holds it (held by {', '.join(held) or 'none'})", committed)
                continue
            result = apply_ruling(held[take], ruling)
            seal = ruling["seal"]
            reasons = []
            if seal.get(take) != digest(held[take]):
                reasons.append(f"the copy it takes, {take}'s, changed since the ruling")
            for s, e in held.items():
                if s == take or e == result:
                    continue
                if s not in seal:
                    reasons.append(f"{s} now holds it, with a copy that differs from the result")
                elif seal[s] != digest(e):
                    reasons.append(f"the copy in {s} changed since the ruling")
            if reasons:
                self._refuse(key, "reopened: " + "; ".join(reasons) + " (re-seal it with --propose)", committed)
                continue
            if len({digest(e) for e in held.values()}) == 1 and not modifies(ruling):
                self.info.append(("ruling-unneeded", f"{key}: every copy now agrees; its ruling can be removed"))
            self.entries[key] = result
        for key in sorted(set(self.rulings) - set(self.copies)):
            self.info.append(("ruling-orphaned", f"{key}: no series holds it any more; its ruling can be removed"))

    def _refuse(self, key, reason, committed):
        self.refused[key] = reason
        if key in committed:
            self.entries[key] = committed[key]
            self.carried.add(key)


def collect_copies(series):
    """(copies, per-series digest of its normalised entries, per-series pybtex entries)."""
    copies, inputs, pyb = {}, {}, {}
    for s in series:
        path = series_bib(s)
        if not path.exists():
            raise Refused(f"{s}: {path.relative_to(ROOT)} is missing (run tools/sync {s}, or pass --reconstruct)")
        entries, pyb[s] = read_bib(s, path)
        inputs[s] = entries_digest(entries)
        for key, entry in entries.items():
            copies.setdefault(key, {})[s] = entry
    return copies, inputs, pyb


class Committed:
    """The committed pool file: its text, entries and recorded header."""

    def __init__(self):
        self.text = None
        self.entries = {}
        self.inputs = self.rulings = self.body = None
        self.problem = None               # why it cannot be trusted, if it cannot
        if not POOL_BIB.exists():
            return
        try:
            self.text = POOL_BIB.read_bytes().decode("utf-8")
        except UnicodeDecodeError as exc:
            self.problem = f"it is not UTF-8 ({exc})"
            return
        header, sep, body = self.text.partition("\n" + BODY_PREFIX)
        try:
            for line in header.splitlines():
                if line.startswith(INPUTS_PREFIX):
                    self.inputs = dict(p.split("=", 1) for p in line[len(INPUTS_PREFIX):].split())
                elif line.startswith(RULINGS_PREFIX):
                    self.rulings = line[len(RULINGS_PREFIX):].strip()
            recorded_body, _, entries_text = body.partition("\n")
        except ValueError:
            self.problem = "its header is not one tools/bib-merge wrote"
            return
        if not sep or self.inputs is None or self.rulings is None:
            self.problem = "its header is not one tools/bib-merge wrote"
            return
        self.body = recorded_body.strip()
        if sha16(entries_text.encode("utf-8")) != self.body:
            self.problem = "its entries are not the ones it was generated with (a hand edit)"
        try:
            self.entries = parse_bib_text("pool", entries_text)
        except Refused as exc:
            self.problem = f"it cannot be read: {exc}"
            self.entries = {}


# --------------------------------------------------------------------------- #
# Writing                                                                      #
# --------------------------------------------------------------------------- #
def ordered_fields(fields):
    known = [f for f in FIELD_ORDER if f in fields]
    rest = sorted(f for f in fields if f not in FIELD_ORDER)
    return known + rest


def render(entries, inputs, rulings_digest) -> str:
    chunks = []
    for key in sorted(entries, key=lambda k: (k.lower(), k)):
        etype, fields = entries[key]
        names = ordered_fields(fields)
        width = max((len(n) for n in names), default=0)
        body = ",\n".join(f"  {n:<{width}} = {{{fields[n]}}}" for n in names)
        chunks.append("\n" + (f"@{etype}{{{key},\n{body}\n}}\n" if names else f"@{etype}{{{key},\n}}\n"))
    entries_text = "".join(chunks)
    return (
        HEADER
        + INPUTS_PREFIX + " ".join(f"{s}={inputs[s]}" for s in sorted(inputs)) + "\n"
        + RULINGS_PREFIX + rulings_digest + "\n"
        + BODY_PREFIX + sha16(entries_text.encode("utf-8")) + "\n"
        + entries_text
    )


def render_problem(text, entries):
    """Why ``text`` must not be written, or None: it must read back as ``entries`` in both readers."""
    _, _, rest = text.partition("\n" + BODY_PREFIX)
    _, _, entries_text = rest.partition("\n")
    try:
        back = parse_bib_text("the merged text", entries_text)
        pybtex_entries("the merged text", text)
    except Refused as exc:
        return str(exc)
    if back != entries:
        changed = sorted(k for k in set(back) | set(entries) if back.get(k) != entries.get(k))
        return f"the merged text reads back differently for {', '.join(changed[:10])}"
    return None


# --------------------------------------------------------------------------- #
# Checks                                                                       #
# --------------------------------------------------------------------------- #
def split_top(text: str, sep: str):
    """Split on ``sep`` at brace depth 0."""
    parts, depth, cur, i = [], 0, [], 0
    while i < len(text):
        c = text[i]
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
        if depth == 0 and text.startswith(sep, i):
            parts.append("".join(cur))
            cur = []
            i += len(sep)
            continue
        cur.append(c)
        i += 1
    parts.append("".join(cur))
    return parts


def top_level(text: str) -> str:
    """The characters of ``text`` outside any brace group."""
    out, depth = [], 0
    for c in text:
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
        elif depth == 0:
            out.append(c)
    return "".join(out)


def name_findings(key, role, value):
    """(errors, infos) for one author or editor list (rule 3)."""
    errors, infos = [], []
    for name in split_top(value, " and "):
        bare = name.strip()
        outside = top_level(bare.replace("\\&", ""))
        parts = [p.strip() for p in split_top(bare, ",")]
        if "&" in outside or ";" in outside:
            errors.append(f"{key}: {role} `{bare}` joins names with `&` or `;`, not `and` (rule 3)")
        elif not bare or any(not p for p in parts):
            errors.append(f"{key}: {role} `{value}` has an empty name or a stray comma (rule 3)")
        elif len(parts) > 3:
            errors.append(f"{key}: {role} `{bare}` separates names with commas, not `and` (rule 3)")
        elif len(parts) == 2 and len(parts[1].split()) >= 2 and any(re.fullmatch(r"[A-Z]\.?", w) for w in parts[0].split()[1:]):
            # "John Y. Campbell, Robert J. Shiller": a middle initial before the comma
            infos.append(("style-name", f"{key}: {role} `{bare}` may be two people separated by a comma (rule 3)"))
        else:
            continue
        break
    return errors, infos


def style_findings(entries):
    """(errors, infos): the house-style rules the normalising cannot apply."""
    errors, infos = [], []
    for key, (etype, fields) in entries.items():
        for need in REQUIRED.get(etype, ()):
            if need not in fields:
                errors.append(f"{key}: @{etype} needs `{need}` (rule 2)")
        for need in REQUIRED_INFO.get(etype, ()):
            if need not in fields:
                infos.append(("style-field", f"{key}: @{etype} has no `{need}` (rule 2)"))
        for role in ("author", "editor"):
            if role in fields:
                e, i = name_findings(key, role, fields[role])
                errors += e
                infos += i
        if "doi" in fields and not fields["doi"].startswith("10."):
            errors.append(f"{key}: doi `{fields['doi']}` is not a bare DOI starting `10.` (rule 9)")
        for name in sorted(set(fields) - KNOWN_FIELDS):
            infos.append(("style-field", f"{key}: unknown field `{name}`"))
        if any(LATEX_ESCAPE_RE.search(v) for v in fields.values()):
            infos.append(("latex-escape", f"{key}: LaTeX escape for an accented character (rule 11: type it directly)"))
    seen = {}
    for key in sorted(entries):
        other = seen.setdefault(key.lower(), key)
        if other != key:
            errors.append(f"{key}: equal to `{other}` when case is ignored (rule 12)")
    return errors, infos


def cited_keys(directory: Path):
    keys = {}
    for md in sorted(directory.glob("*.md")):
        for m in CITE_RE.finditer(md.read_text(encoding="utf-8", errors="replace")):
            for k in m.group(1).split(","):
                k = k.strip()
                if k:
                    keys.setdefault(k, set()).add(md.name)
    return keys


def closure_findings(entries):
    """(errors, infos): pool citations that do not resolve; keys cited nowhere."""
    errors, infos = [], []
    lower = {k.lower(): k for k in entries}
    for key, files in sorted(cited_keys(POOL_DIR).items()):
        if key in entries:
            continue
        hint = f" (the file has `{lower[key.lower()]}`)" if key.lower() in lower else ""
        errors.append(f"{key}: cited by {', '.join(sorted(files))} but not in the merged file{hint}")
    cited = set()
    for s in manifest_series():
        d = MIRROR_DIR / s / "lectures"
        if d.is_dir():
            cited |= set(cited_keys(d))
    cited |= set(cited_keys(POOL_DIR))
    unused = sorted(set(entries) - cited, key=str.lower)
    if unused:
        infos.append(("unused", f"{len(unused)} keys are cited by no lecture of any series reconstructed in mirror/: {', '.join(unused)}"))
    return errors, infos


def _pybtex_view(entry):
    """(type, {field: value}, {role: [person]}) as pybtex reads an entry."""
    fields = {f.lower(): re.sub(r"\s+", " ", v).strip() for f, v in entry.fields.items()}
    persons = {r.lower(): [str(p) for p in ps] for r, ps in entry.persons.items()}
    return entry.type.lower(), fields, persons


def equivalence_findings(text, merge, sources):
    """Errors where pybtex reads a merged entry differently from its source."""
    from pybtex.database import parse_string

    try:
        merged = pybtex_entries("the merged text", text)
    except Refused as exc:
        return [str(exc)]
    errors = []
    for key in sorted(merge.entries, key=str.lower):
        if key in merge.carried:
            continue
        ruling = merge.rulings.get(key)
        held = merge.copies[key]
        series = ruling["take"] if ruling else next(s for s in merge.series if s in held)
        etype, fields, persons = _pybtex_view(sources[series][key])
        fields = {f: normalise_value(f, v) for f, v in fields.items() if f not in DROP_FIELDS}
        fields = {f: v for f, v in fields.items() if v}
        if ruling:
            etype = ruling.get("type", etype).lower()
            for name in ruling.get("drop", []):
                fields.pop(name.lower(), None)
                persons.pop(name.lower(), None)
            for name, value in ruling.get("set", {}).items():
                name = name.lower()
                if name in ("author", "editor"):
                    one = parse_string(f"@misc{{x, {name} = {{{value}}}}}", "bibtex").entries["x"]
                    persons[name] = [str(p) for p in one.persons[name]]
                else:
                    fields[name] = normalise_value(name, value)
        got = _pybtex_view(merged[key])
        if got != (etype, fields, persons):
            diff = [f for f in sorted(set(fields) | set(got[1])) if fields.get(f) != got[1].get(f)]
            diff += [r for r in sorted(set(persons) | set(got[2])) if persons.get(r) != got[2].get(r)]
            if got[0] != etype:
                diff.insert(0, "(type)")
            errors.append(f"{key}: pybtex reads the merged entry differently from {series}'s copy in {', '.join(diff)}")
    return errors


# --------------------------------------------------------------------------- #
# Report and proposals                                                         #
# --------------------------------------------------------------------------- #
def report(merge) -> str:
    keys = merge.conflicts()
    lines = [
        f"## Bibliography conflicts ({len(keys)})",
        "",
        "Fields that agree in every copy are left out; \"—\" means the field is absent and \"·\" that the series does not hold the key.",
        "",
    ]
    for key in keys:
        held = merge.copies[key]
        status = "refused: " + merge.refused[key] if key in merge.refused else f"ruled: takes {merge.rulings[key]['take']}"
        lines += [f"### `{key}`: {status}", "", "| field | " + " | ".join(merge.series) + " | result |", "|---" * (len(merge.series) + 2) + "|"]
        result = None if key in merge.refused else merge.entries.get(key)
        names = sorted({f for _, fs in held.values() for f in fs} | set(result[1] if result else ()))
        rows = [("(type)", lambda e: e[0])] + [(n, lambda e, n=n: e[1].get(n, "—")) for n in names]
        for label, get in rows:
            values = [get(held[s]) if s in held else "·" for s in merge.series]
            if len({v for v in values if v != "·"}) <= 1 and (result is None or get(result) in values):
                continue
            res = get(result) if result else "·"
            cells = [f"`{v}`" if v not in ("·", "—") else v for v in values + [res]]
            lines.append(f"| {label} | " + " | ".join(c.replace("|", "\\|") for c in cells) + " |")
        lines.append("")
    return "\n".join(lines)


def propose(merge) -> str:
    """sync/bib.yml stubs for the refused keys, sealed against the current copies."""
    stubs = {}
    for key in sorted(merge.refused, key=str.lower):
        held = merge.copies.get(key)
        if not held:
            continue
        old = merge.rulings.get(key)
        if old and old["take"] in held:
            stub = {k: old[k] for k in ("take", "set", "drop", "type") if k in old}
            stub["because"] = f"TODO (re-sealed; it was: {old['because']})"
        else:
            take, why = proposal(held, merge.series)
            stub = {"take": take, "because": f"TODO ({why})"}
        stub["seal"] = {s: digest(held[s]) for s in merge.series if s in held}
        stubs[key] = stub
    if not stubs:
        return ""
    text = yaml.safe_dump(stubs, sort_keys=False, allow_unicode=True, width=10_000, default_flow_style=None)
    return "".join(f"  {line}\n" for line in text.splitlines())


def proposal(held, order):
    """A starting point for a ruling: the copy that holds every other copy."""
    items = [(s, held[s]) for s in order if s in held]
    for s, (etype, fields) in items:
        if all(e[0] == etype and all(fields.get(k) == v for k, v in e[1].items()) for _, e in items):
            return s, "proposal: its fields include every other copy's (one copy has more fields)"
    return items[0][0], "proposal: no copy contains the others; pick one"


# --------------------------------------------------------------------------- #
# Main                                                                         #
# --------------------------------------------------------------------------- #
def reconstruct(series_list):
    sync = ROOT / "tools" / "sync"
    cmd = ["uv", "run", "--quiet", "--script", str(sync), *series_list] if shutil.which("uv") else [str(sync), *series_list]
    print("reconstructing mirror/ for:", " ".join(series_list), file=sys.stderr)
    if subprocess.call(cmd, cwd=str(ROOT)) != 0:
        raise Refused("tools/sync failed")


def github_output(**values):
    path = os.environ.get("GITHUB_OUTPUT")
    if path:
        with open(path, "a", encoding="utf-8") as fh:
            for k, v in values.items():
                fh.write(f"{k}={v}\n")


def run(args):
    try:
        series, rulings, rulings_digest = load_rulings()
        if args.reconstruct:
            reconstruct(manifest_series())
        missing = [s for s in series if s not in manifest_series()]
        if missing:
            raise ConfigError(f"sync/bib.yml: series {', '.join(missing)} are not in sync/manifest.yml")
        copies, inputs, sources = collect_copies(series)
    except (Refused, ConfigError) as exc:
        print(f"bib-merge: {exc}", file=sys.stderr)
        github_output(bib_state="error", bib_failed="true", bib_refresh="false")
        return 2

    log = sys.stderr if (args.report == "-" or args.propose) else sys.stdout
    committed = Committed()
    merge = Merge(series, rulings, copies, committed.entries)
    text = render(merge.entries, inputs, rulings_digest)

    for s in manifest_series():
        if s not in series and series_bib(s).exists():
            merge.info.append(("series-unlisted", f"{s} has a {BIB_BASENAME} but is not in sync/bib.yml's `series`"))

    style_errors, style_infos = style_findings(merge.entries)
    closure_errors, closure_infos = closure_findings(merge.entries)
    equivalence_errors = equivalence_findings(text, merge, sources)
    merge.info += style_infos + closure_infos
    write_problem = render_problem(text, merge.entries)

    if args.report:
        body = report(merge)
        if args.report == "-":
            print(body)
        else:
            Path(args.report).write_text(body, encoding="utf-8")
    if args.propose:
        print(propose(merge), end="")

    if committed.text == text:
        state = "clean"
    elif committed.text is None:
        state = "missing"
    elif committed.problem or committed.rulings != rulings_digest:
        state = "violation"
    elif committed.inputs != inputs:
        state = "refresh"
    else:
        state = "violation"

    wrote = False
    if args.write:
        if write_problem:
            pass
        elif committed.problem and merge.carried:
            write_problem = (f"{POOL_BIB.relative_to(ROOT)} cannot be trusted ({committed.problem}), so the committed "
                             f"entries of the refused keys cannot be carried; settle them first")
        elif committed.text != text:
            POOL_BIB.parent.mkdir(parents=True, exist_ok=True)
            with open(POOL_BIB, "w", encoding="utf-8", newline="\n") as fh:
                fh.write(text)
            wrote = True
        if not write_problem:
            state = "clean"

    print(f"keys {len(merge.copies)} · held by two or more series {sum(1 for h in merge.copies.values() if len(h) > 1)} · "
          f"conflicts {len(merge.conflicts())} · rulings {len(rulings)} · merged {len(merge.entries)}", file=log)
    if wrote:
        print(f"wrote {POOL_BIB.relative_to(ROOT)} ({len(merge.entries)} entries)", file=log)
    for key, reason in sorted(merge.refused.items(), key=lambda kv: kv[0].lower()):
        kept = " (the committed entry is kept)" if key in merge.carried else ""
        print(f"[refused] {key}: {reason}{kept}", file=log)
    for e in style_errors:
        print(f"[style] {e}", file=log)
    for e in closure_errors:
        print(f"[closure] {e}", file=log)
    for e in equivalence_errors:
        print(f"[equivalence] {e}", file=log)
    if write_problem:
        print(f"[write-refused] nothing was written: {write_problem}", file=log)
    rel = POOL_BIB.relative_to(ROOT)
    if state == "refresh":
        print(f"[refresh] the series' entries moved since {rel} was generated: run tools/bib-merge --write", file=log)
    elif state == "missing":
        print(f"[violation] {rel} is missing (run tools/bib-merge --write)", file=log)
    elif state == "violation":
        why = (committed.problem or ("sync/bib.yml changed and the file was not regenerated"
               if committed.rulings != rulings_digest else "it is not what the same inputs generate (a tool change that was not regenerated?)"))
        print(f"[violation] {rel}: {why} (run tools/bib-merge --write)", file=log)
    for kind, message in merge.info:
        print(f"[info:{kind}] {message}", file=log)

    failed = bool(merge.refused or style_errors or closure_errors or equivalence_errors or write_problem
                  or state in ("violation", "missing"))
    github_output(bib_state=state, bib_failed=str(failed).lower(), bib_refresh=str(state == "refresh").lower())
    if failed:
        return 2
    return 1 if state == "refresh" else 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="tools/bib-merge", description=__doc__.split("\n\n")[0])
    p.add_argument("--write", action="store_true", help="write lectures/_static/quant-econ.bib")
    p.add_argument("--report", nargs="?", const="-", metavar="PATH", help="write the conflict report (markdown) to PATH, or stdout")
    p.add_argument("--propose", action="store_true", help="print sync/bib.yml stubs for every refused key")
    p.add_argument("--reconstruct", action="store_true", help="rebuild mirror/ for every manifest series first")
    args = p.parse_args(argv)
    try:
        return run(args)
    except Exception as exc:  # anything unforeseen must fail loudly, never read as "behind"
        traceback.print_exc()
        print(f"bib-merge: internal error: {type(exc).__name__}: {exc}", file=sys.stderr)
        github_output(bib_state="error", bib_failed="true", bib_refresh="false")
        return 2


if __name__ == "__main__":
    sys.exit(main())
