#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["pyyaml"]
# ///
"""tools/stage-site — copy one site's own pages and files into the pool folder.

Sphinx reads only inside its source directory, and every site's root page is
called ``intro.md``, so a site's own pages cannot live in the flat pool. They
live in ``sites/<key>/`` and are copied into ``lectures/`` just before
``jb build`` (QuantEcon/project-monorepo#58, the owner's ruled approach):
every ``sites/<key>/<name>.md`` to ``lectures/<name>.md``, and every file
under ``sites/<key>/_static/`` (the site's branding, and files its pages use)
to the same path under ``lectures/_static/``. The site's ``_config.yml`` and
``_toc.yml`` are copied too, to ``lectures/_config.yml`` and
``lectures/_toc.yml``, where ``jb build lectures`` finds them with no
``--config`` or ``--toc``, and where QuantEcon/actions' ``build-lectures``
reads ``_config.yml`` for its check of the executed notebooks.
``site.yml`` is not copied: it is the build workflow's, not Jupyter Book's.
Neither file is ever a pool file: ``tools/pool-check`` fails a
``lectures/_config.yml`` or ``lectures/_toc.yml`` (``top-level``), so
staging must be cleaned before a commit.

A copy never overwrites, and staging never removes a file it did not copy:
a destination that already exists, whatever its bytes, stops the run before
anything is copied. The only pool files it changes in place are the
lectures ``--local-links`` rewrites (below), each kept first as it was.
What a run copies, and the folders it makes, are written first to a record
outside the pool, ``_build/stage-site.json`` (``_build/`` is ignored by
git), and ``--clean`` removes only what that record lists: each file whose
bytes are still the ones it copied, then each folder the run made once it
is empty, then the record. One site is staged at a time: while a record
exists, staging refuses.

With ``--local-links``, for a consumer site alone (``class: consumer`` in
``sync/manifest.yml``, today ``dp``; QuantEcon/project-monorepo#22), staging
also rewrites, in the pool lectures the site lists, each link that leaves the
site for a lecture the site carries into a link within the site. A consumer's
copies stay byte for byte its sources' own, so a link they make to their home
series' site would take the reader away from a page the consumer has. Two
forms, read in prose only (not in code cells, literal blocks, inline literals
or ``%`` comments):

* a prefixed ``{doc}`` link (``{doc}`intermediate:perm_income_cons``` or
  ``{doc}`text <intro:short_path>```), whose prefix is a key of the site's
  ``intersphinx_mapping``, loses its prefix;
* a markdown link to a lecture site's page by its address
  (``[text](https://python.quantecon.org/os_stochastic.html)``), on a host the
  site maps, the site's own, or an older address that still forwards
  (``OLD_ADDRESSES``), becomes a link to the lecture's file
  (``[text](os_stochastic.md)``). An address with an anchor is left alone.

A lecture is the site's when its ``_toc.yml`` lists it and it is a pool
lecture (a file directly in ``lectures/``), not a page of the site's own
folder. Each rewritten lecture's original bytes are kept under
``_build/stage-site-originals/`` and named in the record, and ``--clean``
puts them back, the same way it removes a copy: only over a file whose bytes
are still the ones staging wrote. A lecture removed since, or edited, is
left as it is, with its original kept. The site build
passes the option when the site's ``site.yml`` sets ``local_links: true``.

Usage
-----
    tools/stage-site dp                 # stage dp's pages, files, _config.yml and _toc.yml into lectures/
    tools/stage-site --local-links dp   # the same, and rewrite links to lectures the site carries
    tools/stage-site --clean dp         # remove them again, and put any rewritten lecture back

Exit status: 0 done, 1 refused (no such site, a destination exists, or a
site is staged already, or another site is, or ``--local-links`` for a site
that is not a consumer, or with a lecture's original left under
``_build/stage-site-originals/``), 2 an error (among them a record naming a
path outside the folder it belongs in, which ``--clean`` refuses before it
touches anything). It never commits anything.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
POOL_DIR = ROOT / "lectures"
SITES_DIR = ROOT / "sites"
RECORD_PATH = ROOT / "_build" / "stage-site.json"
ORIGINALS_DIR = ROOT / "_build" / "stage-site-originals"
MANIFEST_PATH = ROOT / "sync" / "manifest.yml"
# The files every site holds. The first two mark a folder as a site.
SITE_FILES = ("_toc.yml", "site.yml", "_config.yml")
# Copied into lectures/ with the pages, for jb build to find there.
BOOK_FILES = ("_config.yml", "_toc.yml")
KEY_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")
# --local-links. Addresses a lecture site had before, which still forward to
# its current one: python-intro.quantecon.org was intermediate's.
OLD_ADDRESSES = ("https://python-intro.quantecon.org/",)
# A fence, as tools/pool-check reads one, and the fenced blocks whose body is
# code or literal text, not prose.
FENCE_RE = re.compile(r"^[ \t]*(`{3,}|~{3,})(.*)$")
CODE_DIRECTIVES = ("{code-cell}", "{code-block}", "{code}", "{sourcecode}", "{literalinclude}")
# In a paragraph: a role's text ({doc}`...`), kept, or an inline literal,
# masked. Either may run across a line break.
BACKTICKS_RE = re.compile(r"(\{[\w:+-]+\})?(`+)(.*?)(?<!`)\2(?!`)", re.DOTALL)
# A paragraph ends at a blank line, a heading, or a block that is not prose.
HEADING_RE = re.compile(r"^ {0,3}#{1,6}(\s|$)")
# A pool lecture's name, as both link forms spell it.
LECTURE_NAME_RE = re.compile(r"[\w-]+")
DOC_LINK_RE = re.compile(r"\{doc\}`(?P<text>[^`<>]*<)?(?P<prefix>[\w.-]+):(?P<name>[\w-]+)(?P<close>>?)`")


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def shown(path: Path) -> str:
    return path.relative_to(ROOT).as_posix()


def site_keys():
    if not SITES_DIR.is_dir():
        return []
    return sorted(p.name for p in SITES_DIR.iterdir() if p.is_dir() and all((p / f).is_file() for f in SITE_FILES[:2]))


def staged_files(site: Path):
    """``[(source, destination)]`` for every file staging ``site`` copies."""
    pairs = [(site / name, POOL_DIR / name) for name in BOOK_FILES if (site / name).is_file()]
    for p in sorted(site.iterdir()):
        if p.is_file() and p.suffix == ".md":
            pairs.append((p, POOL_DIR / p.name))
    static = site / "_static"
    if static.is_dir():
        for p in sorted(q for q in static.rglob("*") if q.is_file() and not q.name.startswith(".")):
            pairs.append((p, POOL_DIR / p.relative_to(site)))
    return pairs


def prose_mask(text: str) -> str:
    """``text`` with what is not prose blanked to spaces, its length and line
    breaks kept, so a match in it is at the same place in ``text``: the bodies
    of code cells and literal fenced blocks (backtick or tilde, plain or with a
    language), ``%`` comment lines and inline literals. A directive's own body
    (``{note}``) is prose, read again for the blocks inside it. An inline
    literal is read a paragraph at a time, as CommonMark reads one: it may run
    across a line break, but not a blank line, a heading or a fenced block.

    It reads fences as tools/pool-check's ``prose()`` does, so the two tools
    agree on what is prose; like it, it reads a ``{math}`` body, a block
    indented four spaces and a ``:::`` fence's body as prose. No pool lecture
    has a link in one of those (2026-11-27)."""
    lines = text.split("\n")
    blank = lambda line: " " * len(line)
    prose_rows = []

    def is_closing(line, fence):
        m = FENCE_RE.match(line)
        return bool(m) and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence) and not m.group(2).strip()

    def read(start, stop):
        i = start
        while i < stop:
            m = FENCE_RE.match(lines[i])
            if not m or (m.group(1)[0] == "`" and "`" in m.group(2)):
                if lines[i].lstrip().startswith("%"):
                    lines[i] = blank(lines[i])
                else:
                    prose_rows.append(i)
                i += 1
                continue
            end = next((j for j in range(i + 1, stop) if is_closing(lines[j], m.group(1))), stop)
            info = m.group(2).strip()
            lines[i] = blank(lines[i])
            if not info.startswith("{") or info.startswith(CODE_DIRECTIVES):
                for j in range(i + 1, end):
                    lines[j] = blank(lines[j])
            else:
                read(i + 1, end)
            if end < stop:
                lines[end] = blank(lines[end])
            i = end + 1

    read(0, len(lines))
    paragraphs = []
    for i in prose_rows:
        if not lines[i].strip():
            continue
        if paragraphs and paragraphs[-1][-1] == i - 1 and not HEADING_RE.match(lines[i]) \
                and not HEADING_RE.match(lines[i - 1]):
            paragraphs[-1].append(i)
        else:
            paragraphs.append([i])
    keep_breaks = lambda r: r.group(0) if r.group(1) else re.sub(r"[^\n]", " ", r.group(0))
    for rows in paragraphs:
        masked = BACKTICKS_RE.sub(keep_breaks, "\n".join(lines[i] for i in rows)).split("\n")
        for i, line in zip(rows, masked):
            lines[i] = line
    return "\n".join(lines)


def rewrite_links(text: str, carried, prefixes, hosts):
    """``(text, n)``: ``text`` with its prose links to a lecture in ``carried``
    made links within the site, and how many it rewrote."""
    masked = prose_mask(text)
    edits = []
    for m in DOC_LINK_RE.finditer(masked):
        if m.group("prefix") in prefixes and m.group("name") in carried and bool(m.group("text")) == bool(m.group("close")):
            edits.append((m.start("prefix"), m.end("prefix") + 1, ""))
    url_re = re.compile(r"\]\((?P<base>" + "|".join(re.escape(h) for h in hosts) + r")(?P<name>[\w-]+)\.html\)")
    for m in url_re.finditer(masked) if hosts else ():
        if m.group("name") in carried:
            edits.append((m.start("base"), m.end(), f"{m.group('name')}.md)"))
    for start, end, new in sorted(edits, reverse=True):
        text = text[:start] + new + text[end:]
    return text, len(edits)


def toc_files(toc):
    """Every page a Jupyter Book ``_toc.yml`` lists: its root, then each ``file:``."""
    files = []

    def walk(node):
        if isinstance(node, dict):
            if isinstance(node.get("file"), str):
                files.append(node["file"])
            for key in ("parts", "chapters", "sections"):
                walk(node.get(key))
        elif isinstance(node, list):
            for item in node:
                walk(item)

    if isinstance(toc, dict) and isinstance(toc.get("root"), str):
        files.append(toc["root"])
    walk(toc)
    return [f[:-3] if f.endswith(".md") else f for f in files]


def local_link_plan(key: str, site: Path):
    """``(plan, refusal)``: ``[(lecture, rewritten text, n)]`` for each pool
    lecture of the site whose links ``--local-links`` rewrites, or why it
    refuses."""
    try:
        import yaml
    except ImportError:
        raise ValueError("--local-links reads the site's YAML files with PyYAML, which this Python does not have") from None

    manifest = yaml.safe_load(MANIFEST_PATH.read_text(encoding="utf-8")) if MANIFEST_PATH.is_file() else None
    entry = ((manifest or {}).get("series") or {}).get(key)
    if not (isinstance(entry, dict) and entry.get("class") == "consumer"):
        return None, f"--local-links is for a consumer site, and sync/manifest.yml does not mark {key} `class: consumer`"
    config = yaml.safe_load((site / "_config.yml").read_text(encoding="utf-8")) or {}
    mapping = ((config.get("sphinx") or {}).get("config") or {}).get("intersphinx_mapping") or {}
    site_yml = yaml.safe_load((site / "site.yml").read_text(encoding="utf-8")) or {}
    prefixes = {k for k in mapping if isinstance(k, str)}
    hosts = {v[0] if isinstance(v, (list, tuple)) else v for v in mapping.values()}
    hosts |= {site_yml.get("url")} | set(OLD_ADDRESSES)
    hosts = sorted(h if h.endswith("/") else h + "/" for h in hosts if isinstance(h, str) and h.startswith("https://"))
    toc = yaml.safe_load((site / "_toc.yml").read_text(encoding="utf-8"))
    own = {p.stem for p in site.glob("*.md")}
    # Only a name of a file directly in the pool: an entry such as
    # ../sites/dp/page, a subfolder's page or a link that leads out is not a
    # pool lecture, so nothing outside lectures/ is ever rewritten.
    pool = POOL_DIR.resolve()
    carried = {f for f in toc_files(toc) if f not in own and LECTURE_NAME_RE.fullmatch(f)
               and (POOL_DIR / f"{f}.md").is_file() and (POOL_DIR / f"{f}.md").resolve().parent == pool}
    plan = []
    for name in sorted(carried):
        path = POOL_DIR / f"{name}.md"
        text = path.read_text(encoding="utf-8")
        new, n = rewrite_links(text, carried, prefixes, hosts)
        if n:
            plan.append((path, new, n))
    return plan, None


def read_record():
    if not RECORD_PATH.is_file():
        return None
    record = json.loads(RECORD_PATH.read_text(encoding="utf-8"))
    if not (
        isinstance(record, dict)
        and isinstance(record.get("files"), list)
        and all(isinstance(f, dict) and isinstance(f.get("path"), str) and isinstance(f.get("sha256"), str)
                for f in record["files"])
        and isinstance(record.get("dirs"), list)
        and all(isinstance(d, str) for d in record["dirs"])
        and isinstance(record.get("rewritten", []), list)
        and all(isinstance(f, dict) and isinstance(f.get("path"), str) and isinstance(f.get("sha256"), str)
                and isinstance(f.get("original"), str) for f in record.get("rewritten", []))
    ):
        raise ValueError(f"{shown(RECORD_PATH)} is not a stage-site record")
    return record


def inside(rel: str, folder: Path) -> Path:
    """``ROOT / rel``, refused unless it lies inside ``folder``."""
    path = (ROOT / rel).resolve()
    if folder.resolve() not in path.parents:
        raise ValueError(f"{shown(RECORD_PATH)} names {rel}, which is not inside {shown(folder)}/")
    return ROOT / rel


def inside_pool(rel: str) -> Path:
    return inside(rel, POOL_DIR)


def stage(key: str, site: Path, local_links: bool = False) -> int:
    record = read_record()
    if record is not None:
        print(
            f"stage-site {key}: refused, nothing copied: sites/{record.get('site')} is staged "
            f"({shown(RECORD_PATH)}); run `tools/stage-site --clean {record.get('site')}` first."
        )
        return 1
    pairs = staged_files(site)
    present = [dst for _, dst in pairs if dst.exists() or dst.is_symlink()]
    if present:
        for dst in present:
            print(f"  [exists] {shown(dst)}")
        print(
            f"stage-site {key}: refused, nothing copied: staging never overwrites. A pool file here is a "
            "broken pool-check rule (site-page, or top-level for _config.yml and _toc.yml); anything else is left from "
            "an earlier build, to remove first."
        )
        return 1
    plan = []
    if local_links:
        plan, refusal = local_link_plan(key, site)
        if refusal:
            print(f"stage-site {key}: refused, nothing copied: {refusal}")
            return 1
        left = [ORIGINALS_DIR / path.name for path, _, _ in plan if (ORIGINALS_DIR / path.name).exists()]
        if left:
            for p in left:
                print(f"  [exists] {shown(p)}")
            print(f"stage-site {key}: refused, nothing copied: a lecture's original is left from an earlier --clean, "
                  "which kept the lecture; put it back or remove it first.")
            return 1
    dirs = []
    for _, dst in pairs:
        parent = dst.parent
        missing = []
        while not parent.exists() and parent != POOL_DIR:
            missing.append(parent)
            parent = parent.parent
        for d in reversed(missing):
            if shown(d) not in dirs:
                dirs.append(shown(d))
    rewritten = [
        {"path": shown(path), "sha256": hashlib.sha256(new.encode("utf-8")).hexdigest(),
         "original": shown(ORIGINALS_DIR / path.name)}
        for path, new, _ in plan
    ]
    RECORD_PATH.parent.mkdir(parents=True, exist_ok=True)
    RECORD_PATH.write_text(
        json.dumps(
            {"site": key, "files": [{"path": shown(dst), "sha256": digest(src)} for src, dst in pairs], "dirs": dirs,
             "rewritten": rewritten},
            indent=2,
        ) + "\n",
        encoding="utf-8",
    )
    for src, dst in pairs:
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
    if plan:
        ORIGINALS_DIR.mkdir(parents=True, exist_ok=True)
        for path, new, _ in plan:
            shutil.copyfile(path, ORIGINALS_DIR / path.name)
            path.write_text(new, encoding="utf-8")
    print(f"stage-site {key}: {len(pairs)} file(s) copied into lectures/ (recorded in {shown(RECORD_PATH)})")
    if local_links:
        print(f"stage-site {key}: {sum(n for _, _, n in plan)} link(s) in {len(plan)} lecture(s) rewritten to "
              "lectures within the site")
    return 0


def clean(key: str) -> int:
    record = read_record()
    if record is None:
        print(f"stage-site --clean {key}: nothing is staged ({shown(RECORD_PATH)} does not exist)")
        return 0
    if record.get("site") != key:
        print(f"stage-site --clean {key}: refused: the staged site is sites/{record.get('site')}, not sites/{key}")
        return 1
    # Every path the record names, confined before anything is touched.
    files = [(item["path"], inside_pool(item["path"]), item["sha256"]) for item in record["files"]]
    dirs = [inside_pool(rel) for rel in record["dirs"]]
    rewritten = [(item, inside_pool(item["path"]), inside(item["original"], ORIGINALS_DIR))
                 for item in record.get("rewritten", [])]
    removed, kept = 0, []
    for rel, dst, sha256 in files:
        if not dst.is_file():
            continue
        if digest(dst) != sha256:
            kept.append(f"kept {rel}: its bytes are not the ones staging copied")
            continue
        dst.unlink()
        removed += 1
    for d in reversed(dirs):
        if d.is_dir() and not any(d.iterdir()):
            d.rmdir()
    restored = 0
    for item, dst, original in rewritten:
        rel = item["path"]
        if not original.is_file():
            kept.append(f"kept {rel} as it is: its original, {item['original']}, is gone, so it cannot be put back")
            continue
        if not dst.is_file():
            kept.append(f"kept {rel} as it is: it is no longer a file, so its original is left at {item['original']}")
            continue
        if digest(dst) != item["sha256"]:
            kept.append(f"kept {rel}: its bytes are not the ones staging wrote; its original is left at {item['original']}")
            continue
        shutil.copyfile(original, dst)
        original.unlink()
        restored += 1
    if ORIGINALS_DIR.is_dir() and not any(ORIGINALS_DIR.iterdir()):
        ORIGINALS_DIR.rmdir()
    for line in kept:
        print(f"  {line}")
    RECORD_PATH.unlink()
    print(f"stage-site --clean {key}: {removed} file(s) removed" + (f", {restored} lecture(s) put back" if restored else ""))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tools/stage-site", description=__doc__.split("\n\n")[0])
    parser.add_argument("key", help="the site: a folder under sites/ holding _toc.yml and site.yml")
    parser.add_argument("--clean", action="store_true", help="remove the site's staged copies instead")
    parser.add_argument("--local-links", action="store_true",
                        help="for a consumer site, also rewrite links to lectures the site carries into links within it")
    args = parser.parse_args(argv)
    if not (KEY_RE.fullmatch(args.key) and args.key in site_keys()):
        sys.stderr.write(f"error: there is no site sites/{args.key}/ (sites: {', '.join(site_keys()) or 'none'})\n")
        return 1
    if not POOL_DIR.is_dir():
        sys.stderr.write(f"error: {POOL_DIR} does not exist\n")
        return 2
    site = SITES_DIR / args.key
    return clean(args.key) if args.clean else stage(args.key, site, args.local_links)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as exc:
        sys.stderr.write(f"error: {exc}\n")
        sys.exit(2)
