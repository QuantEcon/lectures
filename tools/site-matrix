#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["pyyaml"]
# ///
"""tools/site-matrix — the build matrix for the named sites, from their site.yml.

Prints, on one line, the JSON list the build workflow's matrix runs over
(``.github/workflows/site-build.yml``): one entry per site named, in the
order named, each with the job settings its ``sites/<key>/site.yml`` decides.

* ``runs_on``, ``leg`` and ``machine``: where the site's ``runner`` class
  builds. ``ubuntu-latest`` is GitHub's runner, and the leg runs in a
  container (``leg``: ``container``; ``machine`` empty). ``g4dn.2xlarge``
  is a RunsOn machine with one NVIDIA T4, from QuantEcon's GPU machine
  image, and the leg runs on the machine itself (``leg``: ``gpu``):
  ``machine`` is RunsOn's spec, which names the machine image by its AMI
  ID, and ``runs_on`` is RunsOn's label, ``runs-on=<run ID>/<machine>``, so
  ``--run-id`` is needed. A GPU site builds in the ``base`` environment
  alone (the owner's choice of 2026-11-22); one in ``series`` is refused.
* ``environment``, ``image``, ``env_file`` and ``cache_tag``: what the site
  builds in, from ``site.yml``'s optional ``environment``
  (QuantEcon/project-monorepo#77, ``ideas/one-environment-for-every-site.md``
  in QuantEcon/project-monorepo):

  - ``series`` (the default): the lean image,
    ``ghcr.io/quantecon/quantecon-build:latest``, the container dp's own
    workflows build in. The leg installs nothing but ``extra_packages``; the
    execution cache is keyed on the series' ``mirror/<key>/environment.yml``,
    which names the environment the series declares.
  - ``base``: the full image, ``ghcr.io/quantecon/quantecon:latest``, with
    ``_base/environment-update.yml``, the one package list every site is to
    build with, applied by QuantEcon/actions' ``setup-environment``; the
    cache is keyed on that list, and its key carries ``base-``, so it never
    meets a cache built in the series' environment. On the GPU leg there is
    no image (``image`` is empty): the workflow creates the same base on the
    machine and applies the same list.
* ``timeout_minutes``: the job's time limit. ``site.yml`` holds no job limit
  (no series sets one; ``cell_timeout`` is the limit on one cell), so it is
  ``cell_timeout`` in whole minutes, the longest a single cell may run, plus
  ``BUILD_ALLOWANCE`` minutes for the rest of a build from an empty cache. dp's
  own weekly build from an empty cache took 22 to 41 minutes in
  October-November 2026.
* ``extra_packages``: the pip requirements ``site.yml`` lists for the leg to
  install before the build (``[]`` without the field), and
  ``packages_hash``, the first 16 hex digits of the SHA-256 of them, one per
  line (``none`` for no list), which the execution cache's key carries, so a
  change to the list starts a new cache. A value that is not a plain
  requirement (``tools/pool-check``'s pattern) is refused.
* ``cell_timeout`` and ``publishes`` as ``site.yml`` gives them.

Only a site of ``type: series`` is built so far. ``tools/pool-check`` checks every
``site.yml`` field; this tool only reads them, and refuses one it cannot use.

Usage
-----
    tools/site-matrix dp          # [{"key": "dp", "runs_on": "ubuntu-latest", ...}]
    tools/site-matrix dp intro
    tools/site-matrix --run-id "$GITHUB_RUN_ID" dp intro programming

Exit status: 0 printed, 1 a site refused (no such site, or no leg for its
runner class or type), 2 an error.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import re
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
SITES_DIR = ROOT / "sites"
KEY_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")
# Runner class -> (its leg, RunsOn's machine spec), for the classes with a leg.
# The GPU machine image is QuantEcon's quantecon_ubuntu2404, by the AMI ID the
# GPU series give it in their own .github/runs-on.yml (read 2026-11-22):
# RunsOn reads that file from a repository's default branch, and
# QuantEcon/lectures has none. When the series move to a new machine image,
# this follows, and the sites' execution caches start again.
RUNNERS = {
    "ubuntu-latest": ("container", ""),
    "g4dn.2xlarge": ("gpu", "family=g4dn.2xlarge/ami=ami-0edec81935264b6d3/volume=80gb/spot=false"),
}
# site.yml's environment -> (container image, the file the cache key hashes, the
# key's tag). The default is `series`; tools/pool-check allows the same values.
ENVIRONMENTS = {
    "series": ("ghcr.io/quantecon/quantecon-build:latest", "mirror/{key}/environment.yml", ""),
    "base": ("ghcr.io/quantecon/quantecon:latest", "_base/environment-update.yml", "base-"),
}
# Minutes a whole build from an empty cache may take, beyond one cell's limit.
BUILD_ALLOWANCE = 120
# One pip requirement, as tools/pool-check's site-yml rule allows it.
REQUIREMENT_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._\-\[\],<>=!~*+]*")


def site_keys():
    if not SITES_DIR.is_dir():
        return []
    return sorted(p.name for p in SITES_DIR.iterdir() if (p / "site.yml").is_file())


def entry(key: str, run_id: str | None):
    """The matrix entry for ``key``, or a reason it is refused."""
    path = SITES_DIR / key / "site.yml"
    data = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        return None, f"sites/{key}/site.yml is not a mapping"
    if data.get("type") != "series":
        return None, f"sites/{key}: type {data.get('type')!r} has no leg yet (only `series`)"
    runner = data.get("runner")
    # A string first: a list or mapping cannot be looked up in the table, and
    # gets the same refusal as an unknown name.
    if not isinstance(runner, str) or runner not in RUNNERS:
        return None, f"sites/{key}: runner {runner!r} has no leg yet (only {', '.join(RUNNERS)})"
    cell_timeout = data.get("cell_timeout")
    if not (isinstance(cell_timeout, int) and not isinstance(cell_timeout, bool) and cell_timeout > 0):
        return None, f"sites/{key}: cell_timeout {cell_timeout!r} is not a whole number of seconds above 0"
    # The same rule as tools/pool-check's site-yml: absent means none; present
    # means a non-empty list of plain requirements, each at most once.
    packages = data.get("extra_packages", [])
    if "extra_packages" in data and not (
        isinstance(packages, list)
        and packages
        and all(isinstance(p, str) and REQUIREMENT_RE.fullmatch(p) for p in packages)
        and len(set(packages)) == len(packages)
    ):
        return None, (f"sites/{key}: extra_packages {packages!r} is not a list of pip requirements, "
                      "non-empty and each at most once")
    environment = data.get("environment", "series")
    if not isinstance(environment, str) or environment not in ENVIRONMENTS:
        return None, f"sites/{key}: environment {environment!r} is not one of {', '.join(ENVIRONMENTS)}"
    leg, machine = RUNNERS[runner]
    if leg == "gpu" and environment != "base":
        return None, (f"sites/{key}: a site on {runner} builds in the base environment alone "
                      f"(environment: base), not {environment!r}")
    if leg == "gpu" and not run_id:
        return None, f"sites/{key}: a site on {runner} needs --run-id, the workflow run's ID, for RunsOn's label"
    image, env_file, cache_tag = ENVIRONMENTS[environment]
    return {
        "key": key,
        "runs_on": f"runs-on={run_id}/{machine}" if machine else runner,
        "leg": leg,
        "machine": machine,
        "environment": environment,
        "image": image if leg == "container" else "",
        "env_file": env_file.format(key=key),
        "cache_tag": cache_tag,
        "timeout_minutes": math.ceil(cell_timeout / 60) + BUILD_ALLOWANCE,
        "cell_timeout": cell_timeout,
        "publishes": list(data.get("publishes") or []),
        "extra_packages": packages,
        "packages_hash": hashlib.sha256("\n".join(packages).encode()).hexdigest()[:16] if packages else "none",
    }, None


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tools/site-matrix", description=__doc__.split("\n\n")[0])
    parser.add_argument("--run-id", metavar="ID",
                        help="the workflow run's ID, for a GPU site's RunsOn label")
    parser.add_argument("keys", nargs="+", metavar="SITE", help="the sites to build, folders under sites/")
    args = parser.parse_args(argv)
    if args.run_id is not None and not re.fullmatch(r"[0-9]+", args.run_id):
        parser.error(f"--run-id {args.run_id!r} is not a run ID (digits)")
    known = site_keys()
    matrix, refused = [], []
    for key in dict.fromkeys(args.keys):
        if not (KEY_RE.fullmatch(key) and key in known):
            refused.append(f"there is no site sites/{key}/ (sites: {', '.join(known) or 'none'})")
            continue
        item, reason = entry(key, args.run_id)
        if reason:
            refused.append(reason)
        else:
            matrix.append(item)
    for reason in refused:
        sys.stderr.write(f"site-matrix: refused: {reason}\n")
    if refused:
        return 1
    left = [k for k in known if k not in args.keys]
    if left:
        sys.stderr.write(f"site-matrix: not built (not named): {', '.join(left)}\n")
    print(json.dumps(matrix, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, yaml.YAMLError) as exc:
        sys.stderr.write(f"error: {exc}\n")
        sys.exit(2)
