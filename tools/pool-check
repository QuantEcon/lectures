#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["pyyaml"]
# ///
"""tools/pool-check — check that the pool keeps its layout conventions.

The pool, ``lectures/``, is flat: a lecture's file name is its slug and its
stable address, and its assets live under ``_static/`` by the conventions in
PLAN.md (M2, *Pool ``_static`` conventions*). ``tools/promote`` writes the pool
that way. This check keeps it so, whoever edits it next. Each rule it breaks
is reported under a tag:

* ``top-level``     — ``lectures/`` holds lectures (``<slug>.md``) and
  ``_static/``, nothing else.
* ``underscore``    — no lecture's name starts with ``_``. The prefix is kept
  for names that are not lectures, such as ``_static/_shared/``.
* ``case``          — no two lectures' names differ only in case: a
  case-insensitive file system or address cannot tell them apart.
* ``static-entry``  — every entry at the top of ``_static/`` is a lecture's
  own folder (``_static/<slug>/`` beside ``<slug>.md``), ``_shared/`` or the
  merged bibliography, ``quant-econ.bib``.
* ``asset-owner``   — a file under ``_static/<slug>/`` is used by
  ``<slug>.md`` alone. An asset a second lecture uses belongs in
  ``_static/_shared/``.
* ``root-relative`` — asset references are file-relative
  (``_static/<slug>/fig.png``, never ``/_static/...``), so a lecture
  resolves under any project root.
* ``escapes``       — no reference leaves ``lectures/``.
* ``doc-target``    — every ``{doc}`` link resolves. A plain target
  (``{doc}`mccall```) names a pool lecture or a site page, which each
  site supplies (``tools/promote``'s ``SITE_PAGES``). A prefixed
  target (``{doc}`intro:cobweb```) leaves the site: its prefix is a
  series key in ``sync/manifest.yml``, or one of the prefixes recorded in
  ``LEGACY_PREFIXES`` until the cross-reference policy settles them
  (QuantEcon/project-monorepo#22), and what follows names a site page
  or a pool lecture that series holds (the ledger's record of its copies;
  not checked for a legacy prefix, or with no ledger). Text in code cells,
  literal blocks, inline literals and ``%`` comments is not read as a link.

The sites, ``sites/<key>/`` (one folder per published site), are checked
too, so a site's folder stays true to the pool it is built from:

* ``site-layout``   — a site's folder holds ``_config.yml``, ``_toc.yml``,
  ``site.yml``, its own pages (``<name>.md``) and ``_static/``, nothing
  else; ``sites/`` holds those folders and ``README.md``.
* ``site-toc``      — every entry in a site's ``_toc.yml`` resolves to a pool
  lecture (``lectures/<name>.md``) or a page in the site's folder.
* ``site-page``     — a site page's name is not a pool lecture's, and no file
  under the site's ``_static/`` is a pool file, since staging copies them
  into ``lectures/`` (``tools/stage-site``) and would overwrite it.
* ``site-config``   — ``_config.yml`` is well formed where it is read; it
  sets ``only_build_toc_files: true`` and the site's own execution cache,
  ``execute.cache: _build/jupyter_cache/<key>``; its theme names this
  repository and the pool's folder (``repository_url:
  https://github.com/QuantEcon/lectures``, ``path_to_docs: lectures``),
  whose history each page's changelog lists; the files it names as
  branding (``logo``, ``html_favicon``, ``dark_logo``) are in the site's
  ``_static/``; the
  cross-reference rules hold (QuantEcon/project-monorepo#22): the site sets
  ``intersphinx_disabled_reftypes: []``, maps no consumer series (``dp``)
  in ``intersphinx_mapping``, and, unless it is a consumer, maps itself, to
  the address in its ``site.yml``.
* ``site-yml``      — ``site.yml`` has the fields the build reads, each with
  a valid value (``SITE_FIELDS``), and no other field but the optional ones
  (``SITE_OPTIONAL_FIELDS``: ``extra_packages``, pip requirements the build
  installs), and its ``url`` is ``html.baseurl``.

One report is not a rule. A label that more than one pool lecture defines is
counted on every run and listed by ``--labels``: targets (``(name)=`` and
``:name:``, compared without case, as Sphinx does) and equation labels
(``:label:`` and ``$$ ... $$ (name)``), which are separate namespaces.
Labels must be unique within a site, which is checked where a site is
built; across the whole pool the list is information. An option written in
a directive's ``---`` block is not read.

References are found by ``tools/promote``'s own parser, imported for the
purpose, so the two tools agree on what a lecture refers to. Names unique
across the published sites needs the mirror, so it is the drift-check's
(``name-shared``).

Usage
-----
    tools/pool-check            # check lectures/
    tools/pool-check --labels   # also list the labels more than one lecture defines

Exit status: 0 clean, 1 a rule broken, 2 an error. It reads ``lectures/``,
``sites/``, the series keys in ``sync/manifest.yml`` and ``sync/ledger.yml``,
and writes nothing. Run it on a tree with no site staged: a staged site's
pages and files in ``lectures/`` are not the pool's (``tools/stage-site
--clean``).
"""

from __future__ import annotations

import argparse
import posixpath
import re
import sys
import traceback
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
POOL_DIR = ROOT / "lectures"
SITES_DIR = ROOT / "sites"
PROMOTE_PATH = Path(__file__).resolve().parent / "promote"

SHARED_DIR = "_shared"
# The kinds promote's parser finds by pattern alone (markdown links, quoted
# strings in code cells): only one whose target exists refers to a file.
HEURISTIC_KINDS = ("link", "code-str")

# A ``{doc}`` role: ``{doc}`target``` or ``{doc}`link text <target>```, in
# one backtick or a longer run. Link text is not empty: Sphinx reads
# ``{doc}`<x>``` as the target ``<x>``.
DOC_RE = re.compile(r"\{doc\}(`+)(.+?)\1(?!`)", re.S)
DOC_TITLED_RE = re.compile(r"^.*\S.*<([^<>]+)>\s*$", re.S)
# Prefixes lectures use for links to another site that are not series keys:
# older names for a series' site. Recorded, not endorsed: the cross-reference
# policy (QuantEcon/project-monorepo#22) decides what a link that leaves the
# site is written as, and this list goes when it does.
LEGACY_PREFIXES = ("dynam", "pyprog", "tools")

# What defines a label. Targets: a MyST target on its own line and a
# directive's ``:name:``. Equations: a directive's ``:label:`` and the label
# after a ``$$`` block.
TARGET_RES = (
    re.compile(r"^[ \t]*\(([^()\s]+)\)=[ \t]*\r?$", re.M),
    re.compile(r"^[ \t]*:name:[ \t]*(\S+)[ \t]*\r?$", re.M),
)
EQUATION_RES = (
    re.compile(r"^[ \t]*:label:[ \t]*(\S+)[ \t]*\r?$", re.M),
    re.compile(r"\$\$[ \t]*\(([^()\s]+)\)[ \t]*\r?$", re.M),
)

# A site's folder: the files the build reads, beside its pages and _static/.
SITE_FILES = ("_config.yml", "_toc.yml", "site.yml")
# site.yml: each field the build workflow reads, and what it may hold.
SITE_TYPES = ("series",)
# The runner classes the series run on today: GitHub's ubuntu-latest, and the
# RunsOn GPU class. A new class is added here when a site first needs it.
SITE_RUNNERS = ("ubuntu-latest", "g4dn.2xlarge")
SITE_OUTPUTS = ("html", "pdf", "notebooks")
SITE_FIELDS = ("type", "runner", "cell_timeout", "publishes", "url")
# Fields a site may leave out. extra_packages: pip requirements the build
# installs into the image's environment before it builds the site.
SITE_OPTIONAL_FIELDS = ("extra_packages",)
# One pip requirement: a name, optional [extras] and version specifiers, with
# no space, no environment marker or URL, and no leading `-`, so that no value
# can be read as one of pip's options. tools/site-matrix holds the same pattern.
REQUIREMENT_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._\-\[\],<>=!~*+]*")
# The repository a site is built from, and the pool's folder in it: the
# theme's "Last changed" line and changelog are `git log` of the page here, so
# its links (each commit, the full history, the GitHub button) must name this
# repository, and the full history the page's path in it.
POOL_REPOSITORY_URL = "https://github.com/QuantEcon/lectures"
POOL_PATH_TO_DOCS = POOL_DIR.name

FENCE_RE = re.compile(r"^[ \t]*(`{3,}|~{3,})(.*)$")
# Fenced blocks whose body is code or literal text, not MyST prose.
CODE_DIRECTIVES = ("{code-cell}", "{code-block}", "{code}", "{sourcecode}", "{literalinclude}")


def prose(text: str) -> str:
    """``text`` without what is not MyST prose: the bodies of code cells and
    literal fenced blocks, ``%`` comment lines and inline literals. A
    directive's fence (``{note}``, ``{figure}``, ``{math}``) is prose, and
    its option lines stay. Line structure is kept.

    Fences are read as CommonMark reads them: a block runs from its opening
    fence to the first later fence of the same character, at least as long,
    with nothing after it (or to the end), and nothing inside it opens or
    closes anything. A directive's body is then read the same way, as MyST
    parses it. A backtick fence's info string holds no backtick, so a line
    that opens with inline code is not a fence."""

    def is_closing(line, fence):
        m = FENCE_RE.match(line)
        return bool(m) and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence) and not m.group(2).strip()

    def read(lines):
        out, i = [], 0
        while i < len(lines):
            m = FENCE_RE.match(lines[i])
            if not m or (m.group(1)[0] == "`" and "`" in m.group(2)):
                out.append("" if lines[i].lstrip().startswith("%") else lines[i])
                i += 1
                continue
            end = next((j for j in range(i + 1, len(lines)) if is_closing(lines[j], m.group(1))), len(lines))
            body = lines[i + 1 : end]
            info = m.group(2).strip()
            code = not info.startswith("{") or info.startswith(CODE_DIRECTIVES)
            out.append("")
            out.extend([""] * len(body) if code else read(body))
            if end < len(lines):
                out.append("")
            i = end + 1
        return out

    # An inline literal: a run of two or more backticks, to the same run. A
    # run straight after a role's name (``{doc}``x````) is that role's text.
    return re.sub(r"(?<![`}])(``+)(?!`).*?(?<!`)\1(?!`)", "", "\n".join(read(text.split("\n"))))


class PoolCheckError(Exception):
    pass


def promote_module():
    """``tools/promote`` imported as a module, for its reference parser."""
    import importlib.util
    from importlib.machinery import SourceFileLoader

    loader = SourceFileLoader("qe_promote", str(PROMOTE_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(module)
    except SystemExit as exc:  # promote exits when it cannot start (PyYAML missing)
        raise PoolCheckError(f"tools/promote could not be loaded: it exited with status {exc.code}")
    return module


def check_layout(pool: Path, bib_name: str):
    """The pool's lectures, and every layout rule they break as ``(tag, message)``."""
    problems, lectures = [], []
    for p in sorted(pool.iterdir()):
        if p.is_file() and p.suffix == ".md":
            lectures.append(p.stem)
        elif not (p.is_dir() and p.name == "_static"):
            shown = f"lectures/{p.name}" + ("/" if p.is_dir() else "")
            problems.append(("top-level", f"{shown} is neither a lecture (<slug>.md) nor _static/: the pool is flat"))
    for slug in lectures:
        if slug.startswith("_"):
            problems.append((
                "underscore",
                f"lectures/{slug}.md: a lecture's name may not start with `_`, which is kept for names that are "
                "not lectures (_static/_shared/)",
            ))
    folded = defaultdict(list)
    for slug in lectures:
        folded[slug.casefold()].append(slug)
    for names in folded.values():
        if len(names) > 1:
            shown = " and ".join(f"lectures/{n}.md" for n in names)
            problems.append(("case", f"{shown} differ only in case, which a case-insensitive file system or address cannot tell apart"))
    static = pool / "_static"
    if static.is_dir():
        owned = set(lectures)
        for p in sorted(static.iterdir()):
            if p.is_dir() and (p.name == SHARED_DIR or p.name in owned):
                continue
            if p.is_file() and p.name == bib_name:
                continue
            if p.is_dir():
                message = (f"lectures/_static/{p.name}/ is no lecture's folder: there is no lectures/{p.name}.md, "
                           f"and only {SHARED_DIR}/ holds files lectures share")
            else:
                message = (f"lectures/_static/{p.name} is a loose file: a file in _static/ goes in its lecture's "
                           f"folder or in {SHARED_DIR}/ ({bib_name} aside)")
            problems.append(("static-entry", message))
    return lectures, problems


def check_references(pool: Path, lectures, promote):
    """Every reference rule a pool lecture breaks, as ``(tag, message)``."""
    problems = []
    for slug in lectures:
        where = f"lectures/{slug}.md"
        try:
            text = (pool / f"{slug}.md").read_bytes().decode("utf-8")
        except UnicodeDecodeError as exc:
            raise PoolCheckError(f"{where} is not UTF-8 text: {exc}")
        for kind, written in promote.extract_refs(text):
            if kind == "url":
                continue  # a published address, not a file in the pool
            literal = written.split("#", 1)[0]
            if not literal or promote.SCHEME_RE.match(literal):
                continue
            if kind == "link" and literal.endswith(".md"):
                continue  # a link to another lecture
            rel = posixpath.normpath(literal[1:] if literal.startswith("/") else literal)
            if kind in HEURISTIC_KINDS and not (pool / rel).is_file():
                continue
            if rel == ".." or rel.startswith("../"):
                problems.append(("escapes", f"{where} refers to {written}, outside lectures/"))
                continue
            if literal.startswith("/"):
                problems.append(("root-relative", f"{where} refers to {written}: write it file-relative, as {rel}"))
            parts = rel.split("/")
            if len(parts) > 2 and parts[0] == "_static" and parts[1] not in (SHARED_DIR, slug):
                problems.append((
                    "asset-owner",
                    f"{where} uses {rel}, which belongs to lectures/{parts[1]}.md: an asset two lectures use goes "
                    f"in _static/{SHARED_DIR}/",
                ))
    return problems


def read_lecture(pool: Path, slug: str) -> str:
    try:
        return (pool / f"{slug}.md").read_bytes().decode("utf-8")
    except UnicodeDecodeError as exc:
        raise PoolCheckError(f"lectures/{slug}.md is not UTF-8 text: {exc}")


def holders_by_lecture(ledger_path: Path):
    """``{slug: series that hold a copy}`` from the ledger, or None when
    there is no ledger to read."""
    if not ledger_path.is_file():
        return None
    import yaml

    try:
        ledger = yaml.safe_load(ledger_path.read_text(encoding="utf-8"))
    except yaml.YAMLError as exc:
        raise PoolCheckError(f"{ledger_path.name} could not be read: {exc}")
    held = {}
    for key, entry in (ledger or {}).items():
        if not (isinstance(entry, dict) and key.startswith("lectures/") and key.endswith(".md")):
            continue
        series = {entry.get("canonical")}
        for field in ("sources", "divergent", "superseded"):
            series |= {item.get("series") for item in entry.get(field) or [] if isinstance(item, dict)}
        held[key[len("lectures/"):-3]] = series
    return held


def check_doc_targets(pool: Path, lectures, site_pages, series_keys, held):
    """Every ``{doc}`` link that does not resolve, as ``(tag, message)``."""
    problems = []
    known = set(lectures) | set(site_pages)
    for slug in lectures:
        where = f"lectures/{slug}.md"
        seen = set()
        for m in DOC_RE.finditer(prose(read_lecture(pool, slug))):
            titled = DOC_TITLED_RE.match(m.group(2))
            target = (titled.group(1) if titled else m.group(2)).strip()
            if target in seen:
                continue
            seen.add(target)
            link = f"{where} links to {{doc}}`{target}`"
            prefix, sep, name = target.partition(":")
            if not sep:
                prefix, name = None, target
            elif not re.fullmatch(r"[\w.-]+", prefix):
                problems.append((
                    "doc-target",
                    f"{link}: a target has no spaces, and a colon in it follows a series key; write link text as "
                    "{doc}`text <target>`",
                ))
                continue
            if prefix is not None and prefix not in series_keys and prefix not in LEGACY_PREFIXES:
                problems.append((
                    "doc-target",
                    f"{link}: `{prefix}` is not a series key in sync/manifest.yml ({', '.join(series_keys)})",
                ))
            elif name not in known:
                hint = f" (a target is written without `.md`: {name[:-3]})" if name.endswith(".md") and name[:-3] in known else ""
                problems.append((
                    "doc-target",
                    f"{link}: there is no lectures/{name}.md, and `{name}` is not a site page{hint}",
                ))
            elif (
                prefix in series_keys
                and held is not None
                and name not in site_pages
                and prefix not in held.get(name, ())
            ):
                problems.append((
                    "doc-target",
                    f"{link}: by the ledger, {prefix} holds no lecture named {name} "
                    f"(held by: {', '.join(sorted(s for s in held.get(name, ()) if s)) or 'no series'})",
                ))
    return problems


def toc_entries(toc):
    """Every page a Jupyter Book ``_toc.yml`` lists (its root, then each
    ``file:``), and the entries it cannot resolve to a page (``glob:``)."""
    files, other = [], []

    def walk(node):
        if isinstance(node, dict):
            if isinstance(node.get("file"), str):
                files.append(node["file"])
            if "glob" in node:
                other.append(f"glob: {node['glob']}")
            for key in ("parts", "chapters", "sections"):
                walk(node.get(key))
        elif isinstance(node, list):
            for item in node:
                walk(item)

    if isinstance(toc, dict) and isinstance(toc.get("root"), str):
        files.append(toc["root"])
    walk(toc)
    return [f[:-3] if f.endswith(".md") else f for f in files], other


def read_yaml(path: Path, where: str, problems):
    """``path`` read as YAML, or None with a ``site-layout`` problem."""
    import yaml

    try:
        return yaml.safe_load(path.read_text(encoding="utf-8"))
    except (yaml.YAMLError, UnicodeDecodeError) as exc:
        problems.append(("site-layout", f"{where} could not be read as YAML: {exc}"))
        return None


def check_site_yml(where: str, data, problems):
    """Every ``site-yml`` rule ``site.yml`` breaks."""
    if not isinstance(data, dict):
        problems.append(("site-yml", f"{where} is not a mapping of the fields {', '.join(SITE_FIELDS)}"))
        return
    for field in SITE_FIELDS:
        if field not in data:
            problems.append(("site-yml", f"{where} has no `{field}`"))
    for field in data:
        if field not in SITE_FIELDS + SITE_OPTIONAL_FIELDS:
            problems.append((
                "site-yml",
                f"{where}: `{field}` is not a field the build reads ({', '.join(SITE_FIELDS)}; optional: "
                f"{', '.join(SITE_OPTIONAL_FIELDS)})",
            ))
    value = data.get("type")
    if "type" in data and value not in SITE_TYPES:
        problems.append(("site-yml", f"{where}: type {value!r} is not one of {', '.join(SITE_TYPES)}"))
    value = data.get("runner")
    if "runner" in data and value not in SITE_RUNNERS:
        problems.append(("site-yml", f"{where}: runner {value!r} is not one of {', '.join(SITE_RUNNERS)}"))
    value = data.get("cell_timeout")
    if "cell_timeout" in data and not (isinstance(value, int) and not isinstance(value, bool) and value > 0):
        problems.append(("site-yml", f"{where}: cell_timeout {value!r} is not a whole number of seconds above 0"))
    value = data.get("publishes")
    if "publishes" in data and not (
        isinstance(value, list)
        and "html" in value
        and all(v in SITE_OUTPUTS for v in value)
        and len(set(value)) == len(value)
    ):
        problems.append((
            "site-yml",
            f"{where}: publishes {value!r} is not a list of {', '.join(SITE_OUTPUTS)}, each at most once, with html",
        ))
    value = data.get("url")
    if "url" in data and not (isinstance(value, str) and value.startswith("https://") and value.endswith("/")):
        problems.append(("site-yml", f"{where}: url {value!r} is not an https:// address ending in /"))
    value = data.get("extra_packages")
    if "extra_packages" in data and not (
        isinstance(value, list)
        and value
        and all(isinstance(v, str) and REQUIREMENT_RE.fullmatch(v) for v in value)
        and len(set(value)) == len(value)
    ):
        problems.append((
            "site-yml",
            f"{where}: extra_packages {value!r} is not a list of pip requirements (a name, optional [extras] and "
            "version specifiers, no spaces, none starting with -), each at most once",
        ))


def check_site_config(key: str, config, site_yml, site_dir: Path, consumers, problems):
    """Every ``site-config`` rule ``_config.yml`` breaks, and ``site-yml``'s
    url against ``html.baseurl``."""
    where = f"sites/{key}/_config.yml"
    if not isinstance(config, dict):
        problems.append(("site-config", f"{where} is not a mapping"))
        return

    def section(parent, name, shown):
        """``parent[name]`` when it is a mapping; {} when it is absent; {}
        and a problem when it is something else."""
        value = parent.get(name)
        if value is None:
            return {}
        if not isinstance(value, dict):
            problems.append(("site-config", f"{where}: `{shown}` is not a mapping"))
            return {}
        return value

    sphinx = section(section(config, "sphinx", "sphinx"), "config", "sphinx.config")
    theme = section(sphinx, "html_theme_options", "sphinx.config.html_theme_options")
    mapping = section(sphinx, "intersphinx_mapping", "sphinx.config.intersphinx_mapping")
    execute = section(config, "execute", "execute")
    html = section(config, "html", "html")
    if config.get("only_build_toc_files") is not True:
        problems.append((
            "site-config",
            f"{where} does not set `only_build_toc_files: true`: without it Jupyter Book builds every lecture in "
            "the pool, not the site's contents",
        ))
    cache = f"_build/jupyter_cache/{key}"
    if execute.get("cache") != cache:
        problems.append((
            "site-config",
            f"{where}: `execute.cache` is {execute.get('cache')!r}, not {cache}: each site keeps its own execution "
            "cache",
        ))
    if theme.get("repository_url") != POOL_REPOSITORY_URL:
        problems.append((
            "site-config",
            f"{where}: `repository_url` is {theme.get('repository_url')!r}, not {POOL_REPOSITORY_URL}: the theme "
            "lists each page's changes from this repository's history, so its commit, history and GitHub links must "
            "name it (set it on a marked line after the series' own: the later key wins)",
        ))
    if theme.get("path_to_docs") != POOL_PATH_TO_DOCS:
        problems.append((
            "site-config",
            f"{where}: `path_to_docs` is {theme.get('path_to_docs')!r}, not {POOL_PATH_TO_DOCS}: a page's full "
            "history link is the page's path in the repository, under the pool's folder",
        ))
    branding = [("logo", config.get("logo")), ("html_favicon", sphinx.get("html_favicon"))]
    if isinstance(theme.get("dark_logo"), str) and theme["dark_logo"]:
        # The theme reads dark_logo inside html_static_path.
        branding.append(("dark_logo", f"_static/{theme['dark_logo']}"))
    for name, rel in branding:
        if isinstance(rel, str) and rel and not (site_dir / rel).is_file():
            problems.append(("site-config", f"{where} names {rel} as `{name}`, and sites/{key}/{rel} does not exist"))
    if sphinx.get("intersphinx_disabled_reftypes") != []:
        problems.append((
            "site-config",
            f"{where} does not set `intersphinx_disabled_reftypes: []`: a link with no target in the site must "
            "resolve on the lecture's home site",
        ))
    for name in sorted(set(mapping) & set(consumers)):
        problems.append((
            "site-config",
            f"{where} maps `{name}` in intersphinx_mapping: {name} only republishes other series' lectures, so a "
            "link must never resolve there",
        ))
    if key not in consumers:
        own = mapping.get(key)
        target = own[0] if isinstance(own, (list, tuple)) and own else own
        if own is None:
            problems.append((
                "site-config",
                f"{where} does not map `{key}` in intersphinx_mapping: a site maps itself, since a pool lecture "
                f"may link to its home series' site by prefix ({{doc}}`{key}:<name>`)",
            ))
        elif isinstance(site_yml, dict) and "url" in site_yml and target != site_yml["url"]:
            problems.append(("site-config", f"{where} maps `{key}` to {target!r}, not to its site.yml url {site_yml.get('url')!r}"))
    baseurl = html.get("baseurl")
    if isinstance(site_yml, dict) and "url" in site_yml and site_yml["url"] != baseurl:
        problems.append(("site-yml", f"sites/{key}/site.yml: url {site_yml['url']!r} is not html.baseurl in _config.yml ({baseurl!r})"))


def check_sites(sites: Path, pool: Path, lectures, series_keys, consumers):
    """The sites' folders, and every site rule they break as ``(tag, message)``."""
    problems, keys = [], []
    if not sites.is_dir():
        return keys, problems
    pool_names = set(lectures)
    for entry in sorted(sites.iterdir()):
        if entry.name.startswith("."):
            continue
        if entry.is_file() and entry.name == "README.md":
            continue
        if not entry.is_dir():
            problems.append(("site-layout", f"sites/{entry.name} is not a site's folder: sites/ holds sites/<key>/ and README.md"))
            continue
        key = entry.name
        keys.append(key)
        pages = []
        for p in sorted(entry.iterdir()):
            if p.name.startswith("."):
                continue
            if p.is_file() and (p.name in SITE_FILES or p.suffix == ".md"):
                if p.suffix == ".md":
                    pages.append(p.stem)
            elif not (p.is_dir() and p.name == "_static"):
                shown = f"sites/{key}/{p.name}" + ("/" if p.is_dir() else "")
                problems.append((
                    "site-layout",
                    f"{shown} is none of a site's files: {', '.join(SITE_FILES)}, its pages (<name>.md) and _static/",
                ))
        for name in SITE_FILES:
            if not (entry / name).is_file():
                problems.append(("site-layout", f"sites/{key}/ has no {name}"))
        for page in pages:
            if page in pool_names:
                problems.append((
                    "site-page",
                    f"sites/{key}/{page}.md has a pool lecture's name: staging it would overwrite lectures/{page}.md",
                ))
        static = entry / "_static"
        if static.is_dir():
            for f in sorted(q for q in static.rglob("*") if q.is_file() and not q.name.startswith(".")):
                rel = f.relative_to(entry).as_posix()
                if (pool / rel).exists():
                    problems.append((
                        "site-page",
                        f"sites/{key}/{rel} is also lectures/{rel}: staging would overwrite the pool's file",
                    ))
        toc = read_yaml(entry / "_toc.yml", f"sites/{key}/_toc.yml", problems) if (entry / "_toc.yml").is_file() else None
        if toc is not None:
            files, other = toc_entries(toc)
            if not files:
                problems.append(("site-toc", f"sites/{key}/_toc.yml lists no page"))
            for name in other:
                problems.append(("site-toc", f"sites/{key}/_toc.yml has `{name}`, which this check cannot resolve: list each file"))
            for name in dict.fromkeys(files):
                if name not in pool_names and name not in pages:
                    problems.append((
                        "site-toc",
                        f"sites/{key}/_toc.yml lists {name}, which is neither lectures/{name}.md nor sites/{key}/{name}.md",
                    ))
        site_yml = read_yaml(entry / "site.yml", f"sites/{key}/site.yml", problems) if (entry / "site.yml").is_file() else None
        if (entry / "site.yml").is_file():
            check_site_yml(f"sites/{key}/site.yml", site_yml, problems)
            if isinstance(site_yml, dict) and site_yml.get("type") == "series" and key not in series_keys:
                problems.append((
                    "site-yml",
                    f"sites/{key}/site.yml: a site of type series is named for its series, and `{key}` is not a "
                    f"series key in sync/manifest.yml ({', '.join(series_keys)})",
                ))
        if (entry / "_config.yml").is_file():
            config = read_yaml(entry / "_config.yml", f"sites/{key}/_config.yml", problems)
            if config is not None:
                check_site_config(key, config, site_yml, entry, consumers, problems)
    return keys, problems


def shared_labels(pool: Path, lectures):
    """``{label: [lectures]}`` for every label more than one lecture defines.
    Targets are compared without case and shown lower-cased; an equation
    label is shown as ``eq:<label>``-free text with `` (equation)`` after."""
    targets, equations = defaultdict(set), defaultdict(set)
    for slug in lectures:
        text = prose(read_lecture(pool, slug))
        for pattern in TARGET_RES:
            for m in pattern.finditer(text):
                targets[m.group(1).lower()].add(slug)
        for pattern in EQUATION_RES:
            for m in pattern.finditer(text):
                equations[m.group(1)].add(slug)
    shared = {label: sorted(slugs) for label, slugs in targets.items() if len(slugs) > 1}
    shared.update({f"{label} (equation)": sorted(slugs) for label, slugs in equations.items() if len(slugs) > 1})
    return dict(sorted(shared.items()))


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tools/pool-check", description=__doc__.split("\n\n")[0])
    parser.add_argument(
        "--labels",
        action="store_true",
        help="list the labels more than one pool lecture defines (information, never a failure).",
    )
    args = parser.parse_args(argv)
    try:
        if not POOL_DIR.is_dir():
            raise PoolCheckError(f"{POOL_DIR} does not exist")
        promote = promote_module()
        lectures, problems = check_layout(POOL_DIR, promote.BIB_BASENAME)
        problems += check_references(POOL_DIR, lectures, promote)
        try:
            series_keys, consumers = promote.load_manifest()
        except SystemExit as exc:  # promote's loader exits on a manifest it cannot read
            raise PoolCheckError(str(exc).removeprefix("error: "))
        held = holders_by_lecture(promote.LEDGER_PATH)
        problems += check_doc_targets(POOL_DIR, lectures, promote.SITE_PAGES, series_keys, held)
        sites, site_problems = check_sites(SITES_DIR, POOL_DIR, lectures, series_keys, consumers)
        problems += site_problems
        labels = shared_labels(POOL_DIR, lectures)
        static = POOL_DIR / "_static"
        n_files = sum(1 for p in static.rglob("*") if p.is_file()) if static.is_dir() else 0
    except PoolCheckError as exc:
        sys.stderr.write(f"error: {exc}\n")
        return 2
    except Exception as exc:  # anything unforeseen is an error, never a broken rule
        traceback.print_exc()
        sys.stderr.write(f"pool-check: internal error: {type(exc).__name__}: {exc}\n")
        return 2
    print(f"pool-check — {len(lectures)} lectures, {n_files} files under _static/, {len(sites)} site(s)")
    if labels:
        print(
            f"info: {len(labels)} label(s) are defined by more than one lecture"
            + (":" if args.labels else " (`tools/pool-check --labels` lists them); unique per site is checked where a site is built.")
        )
        if args.labels:
            for label, slugs in labels.items():
                print(f"  {label}: {', '.join(slugs)}")
    if not problems:
        print("clean: the pool and the sites keep their conventions.")
        return 0
    for tag, message in problems:
        print(f"  [{tag}] {message}")
    print(f"{len(problems)} problem(s).")
    return 1


if __name__ == "__main__":
    sys.exit(main())
